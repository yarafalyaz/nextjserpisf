{
  "name": "silengkap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "dev:clean": "rm -rf .next && next dev --turbopack -p 3001",
    "prebuild": "npx prisma generate",
    "build": "rm -rf .next && next build",
    "start": "node scripts/prepare-standalone.mjs && PORT=3001 node .next/standalone/server.js",
    "lint": "eslint",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:sync-holidays": "node --env-file=.env --import tsx scripts/sync-holidays.ts",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:check-migrations": "node scripts/verify-migrations.mjs",
    "preflight:deps": "node scripts/preflight-node-modules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pretypecheck": "npx prisma generate",
    "typecheck": "tsc --noEmit",
    "ci": "./scripts/ci-local.sh",
    "ci:quick": "./scripts/ci-local.sh --skip-e2e",
    "ci:e2e": "./scripts/ci-local.sh --e2e-only"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.59.0",
    "mariadb": "^3.5.2",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.31"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
