/// Immutable, versioned snapshot of a product's BOM (PRD FAB-02 / MOD-04).
/// `Product.materials` remains the editable working copy; releasing a revision
/// freezes its lines here so production orders pin the exact revision that was
/// in force when the order was released. A released revision's lines are never
/// mutated — a new revision is created instead. Status: draft → released →
/// superseded (the previous released revision is marked superseded on release).
model BomRevision {
  slug             String?               @unique
  id               Int                   @id @default(autoincrement())
  productId        Int                   @map("product_id")
  revisionNo       Int                   @map("revision_no")
  status           String                @default("draft")
  effectiveDate    DateTime              @map("effective_date")
  notes            String?               @db.Text
  releasedAt       DateTime?             @map("released_at")
  releasedBy       Int?                  @map("released_by")
  submittedAt      DateTime?             @map("submitted_at")
  submittedBy      Int?                  @map("submitted_by")
  approvedAt       DateTime?             @map("approved_at")
  approvedBy       Int?                  @map("approved_by")
  rejectedAt       DateTime?             @map("rejected_at")
  rejectedBy       Int?                  @map("rejected_by")
  rejectionReason  String?               @map("rejection_reason") @db.Text
  createdBy        Int?                  @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  materials        BomRevisionMaterial[]
  productionOrders ProductionOrder[]
  workOrders       WorkOrder[]
  fitmentRules     VehicleFitmentRule[]
  changeRequestsFrom BomRevisionChangeRequest[] @relation("ChangeFromRevision")
  changeRequestsTo   BomRevisionChangeRequest[] @relation("ChangeToRevision")

  @@unique([productId, revisionNo], map: "bom_revisions_product_revision_unique")
  @@index([productId], map: "bom_revisions_product_id_fkey")
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("bom_revisions")
}

model BomRevisionMaterial {
  id            Int         @id @default(autoincrement())
  bomRevisionId Int         @map("bom_revision_id")
  itemId        Int         @map("item_id")
  qty           Decimal     @db.Decimal(15, 2)
  // F-2026-10-21-008: allowance scrap normal per baris BOM (%), vonis BOT 4
  // F-2026-10-22-066-V P1. Null/0 = BELUM dikalibrasi → seluruh scrap baris
  // terbaca abnormal; dilarang default global. Dibekukan ke baris issue
  // (scrapPercentSnapshot) saat issue dibuat.
  scrapPercent  Decimal?    @map("scrap_percent") @db.Decimal(5, 2)
  bomRevision   BomRevision @relation(fields: [bomRevisionId], references: [id], onDelete: Cascade)

  @@index([bomRevisionId], map: "bom_revision_materials_bom_revision_id_fkey")
  @@index([itemId])
  @@map("bom_revision_materials")
}

model ProductionOrder {
  slug              String?                   @unique
  id                Int                       @id @default(autoincrement())
  documentNo        String                    @unique @map("document_no")
  productId         Int                       @map("product_id")
  bomRevisionId     Int?                      @map("bom_revision_id")
  workOrderId       Int?                      @map("work_order_id")
  qty               Decimal                   @db.Decimal(15, 2)
  status            String                    @default("draft")
  startDate         DateTime?                 @map("start_date")
  endDate           DateTime?                 @map("end_date")
  notes             String?                   @db.Text
  totalStandardCost Decimal                   @default(0.00) @map("total_standard_cost") @db.Decimal(15, 2)
  totalActualCost   Decimal                   @default(0.00) @map("total_actual_cost") @db.Decimal(15, 2)
  // Partial completion / WIP per equivalent (PRD FAB-09): units received to stock
  // so far. The order stays `in_progress` until this reaches `qty`; each release
  // carries its equivalent share of cost, the remainder stays as WIP.
  completedQty      Decimal                   @default(0.00) @map("completed_qty") @db.Decimal(15, 2)
  variance          Decimal                   @default(0.00) @db.Decimal(15, 2)
  releasedCost      Decimal                   @default(0.00) @map("released_cost") @db.Decimal(15, 2)
  // F-2026-10-21-009-V: tutup job (closed != completed). Kolom aditif;
  // jejak tutup->reopen->tutup utuh, tutup berikutnya tidak menimpa reopen.
  closedAt          DateTime?                 @map("closed_at")
  closedBy          Int?                      @map("closed_by")
  closedReason      String?                   @map("closed_reason") @db.Text
  reopenedAt        DateTime?                 @map("reopened_at")
  reopenedBy        Int?                      @map("reopened_by")
  reopenReason      String?                   @map("reopen_reason") @db.Text
  createdBy         Int?                      @map("created_by")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  materials         ProductionOrderMaterial[]
  costs             ProductionCost[]
  genealogy         ProductionGenealogy?
  product           Product                   @relation(fields: [productId], references: [id])
  bomRevision       BomRevision?              @relation(fields: [bomRevisionId], references: [id], onDelete: SetNull)
  workOrder         WorkOrder?                @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  bomChangeRequests BomRevisionChangeRequest[]

  @@index([productId], map: "production_orders_product_id_fkey")
  @@index([bomRevisionId])
  @@index([workOrderId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("production_orders")
}

model ProductionOrderMaterial {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  itemId            Int             @map("item_id")
  qty               Decimal         @db.Decimal(15, 2)
  actualQty         Decimal?        @map("actual_qty") @db.Decimal(15, 2)
  standardCost      Decimal         @default(0.00) @map("standard_cost") @db.Decimal(15, 2)
  actualCost        Decimal         @default(0.00) @map("actual_cost") @db.Decimal(15, 2)
  // F-2026-10-21-008: scrap terstruktur jalur PO (vonis BOT 4
  // F-2026-10-22-066-V). scrapPercentSnapshot dibekukan saat PO dibuat dari
  // revisi BOM ter-pin (createProductionOrder); scrapQty/scrapReasonCode/
  // scrapNote input operator per kejadian issueMaterial; kolom *Snapshot
  // klasifikasi KUMULATIF dibekukan/diakumulasi saat issue dari cost FIFO
  // kejadian itu (baris PO terbit berkali-kali — beda MaterialIssueItem
  // yang terklasifikasi sekali saat complete).
  scrapPercentSnapshot Decimal? @map("scrap_percent_snapshot") @db.Decimal(5, 2)
  scrapQty             Decimal  @default(0.00) @map("scrap_qty") @db.Decimal(15, 2)
  scrapReasonCode      String?  @map("scrap_reason_code") @db.VarChar(32)
  scrapNote            String?  @map("scrap_note") @db.VarChar(500)
  scrapClassifiedAt    DateTime? @map("scrap_classified_at")
  scrapNormalQtySnapshot  Decimal? @map("scrap_normal_qty_snapshot") @db.Decimal(15, 2)
  scrapAbnormalQtySnapshot Decimal? @map("scrap_abnormal_qty_snapshot") @db.Decimal(15, 2)
  scrapUnitCostSnapshot   Decimal? @map("scrap_unit_cost_snapshot") @db.Decimal(15, 2)
  scrapNormalValueSnapshot Decimal? @map("scrap_normal_value_snapshot") @db.Decimal(15, 2)
  scrapAbnormalValueSnapshot Decimal? @map("scrap_abnormal_value_snapshot") @db.Decimal(15, 2)
  // F-2026-10-24-098-S D-S98-04: tinjau operasional foreman (sejajar MI).
  scrapReviewStatus      String?   @map("scrap_review_status") @db.VarChar(32)
  scrapReviewDisposition String?   @map("scrap_review_disposition") @db.VarChar(32)
  scrapReviewNote        String?   @map("scrap_review_note") @db.VarChar(500)
  scrapReviewedBy        Int?      @map("scrap_reviewed_by")
  scrapReviewedAt        DateTime? @map("scrap_reviewed_at")
  // Lot/serial attribution of the material actually issued (PRD line 369 / REP-13).
  // Captured at issue time from the FIFO consumption so the production genealogy
  // can answer "which source serials/lots went into this finished unit".
  serialNumbers     Json?           @map("serial_numbers")
  batchNumbers      Json?           @map("batch_numbers")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId], map: "production_order_materials_production_order_id_fkey")
  @@index([itemId])
  @@map("production_order_materials")
}

/// Production genealogy (PRD line 369 / REP-13). When a production order
/// completes, one `ProductionGenealogy` row records the finished unit — its
/// output item, the finished serial/lot, the operator who completed it, and the
/// timespan — while `ProductionGenealogyMaterial` rows record the consumed
/// materials (item, qty, cost, and the serial/lot numbers consumed). This makes
/// "unit X was built from materials Y (serials Z) by operator O" traceable, so a
/// defect can be traced forward to affected finished goods and backward to the
/// source lots/serials.
model ProductionGenealogy {
  id                Int                           @id @default(autoincrement())
  productionOrderId Int                           @map("production_order_id")
  documentNo        String                        @map("document_no")
  outputItemId      Int                           @map("output_item_id")
  outputQty         Decimal                       @map("output_qty") @db.Decimal(15, 2)
  outputSerials     Json?                         @map("output_serials")
  outputBatch       String?                       @map("output_batch")
  unitCost          Decimal                       @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalCost         Decimal                       @default(0.00) @map("total_cost") @db.Decimal(15, 2)
  completedBy       Int?                          @map("completed_by")
  completedAt       DateTime                      @map("completed_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  materials         ProductionGenealogyMaterial[]
  productionOrder   ProductionOrder               @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId], map: "production_genealogy_production_order_id_unique")
  @@index([outputItemId], map: "production_genealogy_output_item_id_fkey")
  @@index([documentNo])
  @@index([completedAt])
  @@index([createdAt])
  @@map("production_genealogy")
}

model ProductionGenealogyMaterial {
  id            Int                 @id @default(autoincrement())
  genealogyId   Int                 @map("genealogy_id")
  itemId        Int                 @map("item_id")
  qty           Decimal             @db.Decimal(15, 2)
  unitCost      Decimal             @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalCost     Decimal             @default(0.00) @map("total_cost") @db.Decimal(15, 2)
  serialNumbers Json?               @map("serial_numbers")
  batchNumber   String?             @map("batch_number")
  genealogy     ProductionGenealogy @relation(fields: [genealogyId], references: [id], onDelete: Cascade)

  @@index([genealogyId], map: "production_genealogy_materials_genealogy_id_fkey")
  @@index([itemId])
  @@map("production_genealogy_materials")
}

/// Master checklist for quality control (PRD FAB-10). Versioned so a released
/// checklist is frozen; an inspection points at the exact version used. Types:
/// `incoming` (GRN receipt QC), `in_process` (during fabrication) and `final`
/// (pre-handover, FAB-13).
model QcChecklist {
  slug          String?           @unique
  id            Int               @id @default(autoincrement())
  code          String?           @unique
  name          String
  checklistType String            @map("checklist_type")
  productId     Int?              @map("product_id")
  version       Int               @default(1)
  status        String            @default("draft")
  isActive      Boolean           @default(true) @map("is_active")
  releasedAt    DateTime?         @map("released_at")
  releasedBy    Int?              @map("released_by")
  createdBy     Int?              @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         QcChecklistItem[]
  inspections   QcInspection[]
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId], map: "qc_checklists_product_id_fkey")
  @@index([checklistType])
  @@index([status])
  @@index([isActive])
  @@index([createdAt])
  @@map("qc_checklists")
}

model QcChecklistItem {
  id          Int                  @id @default(autoincrement())
  checklistId Int                  @map("checklist_id")
  sortOrder   Int                  @default(0) @map("sort_order")
  itemName    String               @map("item_name")
  method      String               @default("visual")
  spec        String?
  isRequired  Boolean              @default(true) @map("is_required")
  createdAt   DateTime             @default(now()) @map("created_at")
  checklist   QcChecklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results     QcInspectionResult[]

  @@index([checklistId], map: "qc_checklist_items_checklist_id_fkey")
  @@index([createdAt])
  @@map("qc_checklist_items")
}

/// One inspection event against a document (work order / production order /
/// goods receipt) using a checklist version. Status: draft → passed / failed.
model QcInspection {
  slug            String?              @unique
  id              Int                  @id @default(autoincrement())
  documentNo      String               @unique @map("document_no")
  checklistId     Int                  @map("checklist_id")
  inspectionType  String               @map("inspection_type")
  referenceType   String               @map("reference_type")
  referenceId     Int                  @map("reference_id")
  status          String               @default("draft")
  inspectorId     Int?                 @map("inspector_id")
  inspectedAt     DateTime?            @map("inspected_at")
  notes           String?              @db.Text
  createdBy       Int?                 @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  checklist       QcChecklist          @relation(fields: [checklistId], references: [id])
  results         QcInspectionResult[]
  nonconformances Nonconformance[]

  @@index([checklistId], map: "qc_inspections_checklist_id_fkey")
  @@index([referenceType, referenceId], map: "qc_inspections_reference_idx")
  @@index([status])
  @@index([inspectionType])
  @@index([createdBy])
  @@index([createdAt])
  @@map("qc_inspections")
}

model QcInspectionResult {
  id              Int             @id @default(autoincrement())
  inspectionId    Int             @map("inspection_id")
  checklistItemId Int             @map("checklist_item_id")
  result          String          @default("na")
  measuredValue   String?         @map("measured_value")
  notes           String?         @db.Text
  inspection      QcInspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem   QcChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@index([inspectionId], map: "qc_inspection_results_inspection_id_fkey")
  @@index([checklistItemId])
  @@map("qc_inspection_results")
}

/// Nonconformance / rework record (PRD FAB-11). A failing inspection raises one
/// or more NCRs; an open NCR blocks handover until closed by an authorized party.
model Nonconformance {
  slug              String?          @unique
  id                Int              @id @default(autoincrement())
  documentNo        String           @unique @map("document_no")
  inspectionId      Int?             @map("inspection_id")
  referenceType     String           @map("reference_type")
  referenceId       Int              @map("reference_id")
  defectDescription String           @map("defect_description") @db.Text
  cause             String?          @db.Text
  responsibility    String           @default("internal")
  severity          String           @default("minor")
  status            String           @default("open")
  reworkCost        Decimal          @default(0.00) @map("rework_cost") @db.Decimal(15, 2)
  reworkHours       Decimal          @default(0.00) @map("rework_hours") @db.Decimal(10, 2)
  resolution        String?          @db.Text
  closedBy          Int?             @map("closed_by")
  closedAt          DateTime?        @map("closed_at")
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  inspection        QcInspection?    @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  productionCosts   ProductionCost[]

  @@index([inspectionId], map: "nonconformances_inspection_id_fkey")
  @@index([referenceType, referenceId], map: "nonconformances_reference_idx")
  @@index([status])
  @@index([createdAt])
  @@map("nonconformances")
}

/// Non-material production cost line (PRD FAB-06/07/08/09). Captures direct
/// labor, machine usage, applied overhead, and subcontract/service cost so the
/// finished-goods HPP is material + labor + overhead + subcontract, not material
/// alone. A line is attached to a production order (and/or work order) and its
/// amount rolls into `ProductionOrder.totalActualCost`. `category`:
/// labor | machine | overhead | subcontract | service | rework | other.
/// A labor line may cite a `sourceTimesheetId` when it was pulled from an
/// existing timesheet, but the amount is always stored explicitly (snapshot).
/// A `rework` line is auto-posted from a nonconformance (`nonconformanceId`) and
/// mirrors that NCR's `reworkCost` (one line per NCR).
model ProductionCost {
  id                Int              @id @default(autoincrement())
  productionOrderId Int?             @map("production_order_id")
  workOrderId       Int?             @map("work_order_id")
  category          String           @default("labor")
  description       String?          @db.Text
  hours             Decimal?         @db.Decimal(10, 2)
  rate              Decimal?         @db.Decimal(15, 2)
  amount            Decimal          @default(0.00) @db.Decimal(15, 2)
  // Driver-based applied overhead (PRD FAB-07 / REP-16). A driver (machine hours,
  // labor hours, quantity, SKF) × a rate produces the applied overhead amount;
  // `isAppliedOverhead` distinguishes auto-applied overhead from a manual line so
  // the under/over-absorption report can isolate it.
  driverType        String?          @map("driver_type")
  isAppliedOverhead Boolean          @default(false) @map("is_applied_overhead")
  sourceTimesheetId Int?             @map("source_timesheet_id")
  nonconformanceId  Int?             @map("nonconformance_id")
  purchaseOrderId   Int?             @map("purchase_order_id")
  vendorId          Int?             @map("vendor_id")
  referenceNo       String?          @map("reference_no")
  postedAt          DateTime?        @map("posted_at")
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  nonconformance    Nonconformance?  @relation(fields: [nonconformanceId], references: [id], onDelete: SetNull)
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  vendor            Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([nonconformanceId], map: "production_costs_nonconformance_id_unique")
  @@index([productionOrderId], map: "production_costs_production_order_id_fkey")
  @@index([workOrderId], map: "production_costs_work_order_id_fkey")
  @@index([purchaseOrderId], map: "production_costs_purchase_order_id_fkey")
  @@index([category])
  @@index([vendorId])
  @@index([createdAt])
  @@map("production_costs")
}

model WorkOrder {
  slug              String?           @unique
  id                Int               @id @default(autoincrement())
  customerVehicleId Int?              @map("customer_vehicle_id")
  startDate         DateTime?         @map("start_date")
  endDate           DateTime?         @map("end_date")
  documentNo        String            @unique @map("document_no")
  quotationId       Int?              @map("quotation_id")
  projectId         Int?              @map("project_id")
  bomRevisionId     Int?              @map("bom_revision_id")
  customerId        Int               @map("customer_id")
  date              DateTime
  notes             String?           @db.Text
  status            String            @default("draft")
  // F-2026-10-21-009-V: tutup job (closed != completed). Kolom aditif;
  // jejak tutup->reopen->tutup utuh, tutup berikutnya tidak menimpa reopen.
  closedAt          DateTime?         @map("closed_at")
  closedBy          Int?              @map("closed_by")
  closedReason      String?           @map("closed_reason") @db.Text
  reopenedAt        DateTime?         @map("reopened_at")
  reopenedBy        Int?              @map("reopened_by")
  reopenReason      String?           @map("reopen_reason") @db.Text
  createdBy         Int?              @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  items             WorkOrderItem[]
  stockReservations StockReservation[]
  operations        WorkOrderOperation[]
  costs             ProductionCost[]
  timesheets        Timesheet[]
  purchaseOrders    PurchaseOrder[]
  productionOrders  ProductionOrder[]
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerVehicle   CustomerVehicle?  @relation(fields: [customerVehicleId], references: [id])
  quotation         Quotation?        @relation(fields: [quotationId], references: [id])
  project           Project?          @relation(fields: [projectId], references: [id])
  bomRevision       BomRevision?      @relation(fields: [bomRevisionId], references: [id], onDelete: SetNull)
  warrantyCoverages WarrantyCoverage[] @relation("WorkOrderWarrantyCoverages")
  warrantyRepairClaims WarrantyClaim[] @relation("WarrantyClaimRepairWorkOrder")
  changeOrders      JobChangeOrder[]
  materialRequests  MaterialRequest[]
  bomChangeRequests BomRevisionChangeRequest[]

  @@index([customerId], map: "work_orders_customer_id_fkey")
  @@index([quotationId], map: "work_orders_quotation_id_fkey")
  @@index([status], map: "idx_work_orders_status")
  @@index([customerVehicleId])
  @@index([projectId])
  @@index([bomRevisionId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("work_orders")
}

// AUD-NEXT-07: `itemId = 0` = baris JASA/CUSTOM (bukan item stok).
// Konvensi ini dipakai hook DP (itemId ?? 0) + form WO tambah
// (resolvedItemId = it.itemId || 0): downstream (HPP/costing) membaca cost +
// description untuk baris 0, bukan join ke items. Jangan anggap 0 = id item.
model WorkOrderItem {
  id          Int       @id @default(autoincrement())
  workOrderId Int       @map("work_order_id")
  itemId      Int       @map("item_id")
  // F-2026-10-22-063-S: snapshot PERINGATAN fitment, pola sama QuotationItem.
  // Baris jasa itemId=0 dilewati (BR-FIT-04) — kolom tetap null.
  fitmentResult      String?   @map("fitment_result")
  fitmentRuleId      Int?      @map("fitment_rule_id")
  fitmentEvaluatedAt DateTime? @map("fitment_evaluated_at")
  description String?
  qty         Decimal   @db.Decimal(15, 2)
  cost        Decimal   @default(0.00) @db.Decimal(15, 2)
  status      String    @default("pending")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  materialIssueItems MaterialIssueItem[]
  stockReservations StockReservation[]
  changeOrderItems JobChangeOrderItem[]

  @@index([workOrderId], map: "work_order_items_work_order_id_fkey")
  @@index([itemId])
  @@map("work_order_items")
}

// F-2026-10-21-012 inti (spec F-2026-10-22-045-S, vonis Lead F-045-S):
// ikatan qty stok per (WO, baris WO, gudang) — BUKAN pemesanan lapisan/
// batch/serial (BR-RES-12); biaya tetap FIFO lapisan existing. Status:
// active | consumed | released | expired. qtyReserved = qty awal baris;
// sisa aktif = qtyReserved - qtyConsumed selama status active. Satu baris
// aktif per (workOrderId, itemId, warehouseId) dijaga service di tx yang
// sama dengan klaim start (AC-RES-9) — unique parsial tak tersedia di
// MySQL, jadi idempotensi ditegakkan cek-di-tx + index komposit ini.
model StockReservation {
  id              Int           @id @default(autoincrement())
  workOrderId     Int           @map("work_order_id")
  workOrderItemId Int?          @map("work_order_item_id")
  itemId          Int           @map("item_id")
  warehouseId     Int           @map("warehouse_id")
  qtyReserved     Decimal       @map("qty_reserved") @db.Decimal(15, 2)
  qtyConsumed     Decimal       @default(0.00) @map("qty_consumed") @db.Decimal(15, 2)
  status          String        @default("active")
  shortageQty     Decimal       @default(0.00) @map("shortage_qty") @db.Decimal(15, 2)
  expiresAt       DateTime?     @map("expires_at")
  releasedAt      DateTime?     @map("released_at")
  releasedBy      Int?          @map("released_by")
  releaseReason   String?       @map("release_reason") @db.Text
  createdBy       Int?          @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItem   WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  item            Item          @relation(fields: [itemId], references: [id])
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])

  @@index([workOrderId, status])
  @@index([itemId, warehouseId, status])
  @@index([workOrderId, itemId, warehouseId, status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// F-2026-10-21-020 Tahap A: tahap progres perintah kerja (ringan, BUKAN
// routing costing — tanpa kolom biaya, tanpa jurnal, tanpa WorkCenter).
// Nama tahap = snapshot dari SystemSetting.defaultWorkOrderStages saat
// inisialisasi; edit setting sesudahnya tidak mengubah WO berjalan.
// Status enum aplikasi: pending | in_progress | completed | skipped.
// Urutan SEQUENSIAL-KERAS (vonis Lead Q1): tahap hanya boleh maju bila
// semua tahap ber-sortOrder lebih kecil sudah completed/skipped.
// skipped WAJIB notes (vonis Q2) dan keluar dari denominator progres.
// F-2026-10-22-090-S inti (Q-LP-1 BOT 1): master stasiun kerja untuk papan
// beban rencana. Nama unik hanya di antara stasiun AKTIF (Q-LP-5 fisik BOT 3):
// MySQL tanpa partial-unique, jadi `normalizedName` (trim+lowercase) dicek
// server di tx saat buat/ubah/aktifkan (pola PayrollComponent); nama sama
// dengan stasiun nonaktif boleh. Stasiun dirujuk tahap tidak bisa dihapus
// (WorkOrderOperation.workCenter Restrict) — hanya dinonaktifkan.
model WorkCenter {
  id                  Int                  @id @default(autoincrement())
  name                String
  normalizedName      String               @map("normalized_name")
  capacityHoursPerDay Decimal              @map("capacity_hours_per_day") @db.Decimal(15, 2)
  parallelStations    Int                  @default(1) @map("parallel_stations")
  isActive            Boolean              @default(true) @map("is_active")
  sortOrder           Int                  @default(0) @map("sort_order")
  createdBy           Int?                 @map("created_by")
  updatedBy           Int?                 @map("updated_by")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  operations          WorkOrderOperation[]

  @@index([normalizedName, isActive])
  @@index([isActive, sortOrder])
  @@index([createdAt])
  @@map("work_centers")
}

model WorkOrderOperation {
  id                 Int         @id @default(autoincrement())
  workOrderId        Int         @map("work_order_id")
  // F-2026-10-22-090-S: stasiun tahap, nullable — tahap tanpa stasiun masuk
  // ember "Belum ada stasiun", tidak ditebak dari nama teks tahap (BR-LP-03).
  workCenterId       Int?        @map("work_center_id")
  name               String
  sortOrder          Int       @default(0) @map("sort_order")
