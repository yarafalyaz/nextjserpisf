  @@index([productId], map: "product_materials_product_id_fkey")
  @@index([itemId])
  @@map("product_materials")
}

/// Immutable, versioned snapshot of a product's BOM (PRD FAB-02 / MOD-04).
/// `Product.materials` remains the editable working copy; releasing a revision
/// freezes its lines here so production orders pin the exact revision that was
/// in force when the order was released. A released revision's lines are never
/// mutated — a new revision is created instead. Status: draft → released →
/// superseded (the previous released revision is marked superseded on release).
model BomRevision {
  slug             String?               @unique
  id               Int                   @id @default(autoincrement())
  productId        Int                   @map("product_id")
  revisionNo       Int                   @map("revision_no")
  status           String                @default("draft")
  effectiveDate    DateTime              @map("effective_date")
  notes            String?               @db.Text
  releasedAt       DateTime?             @map("released_at")
  releasedBy       Int?                  @map("released_by")
  createdBy        Int?                  @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  materials        BomRevisionMaterial[]
  productionOrders ProductionOrder[]
  workOrders       WorkOrder[]
  fitmentRules     VehicleFitmentRule[]

  @@unique([productId, revisionNo], map: "bom_revisions_product_revision_unique")
  @@index([productId], map: "bom_revisions_product_id_fkey")
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("bom_revisions")
}

model BomRevisionMaterial {
  id            Int         @id @default(autoincrement())
  bomRevisionId Int         @map("bom_revision_id")
  itemId        Int         @map("item_id")
  qty           Decimal     @db.Decimal(15, 2)
  bomRevision   BomRevision @relation(fields: [bomRevisionId], references: [id], onDelete: Cascade)

  @@index([bomRevisionId], map: "bom_revision_materials_bom_revision_id_fkey")
  @@index([itemId])
  @@map("bom_revision_materials")
}

model ProductionOrder {
  slug              String?                   @unique
  id                Int                       @id @default(autoincrement())
  documentNo        String                    @unique @map("document_no")
  productId         Int                       @map("product_id")
  bomRevisionId     Int?                      @map("bom_revision_id")
  workOrderId       Int?                      @map("work_order_id")
  qty               Decimal                   @db.Decimal(15, 2)
  status            String                    @default("draft")
  startDate         DateTime?                 @map("start_date")
  endDate           DateTime?                 @map("end_date")
  notes             String?                   @db.Text
  totalStandardCost Decimal                   @default(0.00) @map("total_standard_cost") @db.Decimal(15, 2)
  totalActualCost   Decimal                   @default(0.00) @map("total_actual_cost") @db.Decimal(15, 2)
  // Partial completion / WIP per equivalent (PRD FAB-09): units received to stock
  // so far. The order stays `in_progress` until this reaches `qty`; each release
  // carries its equivalent share of cost, the remainder stays as WIP.
  completedQty      Decimal                   @default(0.00) @map("completed_qty") @db.Decimal(15, 2)
  variance          Decimal                   @default(0.00) @db.Decimal(15, 2)
  releasedCost      Decimal                   @default(0.00) @map("released_cost") @db.Decimal(15, 2)
  createdBy         Int?                      @map("created_by")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  materials         ProductionOrderMaterial[]
  costs             ProductionCost[]
  genealogy         ProductionGenealogy?
  product           Product                   @relation(fields: [productId], references: [id])
  bomRevision       BomRevision?              @relation(fields: [bomRevisionId], references: [id], onDelete: SetNull)
  workOrder         WorkOrder?                @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([productId], map: "production_orders_product_id_fkey")
  @@index([bomRevisionId])
  @@index([workOrderId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("production_orders")
}

model ProductionOrderMaterial {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  itemId            Int             @map("item_id")
  qty               Decimal         @db.Decimal(15, 2)
  actualQty         Decimal?        @map("actual_qty") @db.Decimal(15, 2)
  standardCost      Decimal         @default(0.00) @map("standard_cost") @db.Decimal(15, 2)
  actualCost        Decimal         @default(0.00) @map("actual_cost") @db.Decimal(15, 2)
  // Lot/serial attribution of the material actually issued (PRD line 369 / REP-13).
  // Captured at issue time from the FIFO consumption so the production genealogy
  // can answer "which source serials/lots went into this finished unit".
  serialNumbers     Json?           @map("serial_numbers")
  batchNumbers      Json?           @map("batch_numbers")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId], map: "production_order_materials_production_order_id_fkey")
  @@index([itemId])
  @@map("production_order_materials")
}

/// Production genealogy (PRD line 369 / REP-13). When a production order
/// completes, one `ProductionGenealogy` row records the finished unit — its
/// output item, the finished serial/lot, the operator who completed it, and the
/// timespan — while `ProductionGenealogyMaterial` rows record the consumed
/// materials (item, qty, cost, and the serial/lot numbers consumed). This makes
/// "unit X was built from materials Y (serials Z) by operator O" traceable, so a
/// defect can be traced forward to affected finished goods and backward to the
/// source lots/serials.
model ProductionGenealogy {
  id                Int                           @id @default(autoincrement())
  productionOrderId Int                           @map("production_order_id")
  documentNo        String                        @map("document_no")
  outputItemId      Int                           @map("output_item_id")
  outputQty         Decimal                       @map("output_qty") @db.Decimal(15, 2)
  outputSerials     Json?                         @map("output_serials")
  outputBatch       String?                       @map("output_batch")
  unitCost          Decimal                       @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalCost         Decimal                       @default(0.00) @map("total_cost") @db.Decimal(15, 2)
  completedBy       Int?                          @map("completed_by")
  completedAt       DateTime                      @map("completed_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  materials         ProductionGenealogyMaterial[]
  productionOrder   ProductionOrder               @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId], map: "production_genealogy_production_order_id_unique")
  @@index([outputItemId], map: "production_genealogy_output_item_id_fkey")
  @@index([documentNo])
  @@index([completedAt])
  @@index([createdAt])
  @@map("production_genealogy")
}

model ProductionGenealogyMaterial {
  id            Int                 @id @default(autoincrement())
  genealogyId   Int                 @map("genealogy_id")
  itemId        Int                 @map("item_id")
  qty           Decimal             @db.Decimal(15, 2)
  unitCost      Decimal             @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  totalCost     Decimal             @default(0.00) @map("total_cost") @db.Decimal(15, 2)
  serialNumbers Json?               @map("serial_numbers")
  batchNumber   String?             @map("batch_number")
  genealogy     ProductionGenealogy @relation(fields: [genealogyId], references: [id], onDelete: Cascade)

  @@index([genealogyId], map: "production_genealogy_materials_genealogy_id_fkey")
  @@index([itemId])
  @@map("production_genealogy_materials")
}

/// Master checklist for quality control (PRD FAB-10). Versioned so a released
/// checklist is frozen; an inspection points at the exact version used. Types:
/// `incoming` (GRN receipt QC), `in_process` (during fabrication) and `final`
/// (pre-handover, FAB-13).
model QcChecklist {
  slug          String?           @unique
  id            Int               @id @default(autoincrement())
  code          String?           @unique
  name          String
  checklistType String            @map("checklist_type")
  productId     Int?              @map("product_id")
  version       Int               @default(1)
  status        String            @default("draft")
  isActive      Boolean           @default(true) @map("is_active")
  releasedAt    DateTime?         @map("released_at")
  releasedBy    Int?              @map("released_by")
  createdBy     Int?              @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         QcChecklistItem[]
  inspections   QcInspection[]
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId], map: "qc_checklists_product_id_fkey")
  @@index([checklistType])
  @@index([status])
  @@index([isActive])
  @@index([createdAt])
  @@map("qc_checklists")
}

model QcChecklistItem {
  id          Int                  @id @default(autoincrement())
  checklistId Int                  @map("checklist_id")
  sortOrder   Int                  @default(0) @map("sort_order")
  itemName    String               @map("item_name")
  method      String               @default("visual")
  spec        String?
  isRequired  Boolean              @default(true) @map("is_required")
  createdAt   DateTime             @default(now()) @map("created_at")
  checklist   QcChecklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results     QcInspectionResult[]

  @@index([checklistId], map: "qc_checklist_items_checklist_id_fkey")
  @@index([createdAt])
  @@map("qc_checklist_items")
}

/// One inspection event against a document (work order / production order /
/// goods receipt) using a checklist version. Status: draft → passed / failed.
model QcInspection {
  slug            String?              @unique
  id              Int                  @id @default(autoincrement())
  documentNo      String               @unique @map("document_no")
  checklistId     Int                  @map("checklist_id")
  inspectionType  String               @map("inspection_type")
  referenceType   String               @map("reference_type")
  referenceId     Int                  @map("reference_id")
  status          String               @default("draft")
  inspectorId     Int?                 @map("inspector_id")
  inspectedAt     DateTime?            @map("inspected_at")
  notes           String?              @db.Text
  createdBy       Int?                 @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  checklist       QcChecklist          @relation(fields: [checklistId], references: [id])
  results         QcInspectionResult[]
  nonconformances Nonconformance[]

  @@index([checklistId], map: "qc_inspections_checklist_id_fkey")
  @@index([referenceType, referenceId], map: "qc_inspections_reference_idx")
  @@index([status])
  @@index([inspectionType])
  @@index([createdBy])
  @@index([createdAt])
  @@map("qc_inspections")
}

model QcInspectionResult {
  id              Int             @id @default(autoincrement())
  inspectionId    Int             @map("inspection_id")
  checklistItemId Int             @map("checklist_item_id")
  result          String          @default("na")
  measuredValue   String?         @map("measured_value")
  notes           String?         @db.Text
  inspection      QcInspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem   QcChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@index([inspectionId], map: "qc_inspection_results_inspection_id_fkey")
  @@index([checklistItemId])
  @@map("qc_inspection_results")
}

/// Nonconformance / rework record (PRD FAB-11). A failing inspection raises one
/// or more NCRs; an open NCR blocks handover until closed by an authorized party.
model Nonconformance {
  slug              String?          @unique
  id                Int              @id @default(autoincrement())
  documentNo        String           @unique @map("document_no")
  inspectionId      Int?             @map("inspection_id")
  referenceType     String           @map("reference_type")
  referenceId       Int              @map("reference_id")
  defectDescription String           @map("defect_description") @db.Text
  cause             String?          @db.Text
  responsibility    String           @default("internal")
  severity          String           @default("minor")
  status            String           @default("open")
  reworkCost        Decimal          @default(0.00) @map("rework_cost") @db.Decimal(15, 2)
  reworkHours       Decimal          @default(0.00) @map("rework_hours") @db.Decimal(10, 2)
  resolution        String?          @db.Text
  closedBy          Int?             @map("closed_by")
  closedAt          DateTime?        @map("closed_at")
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  inspection        QcInspection?    @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  productionCosts   ProductionCost[]

  @@index([inspectionId], map: "nonconformances_inspection_id_fkey")
  @@index([referenceType, referenceId], map: "nonconformances_reference_idx")
  @@index([status])
  @@index([createdAt])
  @@map("nonconformances")
}

/// Non-material production cost line (PRD FAB-06/07/08/09). Captures direct
/// labor, machine usage, applied overhead, and subcontract/service cost so the
/// finished-goods HPP is material + labor + overhead + subcontract, not material
/// alone. A line is attached to a production order (and/or work order) and its
/// amount rolls into `ProductionOrder.totalActualCost`. `category`:
/// labor | machine | overhead | subcontract | service | rework | other.
/// A labor line may cite a `sourceTimesheetId` when it was pulled from an
/// existing timesheet, but the amount is always stored explicitly (snapshot).
/// A `rework` line is auto-posted from a nonconformance (`nonconformanceId`) and
/// mirrors that NCR's `reworkCost` (one line per NCR).
model ProductionCost {
  id                Int              @id @default(autoincrement())
  productionOrderId Int?             @map("production_order_id")
  workOrderId       Int?             @map("work_order_id")
  category          String           @default("labor")
  description       String?          @db.Text
  hours             Decimal?         @db.Decimal(10, 2)
  rate              Decimal?         @db.Decimal(15, 2)
  amount            Decimal          @default(0.00) @db.Decimal(15, 2)
  // Driver-based applied overhead (PRD FAB-07 / REP-16). A driver (machine hours,
  // labor hours, quantity, SKF) × a rate produces the applied overhead amount;
  // `isAppliedOverhead` distinguishes auto-applied overhead from a manual line so
  // the under/over-absorption report can isolate it.
  driverType        String?          @map("driver_type")
  isAppliedOverhead Boolean          @default(false) @map("is_applied_overhead")
  sourceTimesheetId Int?             @map("source_timesheet_id")
  nonconformanceId  Int?             @map("nonconformance_id")
  purchaseOrderId   Int?             @map("purchase_order_id")
  vendorId          Int?             @map("vendor_id")
  referenceNo       String?          @map("reference_no")
  postedAt          DateTime?        @map("posted_at")
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  nonconformance    Nonconformance?  @relation(fields: [nonconformanceId], references: [id], onDelete: SetNull)
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  vendor            Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([nonconformanceId], map: "production_costs_nonconformance_id_unique")
  @@index([productionOrderId], map: "production_costs_production_order_id_fkey")
  @@index([workOrderId], map: "production_costs_work_order_id_fkey")
  @@index([purchaseOrderId], map: "production_costs_purchase_order_id_fkey")
  @@index([category])
  @@index([vendorId])
  @@index([createdAt])
  @@map("production_costs")
}

model WorkOrder {
  slug              String?           @unique
  id                Int               @id @default(autoincrement())
  customerVehicleId Int?              @map("customer_vehicle_id")
  startDate         DateTime?         @map("start_date")
