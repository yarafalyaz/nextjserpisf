model AssetCategory {
  slug                             String?  @unique
  id                               Int      @id @default(autoincrement())
  name                             String
  code                             String?
  depreciationRate                 Decimal? @map("depreciation_rate") @db.Decimal(5, 2)
  usefulLife                       Int?     @map("useful_life")
  /// Penyusutan fiskal (pajak) — dipakai laporan "Perbedaan Penyusutan".
  /// Terpisah dari tarif/umur akuntansi supaya keduanya bisa dibandingkan.
  taxDepreciationRate              Decimal? @map("tax_depreciation_rate") @db.Decimal(5, 2)
  taxUsefulLife                    Int?     @map("tax_useful_life")
  /// Kelompok fiskal PMK 72/2023 (vonis F-2026-10-22-062-V Putusan 2):
  /// GROUP_1..GROUP_4 / BUILDING_PERMANENT / BUILDING_NON_PERMANENT.
  /// Tarif statutoris hidup di tabel validasi `asset-fiscal-groups.ts`.
  taxGroupCode                     String?  @map("tax_group_code") @db.VarChar(30)
  /// Jenis harta tercantum di lampiran PMK 72/2023? null = belum dinyatakan.
  taxTypeListed                    Boolean? @map("tax_type_listed")
  /// Ada penetapan DJP (mengalahkan default kelompok 3 jenis tak tercantum).
  taxDjpDetermination              Boolean  @default(false) @map("tax_djp_determination")
  /// Metode fiskal terpilih (vonis BOT 4 F-2026-10-23-109-V P1):
  /// `straight_line`|`declining_balance`; NULL = belum dipilih -> fiskal
  /// belum-dihitung, DILARANG fallback garis lurus. Terpisah dari
  /// `Asset.depreciationMethod` komersial. Bangunan + saldo menurun
  /// ditolak saat simpan dan di read-model.
  fiscalMethod                     String?  @map("fiscal_method") @db.VarChar(30)
  assetAccountId                   Int?     @map("asset_account_id")
  accumulatedDepreciationAccountId Int?     @map("accumulated_depreciation_account_id")
  depreciationExpenseAccountId     Int?     @map("depreciation_expense_account_id")
  gainLossAccountId                Int?     @map("gain_loss_account_id")
  /// Mapping peristiwa penyesuaian nilai (vonis BOT 4 F-2026-10-23-128-V
  /// Putusan 2, gerbang inti F-2026-10-23-111-V). Nullable TANPA default dan
  /// TANPA backfill tebakan: NULL memicu fail-closed per peristiwa (P3) —
  /// surplus wajib EQTY, beban penurunan nilai wajib EXPS, akumulasi
  /// penurunan nilai wajib DEPR kontra. Bukan SystemSetting global.
  revaluationSurplusAccountId      Int?     @map("revaluation_surplus_account_id")
  impairmentLossAccountId          Int?     @map("impairment_loss_account_id")
  accumulatedImpairmentAccountId   Int?     @map("accumulated_impairment_account_id")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")
  assets                           Asset[]

  @@index([assetAccountId])
  @@index([accumulatedDepreciationAccountId])
  @@index([depreciationExpenseAccountId])
  @@index([gainLossAccountId])
  @@index([revaluationSurplusAccountId])
  @@index([impairmentLossAccountId])
  @@index([accumulatedImpairmentAccountId])
  @@index([createdAt])
  @@map("asset_categories")
}

