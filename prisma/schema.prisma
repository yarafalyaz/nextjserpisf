/// F-2026-10-22-070-S (induk F-2026-10-21-013): override stok minimum per
/// (barang, gudang). Baris ada = minimum efektif pasangan itu; baris tidak
/// ada = warisi Item.minStock global (BR-MS-02). Pengaturan murni master:
/// tidak pernah menulis StockMove/jurnal/reservasi (BR-MS-09).
model ItemWarehouseSetting {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  warehouseId Int      @map("warehouse_id")
  // NULL = belum diatur staf = warisi Item.minStock global (BR-ROP-01);
  // nilai (termasuk 0) = override eksplisit per gudang. Baris boleh lahir
  // dari lead time saja tanpa membekukan minimum global (perbaiki PR #936).
  minStock    Decimal? @map("min_stock") @db.Decimal(15, 2)
  // F-2026-10-25-048-S (Q-ROP-2 putusan Lead): lead time pemasok per
  // (barang, gudang) dalam hari kalender. NULL = belum diisi = pasangan
  // tidak dinilai untuk titik pesan-ulang (BR-ROP-03), bukan 0.
  leadTimeDays Int?    @map("lead_time_days")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
