  sent
  posted
  partial
  paid
  cancelled
}

enum StockMoveImpact {
  IN
  OUT
}

enum StockMoveStatus {
  draft
  posted
  reversed
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}
