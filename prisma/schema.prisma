/// F-2026-10-25-036-S (BR-KT36-01): histori tarif komisi per kategori pelanggan,
/// bertanggal efektif. Masa semi-terbuka: effectiveFrom <= tanggal < effectiveTo;
/// effectiveTo null = masa terbuka. Baris yang sudah menjadi sumber snapshot
/// faktur (SalesInvoice.commissionRateId) dilarang edit/hapus (BR-KT36-08).
model CustomerCommissionRate {
  id                 Int              @id @default(autoincrement())
  customerCategoryId Int              @map("customer_category_id")
  commissionPercent  Decimal          @map("commission_percent") @db.Decimal(5, 2)
  effectiveFrom      DateTime         @map("effective_from") @db.Date
  effectiveTo        DateTime?        @map("effective_to") @db.Date
  createdBy          Int?             @map("created_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  customerCategory   CustomerCategory @relation(fields: [customerCategoryId], references: [id])
  snapshotInvoices   SalesInvoice[]   @relation("SalesInvoiceCommissionRate")

  @@index([customerCategoryId, effectiveFrom], map: "idx_commission_rate_category_from")
  @@map("customer_commission_rates")
}

