  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  // Jasa maklon per proyek (coating/bending): tagihan vendor ikut HPP proyek.
  projectId           Int?                      @map("project_id")
