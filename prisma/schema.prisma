model VendorPayment {
  slug              String?                   @unique
  id                Int                       @id @default(autoincrement())
  referenceNumber   String?                   @map("reference_number")
  bankId            Int?                      @map("bank_id")
  bankAccount       String?                   @map("bank_account")
  status            String                    @default("draft")
  confirmedBy       Int?                      @map("confirmed_by")
  confirmedAt       DateTime?                 @map("confirmed_at")
  deletedAt         DateTime?                 @map("deleted_at")
  documentNo        String                    @unique @map("document_no")
  vendorId          Int                       @map("vendor_id")
  amount            Decimal                   @db.Decimal(15, 2)
  paymentDate       DateTime                  @map("payment_date")
  paymentMethod     String                    @map("payment_method")
  accountId         Int?                      @map("account_id")
  // Bank / transfer admin fee paid to move the money (e.g. "Admin BCA 1.000").
  // A real cost of paying, NOT part of the bill settlement — it is expensed to
  // the purchase admin-fee account and never allocated to a bill.
  adminFee          Decimal                   @default(0.00) @map("admin_fee") @db.Decimal(15, 2)
  // Tagihan yang ditargetkan pembayaran ini (dipilih lewat tombol "Bayar" di
  // tagihan). Saat konfirmasi, alokasi diutamakan ke tagihan ini (boleh sebagian),
  // lalu sisanya oldest-first ke tagihan terbuka lain. Null = perilaku lama
  // (murni oldest-first).
  vendorBillId      Int?                      @map("vendor_bill_id")
  notes             String?                   @db.Text
  // Penanda eksekusi "Transfer Pemasok": kapan transfer bank ke pemasok benar-benar
  // dikirim, dan referensi bukti transfernya. Sifatnya operasional — jurnal kas/bank
  // sudah dibuat oleh pembayaran ini, jadi menandai transfer TIDAK membuat jurnal baru.
  transferredAt     DateTime?                 @map("transferred_at")
  transferReference String?                   @map("transfer_reference")
  createdBy         Int?                      @map("created_by")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  allocations       VendorPaymentAllocation[]
  vendor            Vendor                    @relation(fields: [vendorId], references: [id])
  vendorBill        VendorBill?               @relation(fields: [vendorBillId], references: [id])

  @@index([vendorId], map: "vendor_payments_vendor_id_fkey")
  @@index([status])
  @@index([bankId])
  @@index([confirmedBy])
  @@index([accountId])
  @@index([createdBy])
  @@index([paymentDate])
  @@index([transferredAt])
  @@index([deletedAt])
  @@index([vendorBillId])
  @@map("vendor_payments")
}

model VendorPaymentAllocation {
