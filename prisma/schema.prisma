generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id             Int                   @id @default(autoincrement())
  name           String
  email          String                @unique
  slug           String?               @unique
  password       String
  avatar         String?               @db.Text
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  journals       Journal[]
  notifications  Notification[]
  roles          Role[]                @relation("UserRoles")
  employee       Employee[]
  userWarehouses UserWarehouse[]
  favorites      FavoriteTransaction[]

  @@index([createdAt])
  @@map("users")
}

model Role {
  slug        String?      @unique
  id          Int          @id @default(autoincrement())
  name        String       @unique
  guardName   String       @default("web") @map("guard_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  permissions Permission[] @relation("RolePermissions")
  users       User[]       @relation("UserRoles")

  @@index([createdAt])
  @@map("roles")
}

/// A logical feature area (Inventory, Sales, etc.) used for nav + the admin
/// permission matrix. Each Module groups a set of ModuleActions.
///
/// The catalog is a VIEW of the `permissions` table: `Role.permissions` stays the
/// single enforced store (read by `auth.ts` → `session.user.permissions`), and this
/// catalog only groups/labels it for the UI. `permissionKey` is the identity.
model Module {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g. "inventory", "sales", "master.brands"
  name      String // "Inventaris", "Penjualan"
  parentKey String?  @map("parent_key") // hierarchy (e.g. "master" → "master.brands")
  route     String? // "/inventaris" (for top-level nav)
  icon      String? // "Package" (lucide icon name)
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  actions ModuleAction[]

  @@index([parentKey])
  @@index([order])
  @@map("modules")
}

/// One permission of a Module. `key` is the ACTION verb (matrix column) and may
/// repeat inside a module (e.g. several `view` rows for different resources), so
/// the unique key is `permissionKey` — the old `@@unique([moduleId, key])` collapsed
/// `master`'s 19 view permissions into a single surviving row.
model ModuleAction {
  id            Int    @id @default(autoincrement())
  moduleId      Int    @map("module_id")
  key           String // verb: "view" | "create" | "edit" | "delete" | "approve" | ...
  resource      String // entitas/baris matriks: "customers", "sales_invoices", ...
  permissionKey String @map("permission_key") // e.g. "view_customers" = key + "_" + resource
  label         String // resource label, e.g. "Pelanggan"
  order         Int    @default(0)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, permissionKey])
  @@index([moduleId])
  @@map("module_actions")
}

/// Permission catalog row. `name` is the string every `requirePermission()` call
/// uses; roles reference these rows through `Role.permissions` (pivot
/// `_RolePermissions`), which is what the session and enforcement read.
model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("web") @map("guard_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  roles     Role[]   @relation("RolePermissions")

  @@index([createdAt])
  @@map("permissions")
}

model SystemSetting {
  id                           Int       @id @default(autoincrement())
  companyName                  String?   @map("company_name")
  companyEmail                 String?   @map("company_email")
  companyPhone                 String?   @map("company_phone")
  companyAddress               String?   @map("company_address") @db.Text
  companyProvince              String?   @map("company_province")
  companyCity                  String?   @map("company_city")
  companyDistrict              String?   @map("company_district")
  companyVillage               String?   @map("company_village")
  companyPostalCode            String?   @map("company_postal_code")
  companyLogo                  String?   @map("company_logo")
  companyLogoDark              String?   @map("company_logo_dark")
  companyWebsite               String?   @map("company_website")
  companyTaxId                 String?   @map("company_tax_id")
  // NITKU penjual 22 digit untuk ekspor Coretax (elemen SellerIDTKU).
  // Terpisah dari NPWP: satu NPWP bisa punya banyak NITKU cabang; builder
  // ekspor menolak fail-closed bila kosong/format salah — jangan diturunkan
  // dari NPWP secara diam-diam.
  companyNitku                 String?   @map("company_nitku")
  // F-2026-10-25-015-V: status PKP perusahaan penjual (nilai kini +
  // tanggal mulai kewajiban, BUKAN tanggal SPPKP — PMK 164/2023).
  // Default "unknown": install existing TIDAK ditebak non-PKP/PKP.
  // Pisah tegas dari pkpStatus lawan transaksi (F-2026-10-25-005-V).
  companyPkpStatus             String    @default("unknown") @map("company_pkp_status") @db.VarChar(16)
  companyPkpEffectiveFrom      DateTime? @map("company_pkp_effective_from")
  companyPkpSource             String?   @map("company_pkp_source")
  companyLatitude              Decimal?  @map("company_latitude") @db.Decimal(10, 8)
  companyLongitude             Decimal?  @map("company_longitude") @db.Decimal(11, 8)
  // F-2026-10-25-035-B (Q-CL2-5): saklar gerbang kredit tahap 2. Default
  // false = perilaku persis sebelum gerbang (nol tertahan, nol rekod
  // override). Hanya manage_settings lewat updateSystemSettings yang
  // mengubah; dibaca server tiap penilaian, fail-safe false bila absen.
  creditGateEnabled            Boolean   @default(false) @map("credit_gate_enabled")
  costingMethod                String    @default("FIFO") @map("costing_method")
  fiscalYearStartMonth         Int       @default(1) @map("fiscal_year_start_month")
  currencyCode                 String    @default("IDR") @map("currency_code")
  currencySymbol               String    @default("Rp ") @map("currency_symbol")
  currencyLocale               String    @default("id_ID") @map("currency_locale")
  documentNumberFormat         String    @default("YRA-{d}/{m}/{Y}-{0001}") @map("document_number_format")
  periodLockDate               DateTime? @map("period_lock_date")
  showIsActiveField            Boolean   @default(true) @map("show_is_active_field")
  showTaxId                    Boolean   @default(true) @map("show_tax_id")
  itemCodePrefix               String?   @default("ITM-") @map("item_code_prefix")
  enableAutoItemCode           Boolean   @default(true) @map("enable_auto_item_code")
  warehouseCodePrefix          String?   @default("WH-") @map("warehouse_code_prefix")
  enableAutoWarehouseCode      Boolean   @default(true) @map("enable_auto_warehouse_code")
  rackCodePrefix               String?   @default("RCK-") @map("rack_code_prefix")
  enableAutoRackCode           Boolean   @default(true) @map("enable_auto_rack_code")
  rowCodePrefix                String?   @default("ROW-") @map("row_code_prefix")
  enableAutoRowCode            Boolean   @default(true) @map("enable_auto_row_code")
  customerCodePrefix           String?   @default("CUST-") @map("customer_code_prefix")
  enableAutoCustomerCode       Boolean   @default(true) @map("enable_auto_customer_code")
  employeeCodePrefix           String?   @default("EMP-") @map("employee_code_prefix")
  enableAutoEmployeeCode       Boolean   @default(true) @map("enable_auto_employee_code")
  vendorCodePrefix             String?   @default("VEND-") @map("vendor_code_prefix")
  enableAutoVendorCode         Boolean   @default(true) @map("enable_auto_vendor_code")
  paymentMethodCodePrefix      String?   @default("MTP-") @map("payment_method_code_prefix")
  enableAutoPaymentMethodCode  Boolean   @default(true) @map("enable_auto_payment_method_code")
  shippingMethodCodePrefix     String?   @default("MTK-") @map("shipping_method_code_prefix")
  enableAutoShippingMethodCode Boolean   @default(true) @map("enable_auto_shipping_method_code")
  quotationCodePrefix          String    @default("QUO") @map("quotation_code_prefix")
  assetPrefix                  String?   @default("ISF") @map("asset_prefix")
  salesOrderPrefix             String    @default("SO") @map("sales_order_prefix")
  salesInvoicePrefix           String    @default("INV") @map("sales_invoice_prefix")
  salesPaymentPrefix           String    @default("PAY") @map("sales_payment_prefix")
  salesReturnPrefix            String    @default("SR") @map("sales_return_prefix")
  purchaseRequestPrefix        String    @default("PR-") @map("purchase_request_prefix")
  purchaseOrderPrefix          String    @default("PO-") @map("purchase_order_prefix")
  inventoryTransferPrefix      String    @default("TRF") @map("inventory_transfer_prefix")
  stockAdjustmentPrefix        String    @default("ADJ") @map("stock_adjustment_prefix")
  workOrderPrefix              String    @default("WO") @map("work_order_prefix")
  timesheetPrefix              String    @default("TS") @map("timesheet_prefix")
  downPaymentPrefix            String    @default("DP") @map("down_payment_prefix")
  deliveryOrderPrefix          String    @default("DO") @map("delivery_order_prefix")
  journalPrefix                String    @default("JRN") @map("journal_prefix")
  expensePrefix                String    @default("EXP") @map("expense_prefix")
  pettyCashPrefix              String    @default("PC") @map("petty_cash_prefix")
  reconciliationPrefix         String    @default("REC") @map("reconciliation_prefix")
  payrollPrefix                String    @default("PAYROLL") @map("payroll_prefix")
  projectPrefix                String    @default("PRJ") @map("project_prefix")
  goodsReceiptPrefix           String    @default("GR") @map("goods_receipt_prefix")
  vendorBillPrefix             String    @default("BILL") @map("vendor_bill_prefix")
  vendorPaymentPrefix          String    @default("VPAY") @map("vendor_payment_prefix")
  purchaseReturnPrefix         String    @default("PRET") @map("purchase_return_prefix")
  ticketPrefix                 String    @default("TKT") @map("ticket_prefix")
  leadPrefix                   String    @default("LEAD") @map("lead_prefix")
  materialIssuePrefix          String    @default("MI") @map("material_issue_prefix")
  manufacturingOrderPrefix     String    @default("MO") @map("manufacturing_order_prefix")
  stockMovementPrefix          String    @default("SM") @map("stock_movement_prefix")
  overtimeMultiplier           Decimal   @default(0.00578035) @map("overtime_multiplier") @db.Decimal(10, 8)
  overtimeMealBreakStart       String    @default("17:00") @map("overtime_meal_break_start")
  overtimeMealBreakEnd         String    @default("19:00") @map("overtime_meal_break_end")
  restBreakStart               String    @default("12:00") @map("rest_break_start")
  restBreakEnd                 String    @default("13:00") @map("rest_break_end")
  overtimeCoefficient          Decimal   @default(1.10) @map("overtime_coefficient") @db.Decimal(5, 2)
  attendanceRadiusKm           Decimal   @default(1.00) @map("attendance_radius_km") @db.Decimal(8, 2)
  latePenaltyPerMinute         Decimal   @default(5000.00) @map("late_penalty_per_minute") @db.Decimal(15, 2)
  maxLatePenaltyMinutes        Int       @default(120) @map("max_late_penalty_minutes")
  payrollCutoffDay             Int       @default(25) @map("payroll_cutoff_day")

  quotationFooterNotes             String? @map("quotation_footer_notes") @db.Text
  quotationSignatureName           String? @map("quotation_signature_name")
  quotationSignatureImage          String? @map("quotation_signature_image")
  salesReceivableAccountId         Int?    @map("sales_receivable_account_id")
  salesRevenueAccountId            Int?    @map("sales_revenue_account_id")
  salesTaxAccountId                Int?    @map("sales_tax_account_id")
  salesReturnAccountId             Int?    @map("sales_return_account_id")
  salesAccountId                   Int?    @map("sales_account_id")
  purchasePayableAccountId         Int?    @map("purchase_payable_account_id")
  purchaseInventoryAccountId       Int?    @map("purchase_inventory_account_id")
  purchaseTaxAccountId             Int?    @map("purchase_tax_account_id")
  purchaseExpenseAccountId         Int?    @map("purchase_expense_account_id")
  purchaseDiscountAccountId        Int?    @map("purchase_discount_account_id")
  purchaseShippingAccountId        Int?    @map("purchase_shipping_account_id")
  purchaseAdminFeeAccountId        Int?    @map("purchase_admin_fee_account_id")
  purchaseReturnAccountId          Int?    @map("purchase_return_account_id")
  // AUD-FIN-01: akun kewajiban Uang Muka Penjualan (CoA 210102). Sebelumnya
  // jurnal terima DP mengkredit salesReceivableAccountId (Piutang 1103) —
  // salah klasifikasi: DP yang belum jadi pendapatan adalah KEWAJIBAN,
  // bukan pengurang piutang. Null = instalasi lama; hook menolak posting DP
  // sampai dimapping (fail-closed), automap menebak dari nama "uang muka".
  customerDownPaymentAccountId     Int?    @map("customer_down_payment_account_id")
  // F-2026-10-21-021 tahap 3 (rute provisi MATI, vonis BOT 4 + PUTUSAN G1
  // Lead): mapping jurnal garansi E2/E3. Semua nullable tanpa default tebak;
  // posting garansi DITOLAK fail-closed bila mapping jalur terpilih kosong.
  // warrantyProvisionAccountId disiapkan untuk E1/E4 yang masih DITUNDA —
  // tidak ada pemanggil yang memakainya sampai gerbang data dinilai BOT 4.
  warrantyExpenseAccountId         Int?    @map("warranty_expense_account_id")
  warrantyProvisionAccountId       Int?    @map("warranty_provision_account_id")
  // F-2026-10-22-093-V (vonis BOT 4 PR #563 P2d/P3): akun pendapatan denda
  // keterlambatan piutang. Nullable TANPA default tebak; terbit dokumen
  // denda DITOLAK fail-closed bila kosong (dilarang fallback ke
  // salesRevenueAccountId). salesLateFeePrefix pola prefix dokumen lain.
  lateFeeIncomeAccountId           Int?    @map("late_fee_income_account_id")
  salesLateFeePrefix               String  @default("LF") @map("sales_late_fee_prefix")
  supplierClaimReceivableAccountId Int?    @map("supplier_claim_receivable_account_id")
  inventoryAccountId               Int?    @map("inventory_account_id")
  inventoryAdjustmentAccountId     Int?    @map("inventory_adjustment_account_id")
  stockAdjustmentAccountId         Int?    @map("stock_adjustment_account_id")
  cogsAccountId                    Int?    @map("cogs_account_id")
  wipAccountId                     Int?    @map("wip_account_id")
  materialExpenseAccountId         Int?    @map("material_expense_account_id")
  materialIssueExpenseAccountId    Int?    @map("material_issue_expense_account_id")
  pettyCashAccountId               Int?    @map("petty_cash_account_id")
  cashBankAccountId                Int?    @map("cash_bank_account_id")
  generalExpenseAccountId          Int?    @map("general_expense_account_id")
  defaultCashAccountId             Int?    @map("default_cash_account_id")
  salaryExpenseAccountId           Int?    @map("salary_expense_account_id")
  salariesPayableAccountId         Int?    @map("salaries_payable_account_id")
  payrollBankAccountId             Int?    @map("payroll_bank_account_id")
  employeeReceivableAccountId      Int?    @map("employee_receivable_account_id")
  payrollJournalTypeId             Int?    @map("payroll_journal_type_id")
  depreciationExpenseAccountId     Int?    @map("depreciation_expense_account_id")
  accumulatedDepreciationAccountId Int?    @map("accumulated_depreciation_account_id")
  defaultProjectStages             String  @default("Persiapan, Pengerjaan, Quality Check, Selesai") @map("default_project_stages") @db.VarChar(1000)
  // F-2026-10-21-020 Tahap A: template tahap perintah kerja (pola
  // defaultProjectStages). Vonis Lead: isi default 4 nama saja; template
  // per-Product ditunda (WO tanpa productId andal).
  defaultWorkOrderStages           String  @default("Persiapan, Pengerjaan, Quality Check, Selesai") @map("default_work_order_stages") @db.VarChar(1000)
  /**
   * F-006: gerbang jurnal disposisi varians produksi. Default MATI —
   * tanpa mode ini satu pun jurnal varians tak boleh terbit walau order
   * completed (variance order = angka analitis, bukan saldo menunggu jurnal).
   */
  standardCostingEnabled          Boolean @default(false) @map("standard_costing_enabled")
  /**
   * F-006: akun selisih biaya produksi, fail-closed (kosong = posting
   * disposisi ditolak berisik; JANGAN fallback materialExpense/cogs —
   * fallback itu hanya utk selisih PEMBULATAN < ambang).
   */
  productionVarianceAccountId     Int?    @map("production_variance_account_id")
  /**
   * F-2026-10-21-008 (vonis BOT 4 F-2026-10-22-066-V, putusan flag Lead
   * MODE CATAT-DULU): gerbang jurnal scrap abnormal P2(b). Default MATI —
   * klasifikasi + snapshot + laporan scrap jalan penuh tanpa jurnal;
   * complete TIDAK ditolak karena akun kosong. ON = jurnal Dr
   * abnormalScrapExpenseAccountId / Cr WIP dalam tx issue yang sama.
   */
  abnormalScrapPostingEnabled     Boolean @default(false) @map("abnormal_scrap_posting_enabled")
  /**
   * Akun Beban Kerugian Produksi (usulan BOT 3: kode 510105, anak 5101;
   * menunggu persetujuan BOT 4). Fail-closed saat flag ON: kosong =
   * complete ditolak berisik; DILARANG fallback materialExpense/cogs.
   */
  abnormalScrapExpenseAccountId   Int?    @map("abnormal_scrap_expense_account_id")
  /**
   * F-2026-10-23-121-V Putusan 1: akun laba ditahan tujuan jurnal penutup
   * tahunan (YearEndClosing). Nullable fail-closed: kosong/nonaktif/
   * non-EQTY/bukan laba ditahan = posting ditolak berisik. TANPA default
   * tebakan (jangan hardcode 300002); operator memetakan di Pengaturan.
   */
  retainedEarningsAccountId       Int?    @map("retained_earnings_account_id")
  /**
   * F-2026-10-23-111-V Putusan 2: akun utang PPh final 10% revaluasi fiskal
   * berpersetujuan DJP + tarifnya sebagai DATA master (bukan konstanta kode).
   * Keduanya nullable fail-closed: kosong = peristiwa fiskal ditolak berisik
   * (komersial ditahan sampai jalur komersial-saja dipilih eksplisit).
   * Ganti tarif sesudahnya tidak mengubah snapshot peristiwa lama (E111-4).
   */
  assetFiscalRevaluationTaxPayableAccountId Int?    @map("asset_fiscal_revaluation_tax_payable_account_id")
  assetFiscalRevaluationFinalTaxRatePercent Decimal? @map("asset_fiscal_revaluation_final_tax_rate_percent") @db.Decimal(5, 2)
  /**
   * F-2026-10-24-132-V Putusan 2 (vonis BOT 4): mapping kompensasi PKWT.
   * Nullable TANPA default tebak; akrual/peristiwa berharga DITOLAK
   * fail-closed bila kosong/nonaktif. Akun standar: 600028 Beban
   * Kompensasi PKWT / 210207 Utang Kompensasi PKWT. 600005/210204
   * DILARANG untuk jalur ini.
   */
  pkwtCompensationExpenseAccountId Int?    @map("pkwt_compensation_expense_account_id")
  pkwtCompensationPayableAccountId Int?    @map("pkwt_compensation_payable_account_id")
  /**
   * F-2026-10-24-135-V Putusan 4 (vonis BOT Accountant PR #742): akun
   * pendapatan lain-lain penjualan besi tua scrap. Nullable TANPA default
   * tebak (kandidat seed 710003 tidak di-hardcode); posting faktur yang
   * semua barisnya item besi tua DITOLAK fail-closed bila kosong —
   * DILARANG fallback ke salesRevenueAccountId/710005.
   */
  scrapSaleIncomeAccountId Int?    @map("scrap_sale_income_account_id")
  // F-2026-10-25-018-V Putusan 3: akun Utang Reimbursement Karyawan (kode
  // COA 210209) untuk jurnal akrual klaim J-RB1/J-RB2. Nullable TANPA
  // default tebak; kosong = approve klaim ditolak fail-closed.
  reimbursementLiabilityAccountId Int? @map("reimbursement_liability_account_id")
  /**
   * F-2026-10-25-020-V Putusan 5: akun potongan disiplin & statutori payroll.
   * Nullable TANPA default tebak; kosong/nonaktif = mutasi ditolak
   * fail-closed. Standar: 210210 Utang PPh 21 Karyawan / 210211 Utang
   * Iuran BPJS Karyawan / 710006 Pendapatan Denda Karyawan.
   */
  pph21PayableAccountId Int? @map("pph21_payable_account_id")
  bpjsEmployeePayableAccountId Int? @map("bpjs_employee_payable_account_id")
  disciplinaryFineIncomeAccountId Int? @map("disciplinary_fine_income_account_id")

  // Storage / CDN configuration
  storageDriver        String  @default("local") @map("storage_driver")
  storageFallbackLocal Boolean @default(true) @map("storage_fallback_local")
  assetBaseUrl         String? @map("asset_base_url")
  r2AccountId          String? @map("r2_account_id")
  r2AccessKeyId        String? @map("r2_access_key_id")
  r2SecretAccessKey    String? @map("r2_secret_access_key")
  r2Bucket             String? @map("r2_bucket")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model DocumentSequence {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  currentValue Int      @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("document_sequences")
}

/// Transaksi favorit per pengguna (Accurate: "Transaksi Favorit") — pintasan ke
/// halaman/dokumen yang sering dibuka. Milik satu pengguna, jadi tidak ber-slug.
model FavoriteTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String
  /**
   * Jalur internal aplikasi, mis. "/penjualan/faktur/tambah".
   */
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@index([userId])
  @@index([createdAt])
  @@map("favorite_transactions")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String
  body      String    @db.Text
  type      String    @default("info")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "notifications_user_id_fkey")
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model Customer {
  slug               String?           @unique
  id                 Int               @id @default(autoincrement())
  street             String?           @map("street") @db.Text
  village            String?           @map("village")
  district           String?           @map("district")
  province           String?           @map("province")
  postalCode         String?           @map("postal_code")
  name               String
  email              String?
  phone              String?
  address            String?           @db.Text
  city               String?
  gender             String?           @map("gender")
  taxId              String?           @map("tax_id")
  // F-2026-10-25-004-S (vonis 019-V + putusan Lead §8A): identitas pajak
  // terstruktur. taxId tetap NPWP; pkpStatus string divalidasi server
  // (non_pkp|pkp|unknown), default unknown = tidak tahu, bukan bukan-PKP.
  taxpayerName       String?           @map("taxpayer_name")
  taxAddress         String?           @map("tax_address") @db.Text
  nitku              String?           @map("nitku")
  pkpStatus          String            @default("unknown") @map("pkp_status")
  pkpEffectiveFrom   DateTime?         @map("pkp_effective_from") @db.Date
  pkpSource          String?           @map("pkp_source")
  code               String?           @unique @map("code")
  creditLimit        Decimal           @default(0.00) @map("credit_limit") @db.Decimal(15, 2)
  contactPerson      String?           @map("contact_person")
  isActive           Boolean           @default(true) @map("is_active")
  deletedAt          DateTime?         @map("deleted_at")
  createdBy          Int?              @map("created_by")
  updatedBy          Int?              @map("updated_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  customerVehicles   CustomerVehicle[]
  downPayments       DownPayment[]
  customerCredits    CustomerCredit[]
  creditOverrides    CreditOverride[]
  projects           Project[]
  quotations         Quotation[]
  salesInvoices      SalesInvoice[]
  invoiceExchanges   InvoiceExchange[]
  salesReturns       SalesReturn[]
  salesOrders        SalesOrder[]
  workOrders         WorkOrder[]
  customerCategoryId Int?              @map("customer_category_id")
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  lateFeeTerms       CustomerLateFeeTerm[]
  salesLateFees      SalesLateFee[]

  @@index([isActive, deletedAt], map: "idx_customers_active_deleted")
  @@index([name], map: "idx_customers_name")
  @@index([code], map: "idx_customers_code")
  @@index([createdAt])
  @@map("customers")
}

// AUD-FIN-02 (putusan akuntan): KREDIT PELANGGAN terstruktur. Kelebihan DP di
// atas grandTotal BUKAN pelunasan — dicatat di sini sebagai saldo yang bisa
// dipakai ulang / di-refund, bukan catatan teks di notes. Satu baris = satu
// sumber dana (DP / lebih-bayar). allocated + refunded tak boleh > received
// (ditegakkan di kode + guard tes; DB tak punya CHECK lintas kolom portabel).
// Jurnal: saat dibentuk Dr. Kewajiban UMP 210102 / Cr. Kewajiban UMP 210102
// (reklas antar subledger pelanggan, nol-net di GL); saat dipakai
// Dr. 210102 / Cr. Piutang; saat refund Dr. 210102 / Cr. Kas.
model CustomerCredit {
  id              Int      @id @default(autoincrement())
  documentNo      String   @unique @map("document_no")
  customerId      Int      @map("customer_id")
  sourceType      String   @map("source_type")
  sourceId        Int      @map("source_id")
  receivedAmount  Decimal  @map("received_amount") @db.Decimal(15, 2)
  allocatedAmount Decimal  @default(0.00) @map("allocated_amount") @db.Decimal(15, 2)
  refundedAmount  Decimal  @default(0.00) @map("refunded_amount") @db.Decimal(15, 2)
  status          String   @default("open")
  notes           String?  @db.Text
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  customer        Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status], map: "idx_customer_credits_cust_status")
  @@index([sourceType, sourceId], map: "idx_customer_credits_source")
  @@map("customer_credits")
}

/// F-2026-10-25-035-B (PUTUSAN LEAD Q-CL2-3): rekod permintaan override
/// gerbang kredit PRA-LAHIR — satu dokumen percobaan-simpan. Bukan
/// logActivity (menelan gagal) dan bukan Approval generik (terikat dokumen
/// lahir). Sidik = hash normalisasi pelanggan+jenis+pembuat+nominal+
/// kaitan quotation/SO sumber; payload form mentah DILARANG disimpan.
/// Status: pending|approved|rejected|used|expired|superseded. Approved
/// kedaluwarsa 23:59:59 WIB hari sama (expiresAt); pending tak diputus
/// 1 hari kerja WIB = expired turunan saat dibaca/dipakai.
model CreditOverride {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  documentType     String    @map("document_type") @db.VarChar(16)
  fingerprint      String    @db.VarChar(64)
  attemptedAmount  Decimal   @map("attempted_amount") @db.Decimal(15, 2)
  creditLimit      Decimal   @map("credit_limit") @db.Decimal(15, 2)
  exposure         Decimal   @db.Decimal(15, 2)
  exposureStatus   String    @map("exposure_status") @db.VarChar(16)
  utilization      Decimal?  @db.Decimal(8, 2)
  quotationId      Int?      @map("quotation_id")
  salesOrderId     Int?      @map("sales_order_id")
  requestedBy      Int       @map("requested_by")
  requestReason    String    @map("request_reason") @db.Text
  status           String    @default("pending") @db.VarChar(16)
  decidedBy        Int?      @map("decided_by")
  decidedAt        DateTime? @map("decided_at")
  decisionReason   String?   @map("decision_reason") @db.Text
  usedDocumentId   Int?      @map("used_document_id")
  usedDocumentNo   String?   @map("used_document_no")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  customer         Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId, status], map: "idx_credit_overrides_cust_status")
  @@index([fingerprint, status], map: "idx_credit_overrides_fp_status")
  @@index([requestedBy, status], map: "idx_credit_overrides_req_status")
  @@map("credit_overrides")
}

model FinancialIdempotencyKey {
