/// Transfer antar rekening kas/bank (Accurate: "Transfer Bank").
///
/// Rekening disimpan sebagai id akun biasa (tanpa relasi), sama seperti
/// `Bank.accountId` — supaya tidak perlu menambah relasi balik di `Account`.
/// Jurnalnya dibuat sekali saat dokumen dibuat dan DI-POSTING langsung
/// (transfer uang nyata), dengan `referenceType`/`referenceId` ke transfer ini.
model BankTransfer {
  slug          String?   @unique
  id            Int       @id @default(autoincrement())
  documentNo    String    @unique @map("document_no")
  date          DateTime
  fromAccountId Int       @map("from_account_id")
  toAccountId   Int       @map("to_account_id")
  amount        Decimal   @db.Decimal(15, 2)
  adminFee      Decimal   @default(0.00) @map("admin_fee") @db.Decimal(15, 2)
  feeAccountId  Int?      @map("fee_account_id")
  description   String?   @db.Text
  journalId     Int?      @map("journal_id")
  createdBy     Int?      @map("created_by")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([date])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("bank_transfers")
}

/// Giro/cek (Accurate: "Giro Mundur") — register giro & cek beserta tanggal
/// jatuh temponya, dasar laporan "Giro Mundur (Belum Jatuh Tempo)".
model Cheque {
  id         Int       @id @default(autoincrement())
  documentNo String    @unique @map("document_no")
  /**
   * "giro" | "cek".
   */
  type       String    @default("giro")
  /**
   * "in" = diterima dari pelanggan, "out" = dikeluarkan ke pemasok.
   */
  direction  String    @default("in")
  /**
   * Nomor giro/cek yang tercetak di lembar bank.
   */
  number     String?
  accountId  Int?      @map("account_id")
  party      String?
  amount     Decimal   @db.Decimal(15, 2)
  dueDate    DateTime  @map("due_date")
  /**
   * "pending" (belum cair) | "cleared" | "cancelled".
   */
  status     String    @default("pending")
  notes      String?   @db.Text
  createdBy  Int?      @map("created_by")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([dueDate])
  @@index([direction])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("cheques")
}

