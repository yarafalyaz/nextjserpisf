model Item {
  id                   Int                  @id @default(autoincrement())
  slug                 String?              @unique
  sku                  String               @unique
  name                 String
  description          String?              @db.Text
  image                String?              @db.Text
  categoryId           Int?                 @map("category_id")
  groupId              Int?                 @map("group_id")
  brandId              Int?                 @map("brand_id")
  vendorId             Int?                 @map("vendor_id")
  defaultWarehouseId   Int?                 @map("default_warehouse_id")
  defaultRackId        Int?                 @map("default_rack_id")
  defaultRackRowId     Int?                 @map("default_rack_row_id")
  unitOfMeasure        String               @default("PCS") @map("unit_of_measure")
  qtyOnHand            Decimal              @default(0.00) @map("qty_on_hand") @db.Decimal(15, 2)
  minStock             Decimal              @default(0.00) @map("min_stock") @db.Decimal(15, 2)
  cost                 Decimal              @default(0.00) @db.Decimal(15, 2)
  price                Decimal              @default(0.00) @db.Decimal(15, 2)
  standardCost         Decimal              @default(0.00) @map("standard_cost") @db.Decimal(15, 2)
  costingMethod        String               @default("average") @map("costing_method")
  purchasePrice        Decimal              @default(0.00) @map("purchase_price") @db.Decimal(15, 2)
  isProduct            Boolean              @default(false) @map("is_product")
  isService            Boolean              @default(false) @map("is_service")
  // F-2026-10-21-021 tahap 1: masa garansi pasang per item (bulan). Null =
  // item tidak bergaransi pasang; tidak ada coverage lahir saat WO selesai.
  warrantyMonths       Int?                 @map("warranty_months")
  // F-2026-10-24-135-V (vonis BOT Accountant PR #742, Putusan 2/4): penanda
  // item besi tua hasil scrap. Item besi tua dijual lewat SalesInvoice
  // existing; hook memilih akun pendapatan lain-lain (setting di bawah)
  // hanya bila SEMUA baris faktur item besi tua. Item non-stok
  // (isProduct=false) tidak melahirkan StockMove/COGS — COGS Rp0 karena
  // nilai buku scrap Rp0 (066-V); dilarang mengarang cost fiktif.
  isScrapSaleItem      Boolean              @default(false) @map("is_scrap_sale_item")
  // F-2026-10-25-042-V (vonis Q-ITX-1, spec F-2026-10-25-041-S): penampung
  // default pajak per item. FK nullable ke Tax per arah (FK TaxGroup dan
  // kolom teks kode transaksi DITOLAK vonis). Null = perilaku existing
  // byte-sama; murni bantuan input + jejak rekonsiliasi, DILARANG memengaruhi
  // angka TaxInvoice/SPT/jurnal (Putusan 6). defaultDppPercent = persen dari
  // nilai baris yang menjadi DPP baris, BUKAN pengganti faktor 11/12 PMK-131
  // kode dokumen (Putusan 2). Item scrap dilarang membawa default (Putusan 5).
  defaultSalesTaxId    Int?                 @map("default_sales_tax_id")
  defaultPurchaseTaxId Int?                 @map("default_purchase_tax_id")
  defaultDppPercent    Decimal?             @map("default_dpp_percent") @db.Decimal(5, 2)
  defaultSalesTax      Tax?                 @relation("ItemDefaultSalesTax", fields: [defaultSalesTaxId], references: [id], onDelete: SetNull)
  defaultPurchaseTax   Tax?                 @relation("ItemDefaultPurchaseTax", fields: [defaultPurchaseTaxId], references: [id], onDelete: SetNull)
  trackBatch           Boolean              @default(false) @map("track_batch")
  trackSerial          Boolean              @default(false) @map("track_serial")
  isActive             Boolean              @default(true) @map("is_active")
  deletedAt            DateTime?            @map("deleted_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  barcodes             Barcode[]
  deliveryOrderItems   DeliveryOrderItem[]
  inventoryLayers      InventoryLayer[]
  itemBatches          ItemBatch[]
  itemSerials          ItemSerial[]
  brand                Brand?               @relation(fields: [brandId], references: [id])
  category             ItemCategory?        @relation(fields: [categoryId], references: [id])
  group                ItemGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rack                 Rack?                @relation(fields: [defaultRackId], references: [id], onDelete: SetNull)
  rackRow              RackRow?             @relation(fields: [defaultRackRowId], references: [id], onDelete: SetNull)
  warehouse            Warehouse?           @relation("ItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  vendor               Vendor?              @relation(fields: [vendorId], references: [id])
  stockMoves           StockMove[]
  stockReservations    StockReservation[]
  stocktakeLines       StocktakeLine[]
  remnants             Remnant[]
  manufacturedProducts Product[]            @relation("ProductInventoryItem")
  uomConversions       UomConversion[]
  fitmentRules         VehicleFitmentRule[]
  vendorPrices         VendorItemPrice[]
  customerPrices       CustomerPriceList[]
  warrantyCoverages    WarrantyCoverage[]
  installedParts       InstalledPart[]
  materialRequestItems MaterialRequestItem[]
  substitutes          ItemSubstitute[]     @relation("ItemSubstitutes")
  substitutedFor       ItemSubstitute[]     @relation("ItemSubstitutedFor")
  warehouseSettings    ItemWarehouseSetting[]

  @@index([brandId], map: "items_brand_id_fkey")
  @@index([categoryId], map: "items_category_id_fkey")
  @@index([groupId], map: "items_group_id_fkey")
  @@index([defaultRackId], map: "items_default_rack_id_fkey")
  @@index([defaultRackRowId], map: "items_default_rack_row_id_fkey")
  @@index([defaultWarehouseId], map: "items_default_warehouse_id_fkey")
  @@index([vendorId], map: "items_vendor_id_fkey")
  @@index([isActive], map: "idx_items_is_active")
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("items")
}

