  destinationWarehouseId Int                     @map("destination_warehouse_id")
  date                   DateTime
  notes                  String?                 @db.Text
  status                 String                  @default("draft")
  createdBy              Int?                    @map("created_by")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  items                  InventoryTransferItem[]
  destinationWarehouse   Warehouse               @relation("TransferDest", fields: [destinationWarehouseId], references: [id])
  sourceWarehouse        Warehouse               @relation("TransferSource", fields: [sourceWarehouseId], references: [id])

  @@index([destinationWarehouseId], map: "inventory_transfers_destination_warehouse_id_fkey")
  @@index([sourceWarehouseId], map: "inventory_transfers_source_warehouse_id_fkey")
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id                  Int               @id @default(autoincrement())
  inventoryTransferId Int               @map("inventory_transfer_id")
  itemId              Int               @map("item_id")
  qty                 Decimal           @db.Decimal(15, 2)
  // FIFO lot/serial attribution captured at process time. A transfer is a MOVE,
  // not a sale: the batch lots and serials consumed from the source warehouse must
  // be re-created/revived in the destination warehouse on receive. Without these
  // the origin lots are decremented and the serials stay "used" forever (unsellable)
  // while the destination shows qty on hand with no lot/serial behind it.
  serialNumbers       Json?             @map("serial_numbers")
  batchAllocations    Json?             @map("batch_allocations")
  inventoryTransfer   InventoryTransfer @relation(fields: [inventoryTransferId], references: [id], onDelete: Cascade)

  @@index([inventoryTransferId], map: "inventory_transfer_items_inventory_transfer_id_fkey")
  @@index([itemId])
  @@map("inventory_transfer_items")
}

