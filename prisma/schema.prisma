  @@index([status], map: "idx_contract_decision_requests_status")
  @@index([requestedBy], map: "idx_contract_decision_requests_requested_by")
  @@index([finalReviewId], map: "contract_decision_requests_final_review_id_fkey")
  @@map("contract_decision_requests")
}

// ==================== HCMS: REKRUTMEN ====================
// Pilar HCMS pertama di dalam ERP (bukan integrasi eksternal): lowongan
// dibuka HR, pelamar bergerak lewat tahapan seleksi, dan penerimaan
// (hired) melahirkan baris Employee dari data pelamar + jabatan lowongan
// sehingga seluruh modul SDM lain (absensi, payroll, scope tim) langsung
// berlaku tanpa sinkronisasi antar-sistem.




// ==================== HCMS: PENILAIAN KINERJA ====================
// Siklus penilaian berisi sasaran (goals) berbobot per karyawan dan satu
// ulasan per karyawan per siklus. Penilai bawaan = atasan di pohon
// organisasi (Employee.managerId); gerbang akses memakai scope HR
// (self/tim/departemen/all) yang sama dengan modul SDM lain.




// ==================== HCMS: KOMPETENSI & PELATIHAN ====================
// Kompetensi didefinisikan sekali, dipetakan ke jabatan dengan level
// syarat, lalu dinilai per karyawan — selisihnya adalah peta kebutuhan
// pelatihan. Pelatihan mencatat peserta + hasil per karyawan.






// ==================== HCMS: PERENCANAAN SUKSESI ====================
// Jabatan kritis (Position.isCritical) dipetakan ke kandidat pengganti
// berurutan prioritas dengan tingkat kesiapan. Cakupan diturunkan:
// ada kandidat ready_now = aman; hanya kandidat masa depan = berisiko;
// tanpa kandidat = kosong (risiko tertinggi). Bersifat rahasia: hanya
// peran pengelola SDM yang memegang izinnya, karyawan biasa tidak.


// ==================== HCMS: RIWAYAT KENAIKAN GAJI ====================
// Employee.baseSalary adalah nilai BERLAKU SAAT INI; tabel ini adalah
// riwayatnya. Kenaikan dicatat dengan tanggal efektif: yang sudah lewat
// langsung diterapkan ke master dalam transaksi yang sama; yang akan
// datang berstatus scheduled dan diterapkan otomatis oleh jalur
// pembuatan slip (processPayroll/generateBulkPayroll) begitu jatuh
// tempo. Persentase diturunkan server, bukan ketikan client.


model OvertimeRequest {
  slug                 String?   @unique
  id                   Int       @id @default(autoincrement())
  employeeId           Int       @map("employee_id")
  projectId            Int?      @map("project_id")
  date                 DateTime
  hours                Decimal   @db.Decimal(5, 2)
  totalHours           Decimal?  @map("total_hours") @db.Decimal(5, 2)
  mealHours            Decimal?  @map("meal_hours") @db.Decimal(5, 2)
  billableHours        Decimal?  @map("billable_hours") @db.Decimal(5, 2)
  calculatedValue      Decimal?  @map("calculated_value") @db.Decimal(15, 2)
  overtimeBaseSnapshot Json?     @map("overtime_base_snapshot")
  reason               String?   @db.Text
  rejectionReason      String?   @map("rejection_reason") @db.Text
  status               String    @default("pending")
  approvedBy           Int?      @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  supervisorApprovedAt DateTime? @map("supervisor_approved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  employee             Employee  @relation(fields: [employeeId], references: [id])
  project              Project?  @relation(fields: [projectId], references: [id])

  @@index([employeeId], map: "overtime_requests_employee_id_fkey")
  @@index([projectId], map: "overtime_requests_project_id_fkey")
  @@index([status])
  @@index([approvedBy])
  @@index([createdAt])
  @@map("overtime_requests")
}

/// P1-5: sesi opname bertahap — snapshot sistem, hitung 1+2 (recount),
/// final, approval independen, lalu posting variance jadi adjustment.
/// Movement concurrent selama sesi dicatat (delta snapshot vs live saat posting).
model StocktakeSession {
  id           Int             @id @default(autoincrement())
  documentNo   String          @unique @map("document_no")
  slug         String?         @unique
  warehouseId  Int             @map("warehouse_id")
  date         DateTime        @db.Date
  status       String          @default("draft") @db.VarChar(32)
  snapshotAt   DateTime?       @map("snapshot_at")
  notes        String?         @db.Text
  countedBy    Int?            @map("counted_by")
  approvedBy   Int?            @map("approved_by")
  approvedAt   DateTime?       @map("approved_at")
  adjustmentId Int?            @map("adjustment_id")
  createdBy    Int?            @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  lines        StocktakeLine[]

  @@index([warehouseId])
  @@index([status])
  @@map("stocktake_sessions")
}

/// P1-5: sisa potong usable/scrap. Remnant BUKAN stok gudang ganda — ia
/// mencatat sisa dari material yang sudah keluar (issue/produksi). Konsumsi =
/// status consumed (tanpa movement); scrap = alasan + biaya terpisah.
model Remnant {
  id          Int       @id @default(autoincrement())
  documentNo  String    @unique @map("document_no")
  itemId      Int       @map("item_id")
  warehouseId Int       @map("warehouse_id")
  qty         Decimal   @db.Decimal(15, 2)
  uom         String?   @db.VarChar(32)
  dimensions  String?   @db.VarChar(255)
  sourceType  String?   @map("source_type") @db.VarChar(32)
  sourceId    Int?      @map("source_id")
  unitCost    Decimal   @default(0) @map("unit_cost") @db.Decimal(15, 2)
  status      String    @default("usable") @db.VarChar(32)
  scrapReason String?   @map("scrap_reason") @db.VarChar(500)
  // F-2026-10-24-098-S D-S98-02: snapshot ambang usable kategori saat remnant
  // dibuat (null = kategori belum berambang; pembacaan master hidup dilarang).
  remnantMinMeasureSnapshot Decimal? @map("remnant_min_measure_snapshot") @db.Decimal(15, 2)
  measuredSize              Decimal? @map("measured_size") @db.Decimal(15, 2)
  // F-2026-10-24-098-S D-S98-03: berat besi tua (kg) wajib saat transisi scrap.
  scrapWeightKg Decimal?  @map("scrap_weight_kg") @db.Decimal(15, 2)
  consumedBy  String?   @map("consumed_by") @db.VarChar(128)
  consumedAt  DateTime? @map("consumed_at")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  item        Item      @relation(fields: [itemId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@map("remnants")
}

model StocktakeLine {
  id         Int              @id @default(autoincrement())
  sessionId  Int              @map("session_id")
  itemId     Int              @map("item_id")
  systemQty  Decimal          @default(0) @db.Decimal(15, 2)
  count1     Decimal?         @db.Decimal(15, 2)
  count2     Decimal?         @db.Decimal(15, 2)
  finalCount Decimal?         @map("final_count") @db.Decimal(15, 2)
  variance   Decimal?         @map("variance") @db.Decimal(15, 2)
  note       String?          @db.VarChar(500)
  session    StocktakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item       Item             @relation(fields: [itemId], references: [id])

  @@index([sessionId])
  @@index([itemId])
  @@map("stocktake_lines")
}

/// P1-6: ruleset statutori payroll berperiode. Tarif jangan diedit diam-diam:
/// perubahan aturan = baris baru dengan effectiveFrom baru (+ tutup baris lama
/// via effectiveTo). Seed awal = parameter 2024 yang sebelumnya hardcoded.
/// Angka 2026+ NEEDS ACCOUNTANT/LEGAL CONFIRMATION sebelum dimasukkan.
model PayrollStatutoryRule {
  id            Int       @id @default(autoincrement())
  key           String    @db.VarChar(64)
  value         Decimal   @db.Decimal(20, 6)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  source        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([key, effectiveFrom], map: "payroll_statutory_rules_key_effective_from_unique")
  @@map("payroll_statutory_rules")
}

/// F-2026-10-21-026: tabel TER bulanan PP 58/2023 Lampiran A/B/C sebagai data
/// master berperiode (BUKAN konstanta kode). Satu baris = satu bracket:
/// batas bawah eksklusif / batas atas inklusif bruto bulanan; tarif disimpan
/// rateMilliPercent (tarif % × 1000, 2% = 2000). Baris terbuka: upperBound null.
model PayrollTerBracket {
  id            Int       @id @default(autoincrement())
  category      String    @db.VarChar(1)
  lowerBound    Decimal   @map("lower_bound") @db.Decimal(20, 2)
  upperBound    Decimal?  @map("upper_bound") @db.Decimal(20, 2)
  rateMilliPercent Int   @map("rate_milli_percent")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  source        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([category, lowerBound, effectiveFrom], map: "payroll_ter_brackets_category_lower_effective_unique")
  @@index([category, effectiveFrom], map: "payroll_ter_brackets_category_effective_idx")
  @@map("payroll_ter_brackets")
}

model Payroll {
  slug                   String?     @unique
  id                     Int         @id @default(autoincrement())
  documentNo             String      @unique @map("document_no")
  employeeId             Int?        @map("employee_id")
  period                 String
  type                   String      @default("REGULAR")
  startDate              DateTime    @map("start_date")
  endDate                DateTime    @map("end_date")
  baseSalary             Decimal     @default(0.00) @map("base_salary") @db.Decimal(15, 2)
  allowances             Decimal     @default(0.00) @db.Decimal(15, 2)
  deductions             Decimal     @default(0.00) @db.Decimal(15, 2)
  overtimeTotal          Decimal     @default(0.00) @map("overtime_total") @db.Decimal(15, 2)
  appreciationTotal      Decimal     @default(0.00) @map("appreciation_total") @db.Decimal(15, 2)
  loanDeduction          Decimal     @default(0.00) @map("loan_deduction") @db.Decimal(15, 2)
  lateDeduction          Decimal     @default(0.00) @map("late_deduction") @db.Decimal(15, 2)
  grossSalary            Decimal     @default(0.00) @map("gross_salary") @db.Decimal(15, 2)
  bpjsHealthEmployee     Decimal     @default(0.00) @map("bpjs_health_employee") @db.Decimal(15, 2)
  bpjsEmploymentEmployee Decimal     @default(0.00) @map("bpjs_employment_employee") @db.Decimal(15, 2)
  pph21                  Decimal     @default(0.00) @map("pph21") @db.Decimal(15, 2)
  statutorySnapshot      Json?       @map("statutory_snapshot")
  lateMinutes            Int         @default(0) @map("late_minutes")
  workingDays            Int         @default(0) @map("working_days")
  presentDays            Int         @default(0) @map("present_days")
  absentDays             Int         @default(0) @map("absent_days")
  absentDeduction        Decimal     @default(0.00) @map("absent_deduction") @db.Decimal(15, 2)
  netSalary              Decimal     @default(0.00) @map("net_salary") @db.Decimal(15, 2)
  totalAmount            Decimal     @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  paymentDate            DateTime?   @map("payment_date")
  status                 String      @default("draft")
  approvedBy             Int?        @map("approved_by")
  createdBy              Int?        @map("created_by")
  /// HR-BR-005 (133-S P2/BR-HRCR-02 + 135-V §2a): koreksi slip paid = dokumen
  /// koreksi tertaut, bukan edit/hapus. Kolom ini menunjuk slip ASAL yang
  /// dikoreksi; slip asal tetap `paid` nilainya tak ditimpa. Null = slip biasa.
  correctsPayrollId      Int?        @map("corrects_payroll_id")
  /// Alasan koreksi wajib (ditolak bila kosong) — jejak audit BR-HRCR-03.
  correctionReason       String?     @map("correction_reason") @db.Text
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  employee               Employee?   @relation(fields: [employeeId], references: [id])
  /// Tautan koreksi dua arah: slip ini mengoreksi slip asal; koreksi baliknya
  /// dibaca lewat relasi `corrections`. Slip asal tetap `paid`.
  correctsPayroll        Payroll?    @relation("PayrollCorrection", fields: [correctsPayrollId], references: [id], onDelete: SetNull)
  corrections            Payroll[]   @relation("PayrollCorrection")
  componentLines         PayrollComponentLine[]
  disciplinaryDeductionApplications DisciplinaryDeductionApplication[]
  costCenter             CostCenter? @relation(fields: [costCenterId], references: [id])
  costCenterId           Int?        @map("cost_center_id")

  @@unique([employeeId, startDate, endDate], map: "uq_payroll_employee_range")
  @@index([employeeId], map: "payrolls_employee_id_fkey")
  @@index([status], map: "idx_payrolls_status")
  @@index([correctsPayrollId], map: "payrolls_corrects_payroll_id_idx")
  @@index([costCenterId])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([createdAt])
  @@map("payrolls")
}

/// F-2026-10-21-027: katalog komponen gaji terstruktur (master perusahaan).
/// `accountId` hanya disimpan tahap ini — TIDAK dipakai jurnal (jurnal tetap
/// agregat existing sampai tahap jurnal per komponen diputus terpisah).
/// `isTaxable` = klasifikasi tersimpan; mode pajak aktif tahap ini tetap
/// all-taxable-v1 (semua earning kena pajak, angka identik pra-fitur).
model PayrollComponent {
  id             Int      @id @default(autoincrement())
  name           String
  normalizedName String   @map("normalized_name")
  kind           String
  recurrence     String
  isTaxable      Boolean  @default(false) @map("is_taxable")
  accountId      Int?     @map("account_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      Int?     @map("created_by")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignments    EmployeePayrollComponent[]
  lines          PayrollComponentLine[]

  @@index([normalizedName])
  @@index([isActive])
  @@index([accountId])
  @@index([createdAt])
  @@map("payroll_components")
}

/// Penugasan komponen tetap ke karyawan. Hanya komponen recurrence=fixed
/// aktif; berlaku pada periode bila rentang mencakup endDate periode
/// (tanpa prorata). Baris nol tidak pernah ditarik ke slip.
model EmployeePayrollComponent {
  id            Int             @id @default(autoincrement())
  employeeId    Int             @map("employee_id")
  componentId   Int             @map("component_id")
  defaultAmount Decimal         @default(0.00) @map("default_amount") @db.Decimal(15, 2)
  effectiveFrom DateTime        @map("effective_from")
  effectiveTo   DateTime?       @map("effective_to")
  isActive      Boolean         @default(true) @map("is_active")
  createdBy     Int?            @map("created_by")
  updatedBy     Int?            @map("updated_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  employee      Employee        @relation(fields: [employeeId], references: [id])
  component     PayrollComponent @relation(fields: [componentId], references: [id])
  lines         PayrollComponentLine[]

  @@index([employeeId])
  @@index([componentId])
  @@index([createdAt])
  @@map("employee_payroll_components")
}

/// Baris snapshot komponen per slip gaji. Snapshot nama/kind/isTaxable/akun
/// dibekukan saat baris dibuat — master berubah/nonaktif tidak mengubah
/// slip historis. Payroll.allowances = Σ earning, deductions = Σ deduction
/// dari baris-baris ini untuk slip yang memilikinya.
model PayrollComponentLine {
  id                     Int      @id @default(autoincrement())
  payrollId              Int      @map("payroll_id")
  componentId            Int?     @map("component_id")
  componentNameSnapshot  String   @map("component_name_snapshot")
  kindSnapshot           String   @map("kind_snapshot")
  recurrenceSnapshot     String   @map("recurrence_snapshot")
  isTaxableSnapshot      Boolean  @default(false) @map("is_taxable_snapshot")
  source                 String
  assignmentId           Int?     @map("assignment_id")
  // F-2026-10-24-132-V Putusan 5: baris khusus kompensasi PKWT. pkwtEventId =
  // idempotency key peristiwa (unik: satu peristiwa paling banyak satu baris
  // slip); pkwtSettledViaAccrual dibekukan saat baris dibuat — kaki debit
  // jurnal payroll membaca snapshot ini (210207 bila terakrual, 600028 bila
  // tidak), BUKAN tebakan hook.
  pkwtEventId            Int?     @unique @map("pkwt_event_id")
  pkwtSettledViaAccrual  Boolean? @map("pkwt_settled_via_accrual")
  accountIdSnapshot      Int?     @map("account_id_snapshot")
  amount                 Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  payroll                Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  component              PayrollComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  assignment             EmployeePayrollComponent? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  pkwtEvent              PkwtCompensationEvent? @relation(fields: [pkwtEventId], references: [id], onDelete: SetNull)

  @@index([payrollId])
  @@index([componentId])
  @@index([assignmentId])
  @@index([createdAt])
  @@map("payroll_component_lines")
}

/// F-2026-10-24-132-V (vonis BOT 4): peristiwa kompensasi akhir kontrak PKWT
/// PP 35/2021 per SEGMEN kontrak/perpanjangan. Dokumen SUMBER terbekukan
/// (masa kerja 4-desimal, snapshot basis komponen, nominal) — slip gaji
/// adalah dokumen BAYAR (Q-EMP-5). Snapshot tidak diedit sesudah disetujui;
/// koreksi = peristiwa koreksi tertaut (correctsEventId).
/// status: draft | approved | paid | cancelled. isLegacy = segmen lampau
/// diakui sekaligus terlabel (Putusan 3 pengecualian).
model PkwtCompensationEvent {
  id                  Int       @id @default(autoincrement())
  employeeId          Int       @map("employee_id")
  segmentStart        DateTime  @map("segment_start")
  segmentEnd          DateTime  @map("segment_end")
  serviceMonths       Decimal   @map("service_months") @db.Decimal(10, 4)
  baseSalarySnapshot  Decimal   @map("base_salary_snapshot") @db.Decimal(15, 2)
  fixedAllowanceSnapshot Decimal @default(0.00) @map("fixed_allowance_snapshot") @db.Decimal(15, 2)
  basisMonthly        Decimal   @map("basis_monthly") @db.Decimal(15, 2)
  amount              Decimal   @db.Decimal(15, 2)
  status              String    @default("draft")
  isLegacy            Boolean   @default(false) @map("is_legacy")
  agreementDocumentRef String?  @map("agreement_document_ref")
  correctsEventId     Int?      @map("corrects_event_id")
  approvedBy          Int?      @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  paidPayrollId       Int?      @map("paid_payroll_id")
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  employee            Employee  @relation(fields: [employeeId], references: [id])
  correctsEvent       PkwtCompensationEvent? @relation("PkwtEventCorrection", fields: [correctsEventId], references: [id], onDelete: SetNull)
  corrections         PkwtCompensationEvent[] @relation("PkwtEventCorrection")
  accruals            PkwtCompensationAccrual[]
  payrollLine         PayrollComponentLine?

  @@index([employeeId])
  @@index([status])
  @@index([segmentStart, segmentEnd])
  @@index([correctsEventId])
  @@index([createdAt])
  @@map("pkwt_compensation_events")
}

/// Subledger akrual bulanan kompensasi PKWT per karyawan-segmen-bulan
/// (Putusan 3). Saldo per karyawan hidup di sini, BUKAN baris jurnal per
/// karyawan (jurnal akrual agregat satu per bulan). Unik
/// (employeeId, segmentStart, period) = anti-dobel akrual.
model PkwtCompensationAccrual {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  eventId      Int?     @map("event_id")
  segmentStart DateTime @map("segment_start")
  period       String
  amount       Decimal  @db.Decimal(15, 2)
  basisMonthly Decimal  @map("basis_monthly") @db.Decimal(15, 2)
  journalId    Int?     @map("journal_id")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  employee     Employee @relation(fields: [employeeId], references: [id])
  event        PkwtCompensationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([employeeId, segmentStart, period], map: "uq_pkwt_accrual_emp_segment_period")
  @@index([employeeId])
  @@index([eventId])
  @@index([period])
  @@index([createdAt])
  @@map("pkwt_compensation_accruals")
}

model EmployeeLoan {
  slug               String?  @unique
  id                 Int      @id @default(autoincrement())
  employeeId         Int      @map("employee_id")
  loanDate           DateTime @map("loan_date")
  totalAmount        Decimal  @map("total_amount") @db.Decimal(15, 2)
  monthlyInstallment Decimal  @map("monthly_installment") @db.Decimal(15, 2)
  // F-2026-10-23-105-V (vonis BOT 4): nominal cicilan mingguan dari
  // perjanjian tertulis; NULL = tanpa jadwal mingguan (gerbang WEEKLY
  // menahan karyawan). Dilarang auto-fill monthlyInstallment/4.
  weeklyInstallment  Decimal? @map("weekly_installment") @db.Decimal(15, 2)
  remainingAmount    Decimal  @map("remaining_amount") @db.Decimal(15, 2)
  status             String   @default("active")
  notes              String?  @db.Text
  approvedBy         Int?     @map("approved_by")
  createdBy          Int?     @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  employee           Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "employee_loans_employee_id_fkey")
  @@index([status])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([createdAt])
  @@map("employee_loans")
}

model Timesheet {
  slug        String?  @unique
  id          Int      @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  projectId   Int?      @map("project_id")
  workOrderId Int?      @map("work_order_id")
  taskId      Int?      @map("task_id")
  date        DateTime
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  hours       Decimal  @db.Decimal(8, 2)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  employee    Employee   @relation(fields: [employeeId], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  task        Task?      @relation(fields: [taskId], references: [id])

  @@index([employeeId], map: "timesheets_employee_id_fkey")
  @@index([projectId], map: "timesheets_project_id_fkey")
  @@index([workOrderId], map: "timesheets_work_order_id_fkey")
  @@index([taskId], map: "timesheets_task_id_fkey")
  @@index([createdAt])
  @@map("timesheets")
}

model Journal {
  slug            String?        @unique
  id              Int            @id @default(autoincrement())
  journalNumber   String         @unique @map("journal_number")
  transactionDate DateTime       @map("transaction_date")
  referenceType   String?        @map("reference_type")
  referenceId     Int?           @map("reference_id")
  description     String?        @db.Text
  type            String         @default("GENERAL")
  status          String         @default("DRAFT")
  totalDebit      Decimal        @map("total_debit") @db.Decimal(15, 2)
  totalCredit     Decimal        @map("total_credit") @db.Decimal(15, 2)
  createdBy       Int?           @map("created_by")
  deletedAt       DateTime?      @map("deleted_at")
  // F-2026-10-23-127-V: kolom generated di DB — jangan ditulis client.
  // MySQL hitung dari status/deletedAt/reference; unik di bawah hanya
  // mengikat jurnal aktif (status <> 'REVERSED' AND deleted_at IS NULL).
  activeReferenceKey String?    @map("active_reference_key")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  entries         JournalEntry[]
  disciplinaryDeductionApplication DisciplinaryDeductionApplication?
  creator         User?          @relation(fields: [createdBy], references: [id])

  @@unique([activeReferenceKey], map: "journals_active_reference_unique")
  @@index([createdBy], map: "journals_created_by_fkey")
  @@index([status], map: "idx_journals_status")
  @@index([transactionDate], map: "idx_journals_transaction_date")
  @@index([createdAt])
  @@index([deletedAt])
  @@map("journals")
}

model JournalEntry {
  id             Int     @id @default(autoincrement())
  journalId      Int     @map("journal_id")
  accountId      Int     @map("account_id")
  debit          Decimal @default(0.00) @db.Decimal(15, 2)
  credit         Decimal @default(0.00) @db.Decimal(15, 2)
  memo           String?
  costCenterId   Int?    @map("cost_center_id")
  profitCenterId Int?    @map("profit_center_id")
  account        Account @relation(fields: [accountId], references: [id])
  journal        Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "journal_entries_account_id_fkey")
  @@index([journalId], map: "journal_entries_journal_id_fkey")
  @@index([costCenterId])
  @@index([profitCenterId])
  @@index([accountId, journalId])
  @@map("journal_entries")
}

model ExpenseCategory {
  slug      String?     @unique
  id        Int         @id @default(autoincrement())
  name      String      @unique
  label     String
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  expenses  Expense[]
  pettyCash PettyCash[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("expense_categories")
}

model Expense {
  slug              String?          @unique
  id                Int              @id @default(autoincrement())
  documentNo        String           @unique @map("document_no")
  employeeId        Int?             @map("employee_id")
  accountId         Int              @map("account_id")
  paidFromAccountId Int?             @map("paid_from_account_id")
  projectId         Int?             @map("project_id")
  categoryId        Int?             @map("category_id")
  // Vendor/pemasok tempat biaya ini dibayarkan (mis. Tokopedia, Lalamove, PLN).
  // Melengkapi pola Jurnal Operasional: Deskripsi · Nama Project · Vendor · Kategori.
  vendorId          Int?             @map("vendor_id")
  amount            Decimal          @db.Decimal(15, 2)
  date              DateTime
  referenceNo       String?          @map("reference_no")
  description       String?          @db.Text
  receiptImage      String?          @map("receipt_image")
  // F-2026-10-25-017-S (Q-RB-3 Backend): penanda fisik klaim reimbursement
  // karyawan di atas Expense existing (BR-RB-01) — membedakan klaim dari
  // Expense operasional tanpa model/dokumen kedua. employeeId = pengaju.
  isReimbursementClaim Boolean       @default(false) @map("is_reimbursement_claim")
  status            String           @default("draft")
  approvedBy        Int?             @map("approved_by")
  costCenterId      Int?             @map("cost_center_id")
  createdBy         Int?             @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id])
  vendor            Vendor?          @relation(fields: [vendorId], references: [id])
  employee          Employee?        @relation(fields: [employeeId], references: [id])

  @@index([accountId], map: "expenses_account_id_idx")
  @@index([projectId], map: "expenses_project_id_idx")
  @@index([employeeId], map: "expenses_employee_id_idx")
  @@index([status], map: "expenses_status_idx")
  @@index([paidFromAccountId])
  @@index([approvedBy])
  @@index([costCenterId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([categoryId])
  @@index([vendorId])
  @@map("expenses")
}

model PettyCash {
  slug             String?          @unique
  id               Int              @id @default(autoincrement())
  documentNo       String           @unique @map("document_no")
  type             String
  amount           Decimal          @db.Decimal(15, 2)
  balanceBefore    Decimal          @default(0.00) @map("balance_before") @db.Decimal(15, 2)
  balanceAfter     Decimal          @default(0.00) @map("balance_after") @db.Decimal(15, 2)
  date             DateTime
  transactionDate  DateTime?        @map("transaction_date")
  accountId        Int?             @map("account_id")
  sourceAccountId  Int?             @map("source_account_id")
  expenseAccountId Int?             @map("expense_account_id")
  referenceNo      String?          @map("reference_no")
  description      String?          @db.Text
  // GL-BR-003 P6: void berstatus — "posted" | "void". Vonis V-P5/P6-6:
  // record void dikeluarkan dari rantai aktif (tidak berkontribusi saldo),
  // balanceBefore/After miliknya dibekukan sebagai snapshot historis.
  status           String           @default("posted")
  voidAt           DateTime?        @map("void_at")
  voidReason       String?          @map("void_reason") @db.Text
  deletedAt        DateTime?        @map("deleted_at")
  // Pola Jurnal Operasional: Deskripsi · Nama Project · Vendor · Kategori.
  // Project = untuk siapa/pekerjaan apa, Vendor = dari/dibayar ke siapa.
  projectId        Int?             @map("project_id")
  vendorId         Int?             @map("vendor_id")
  categoryId       Int?             @map("category_id")
  createdBy        Int?             @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
