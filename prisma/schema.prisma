model StockAdjustment {
  slug        String?               @unique
  id          Int                   @id @default(autoincrement())
  documentNo  String                @unique @map("document_no")
  warehouseId Int                   @map("warehouse_id")
  date        DateTime
  reason      String?               @db.Text
  type        String                @default("increase")
  notes       String?               @db.Text
  status      String                @default("draft")
  approvedBy  Int?                  @map("approved_by")
  approvedAt  DateTime?             @map("approved_at")
  journalId   Int?                  @map("journal_id")
  createdBy   Int?                  @map("created_by")
  deletedAt   DateTime?             @map("deleted_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  // F-2026-10-22-081-S (Q-TP-3 BOT 3): penutupan selisih transfer tertaut.
  // Adjustment alasan persis "selisih transfer" dengan kolom ini terisi =
  // jurnal-saja (nol StockMove): sisa sudah OUT dari sumber & tak pernah
  // masuk tujuan, jadi tak ada stok fisik yang dipotong di gudang mana pun.
  // TANPA @unique: penutupan ditolak/batal boleh diajukan ulang (spec §3) —
  // "satu penutupan aktif per transfer" dijaga server (status draft saja).
  inventoryTransferId Int?            @map("inventory_transfer_id")
  inventoryTransfer   InventoryTransfer? @relation(fields: [inventoryTransferId], references: [id], onDelete: SetNull)
  items       StockAdjustmentItem[]
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])

  @@index([inventoryTransferId])
  @@index([warehouseId], map: "stock_adjustments_warehouse_id_fkey")
  @@index([status])
  @@index([approvedBy])
  @@index([journalId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("stock_adjustments")
}

