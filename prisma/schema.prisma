// F-2026-10-24-099-S (§2, putusan Q-PROB-2/6): pengajuan keputusan kontrak.
// kind: extend_pkwt|convert_pkwtt|end_contract. Segmen PKWT kumulatif
// (BR-PROB-08) dihitung dari baris APPLIED model ini (appliedFromStartDate..
// appliedEndDate = tanggal terapan persis) + segmen berjalan di master —
// DILARANG rekonstruksi ActivityLog. finalReviewId = rujukan review final
// probation untuk penjaga SoD penuh Q-PROB-2 (penyetuju != penilai final).
// Tanpa nominal/kompensasi (BR-PROB-11); berhenti tetap alur F-085-S.
model ContractDecisionRequest {
  slug                 String?   @unique
  id                   Int       @id @default(autoincrement())
