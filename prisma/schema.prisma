  taxGroupId Int @map("tax_group_id")
  taxId      Int @map("tax_id")

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)

  @@unique([taxGroupId, taxId])
  @@map("tax_group_taxes")
}

// ==================== STATISTICAL KEY FIGURES ====================

model StatisticalKeyFigure {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?
  unit      String
  type      String?
  value     Decimal  @default(0) @db.Decimal(15, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skfValues SkfValue[]

  @@map("statistical_key_figures")
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  modelType   String   @map("model_type")
  modelId     Int      @map("model_id")
  description String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([modelType, modelId])
  @@map("activity_logs")
}

// ==================== TRANSACTION ATTACHMENTS ====================

model TransactionAttachment {
  id            Int      @id @default(autoincrement())
  referenceType String   @map("reference_type")
  referenceId   Int      @map("reference_id")
  filename      String
  originalName  String   @map("original_name")
  fileUrl       String   @map("file_url")
  fileSize      Int      @map("file_size")
  mimeType      String   @map("mime_type")
  uploadedBy    Int?     @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([referenceType, referenceId])
  @@map("transaction_attachments")
}

// ==================== DELIVERY ORDER ITEMS ====================

model DeliveryOrderItem {
  id               Int     @id @default(autoincrement())
  deliveryOrderId  Int     @map("delivery_order_id")
  salesOrderItemId Int?    @map("sales_order_item_id")
  itemId           Int     @map("item_id")
  qty              Decimal @db.Decimal(15, 2)
  unit             String?
  notes            String?

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@map("delivery_order_items")
}

// ==================== ITEM BATCH & SERIAL ====================

model ItemBatch {
  id                Int       @id @default(autoincrement())
  itemId            Int       @map("item_id")
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  qty               Decimal   @db.Decimal(15, 2)
  warehouseId       Int       @map("warehouse_id")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("item_batches")
}

model ItemSerial {
  id           Int      @id @default(autoincrement())
  itemId       Int      @map("item_id")
  serialNumber String   @unique @map("serial_number")
  status       String   @default("available")
  warehouseId  Int      @map("warehouse_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("item_serials")
}

// ==================== EXCHANGE RATES ====================

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  fromCurrencyId Int      @map("from_currency_id")
  toCurrencyId   Int      @map("to_currency_id")
  rate           Decimal  @db.Decimal(15, 6)
  effectiveDate  DateTime @map("effective_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fromCurrency Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])

  @@map("exchange_rates")
}

// ==================== CRM PIPELINE ====================

model CrmPipeline {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages CrmPipelineStage[]

  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id          Int      @id @default(autoincrement())
  pipelineId  Int      @map("pipeline_id")
  name        String
  order       Int
  probability Int      @default(0)
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@map("crm_pipeline_stages")
}

// ==================== APPROVAL DELEGATION ====================

model ApprovalDelegation {
  id         Int      @id @default(autoincrement())
  fromUserId Int      @map("from_user_id")
  toUserId   Int      @map("to_user_id")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  reason     String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("approval_delegations")
}

// ==================== SKF VALUES ====================

model SkfValue {
  id                     Int      @id @default(autoincrement())
  statisticalKeyFigureId Int      @map("statistical_key_figure_id")
  costCenterId           Int?     @map("cost_center_id")
  profitCenterId         Int?     @map("profit_center_id")
  period                 String
  value                  Decimal  @db.Decimal(15, 4)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  statisticalKeyFigure StatisticalKeyFigure @relation(fields: [statisticalKeyFigureId], references: [id])
  costCenter           CostCenter?          @relation(fields: [costCenterId], references: [id])
  profitCenter         ProfitCenter?        @relation(fields: [profitCenterId], references: [id])

  @@map("skf_values")
}

// ==================== PRICE LIST ITEMS ====================

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceListId Int       @map("price_list_id")
  itemId      Int       @map("item_id")
  price       Decimal   @db.Decimal(15, 2)
  minQty      Decimal   @default(1) @map("min_qty") @db.Decimal(15, 2)
  validFrom   DateTime? @map("valid_from")
  validTo     DateTime? @map("valid_to")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@map("price_list_items")
}

// ==================== UNIT OF MEASURE ====================

model UnitOfMeasure {
  id               Int      @id @default(autoincrement())
  name             String
  symbol           String
  category         String?
  baseUnitId       Int?     @map("base_unit_id")
  conversionFactor Decimal  @default(1) @map("conversion_factor") @db.Decimal(15, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("unit_of_measures")
}
