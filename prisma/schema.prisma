  reason               String    @db.Text
  requestedBy          Int       @map("requested_by")
  status               String    @default("draft")
  decidedBy            Int?      @map("decided_by")
  decidedAt            DateTime? @map("decided_at")
  rejectionReason      String?   @map("rejection_reason") @db.Text
  appliedAt            DateTime? @map("applied_at")
  appliedBy            Int?      @map("applied_by")
  appliedFromStartDate DateTime? @map("applied_from_start_date")
  appliedEndDate       DateTime? @map("applied_end_date")
  finalReviewId        Int?      @map("final_review_id")
