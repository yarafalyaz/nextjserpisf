  itemId       Int?       @map("item_id")
  description  String?
  qty          Decimal    @default(1.00) @db.Decimal(15, 2)
  unitPrice    Decimal    @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  discount     Decimal    @default(0.00) @db.Decimal(15, 2)
  total        Decimal    @default(0.00) @db.Decimal(15, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId], map: "sales_order_items_sales_order_id_fkey")
  @@index([itemId])
  @@map("sales_order_items")
}

model SalesInvoice {
  slug                 String?               @unique
  id                   Int                   @id @default(autoincrement())
  customerVehicleId    Int?                  @map("customer_vehicle_id")
  projectId            Int?                  @map("project_id")
  // F-2026-10-21-016 tahap 1: snapshot penjual diwariskan SO/Quotation.
  salesEmployeeId      Int?                  @map("sales_employee_id")
  // F-2026-10-25-036-S (BR-KT36-04): snapshot tarif komisi dibekukan pada
  // transisi ke paid, hasil resolusi per tanggal faktur. Null = faktur lama
  // tanpa snapshot (loader membaca 0 jujur, BR-KT36-13; tanpa backfill).
  commissionRatePercent      Decimal?      @map("commission_rate_percent") @db.Decimal(5, 2)
  commissionCustomerCategoryId Int?        @map("commission_customer_category_id")
  commissionRateId           Int?          @map("commission_rate_id")
  // Nomor faktur pajak keluaran (e-Faktur/Coretax). Opsional: faktur pajak
  // terbit di luar Silengkap, jadi dokumen lama/tanpa PPN tetap valid kosong.
  taxInvoiceNumber     String?               @map("tax_invoice_number")
  documentNo           String?               @unique @map("document_no")
  customerId           Int                   @map("customer_id")
  salesOrderId         Int?                  @map("sales_order_id")
  quotationId          Int?                  @map("quotation_id")
  date                 DateTime
  dueDate              DateTime?             @map("due_date")
  subtotal             Decimal               @default(0.00) @db.Decimal(15, 2)
  discount             Decimal               @default(0.00) @db.Decimal(15, 2)
  tax                  Decimal               @default(0.00) @db.Decimal(15, 2)
  grandTotal           Decimal               @default(0.00) @map("grand_total") @db.Decimal(15, 2)
  paidAmount           Decimal               @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  totalAmount          Decimal               @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  taxAmount            Decimal               @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  status               SalesInvoiceStatus    @default(draft)
  paymentStatus        String?               @map("payment_status")
  notes                String?               @db.Text
  createdBy            Int?                  @map("created_by")
  deletedAt            DateTime?             @map("deleted_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  items                SalesInvoiceItem[]
  customer             Customer              @relation(fields: [customerId], references: [id])
  quotation            Quotation?            @relation(fields: [quotationId], references: [id])
  salesOrder           SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  salesEmployee        Employee?             @relation("SalesInvoiceSalesEmployee", fields: [salesEmployeeId], references: [id])
  commissionCustomerCategory CustomerCategory? @relation("SalesInvoiceCommissionCategory", fields: [commissionCustomerCategoryId], references: [id])
  commissionRate       CustomerCommissionRate? @relation("SalesInvoiceCommissionRate", fields: [commissionRateId], references: [id])
  salesReturns         SalesReturn[]
  payments             SalesPayment[]
  invoiceExchangeItems InvoiceExchangeItem[]
  collectionFollowUps  InvoiceCollectionFollowUp[]
  salesLateFees        SalesLateFee[]
  taxInvoices          TaxInvoice[]

  @@index([customerId], map: "sales_invoices_customer_id_fkey")
  @@index([salesEmployeeId])
  @@index([quotationId], map: "sales_invoices_quotation_id_fkey")
  @@index([salesOrderId], map: "sales_invoices_sales_order_id_fkey")
  @@index([status], map: "idx_sales_invoices_status")
  @@index([dueDate], map: "idx_sales_invoices_due_date")
  @@index([customerVehicleId])
  @@index([projectId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([paymentStatus])
  @@index([deletedAt, paymentStatus, dueDate])
  @@map("sales_invoices")
}

/// Tukar faktur = penyerahan faktur penjualan ke pelanggan dan penerimaan tanda
/// terima resmi sebagai dasar jatuh tempo + pemantauan pelunasan.
///
/// **Tanpa jurnal.** Ini dokumen operasional penagihan, bukan transaksi GL —
/// piutang sudah tercatat oleh fakturnya sendiri, jadi membuat jurnal di sini akan
/// menggandakan piutang.
model InvoiceExchange {
  slug          String?               @unique
  id            Int                   @id @default(autoincrement())
  documentNo    String                @unique @map("document_no")
  date          DateTime
  customerId    Int                   @map("customer_id")
  /**
   * Nomor tanda terima dari pelanggan.
   */
  receiptNumber String?               @map("receipt_number")
  dueDate       DateTime?             @map("due_date")
  notes         String?               @db.Text
  createdBy     Int?                  @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")
  customer      Customer              @relation(fields: [customerId], references: [id])
  items         InvoiceExchangeItem[]

  @@index([customerId])
  @@index([date])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("invoice_exchanges")
}

model InvoiceExchangeItem {
  id             Int             @id @default(autoincrement())
  exchangeId     Int             @map("exchange_id")
  salesInvoiceId Int             @map("sales_invoice_id")
  /**
   * Nilai faktur saat diserahkan (grandTotal) — dasar penagihan.
   */
  amount         Decimal         @db.Decimal(15, 2)
  exchange       InvoiceExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  salesInvoice   SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])

  @@index([exchangeId])
  @@index([salesInvoiceId])
  @@map("invoice_exchange_items")
}

/// Jejak tindak lanjut penagihan per faktur (F-2026-10-22-089-S tahap 2,
/// PUTUSAN BOT 1 Q-COL-1/2 + fisik Q-COL-5 BOT 3). Append-only: koreksi =
/// catatan baru; hapus hanya soft-delete berizin + ActivityLog (BR-COL-06).
/// Channel/outcome = teks tervalidasi kosakata Q-COL-2 di aksi (pola repo
/// string tervalidasi, bukan enum Prisma). Tanpa slug: jejak sub-dokumen
/// pola InvoiceExchangeItem. TANPA jurnal, tanpa ubah paidAmount/status
/// faktur (BR-COL-07). Nominal janji informatif saja (BR-COL-09).
model InvoiceCollectionFollowUp {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  followedUpAt   DateTime     @map("followed_up_at")
  channel        String
  outcome        String
  promisedDate   DateTime?    @map("promised_date")
  promisedAmount Decimal?     @map("promised_amount") @db.Decimal(15, 2)
  notes          String?      @db.Text
  createdBy      Int?         @map("created_by")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])

  @@index([salesInvoiceId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("invoice_collection_followups")
}

model SalesInvoiceItem {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  itemId         Int?         @map("item_id")
  description    String?
  qty            Decimal      @default(1.00) @db.Decimal(15, 2)
  uom            String?
  serialNumbers  Json?        @map("serial_numbers")
  unitPrice      Decimal      @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  discount       Decimal      @default(0.00) @db.Decimal(15, 2)
  total          Decimal      @default(0.00) @db.Decimal(15, 2)
  // F-2026-10-21-018 BR-TIER-09: sumber harga satuan saat baris dibuat
  // (price_list_tier | price_list_base | item_master). Null = baris lama /
  // konversi / edit — BUKAN klaim historis, jangan ditampilkan sebagai sumber.
  priceSource    String?      @map("price_source")
  priceListId    Int?         @map("price_list_id")
  priceListMinQty Decimal?    @map("price_list_min_qty") @db.Decimal(15, 2)
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId], map: "sales_invoice_items_sales_invoice_id_fkey")
  @@index([itemId])
  @@map("sales_invoice_items")
}

/// Syarat denda keterlambatan kontraktual per pelanggan, bertanggal efektif
/// (F-2026-10-22-093-V P2a, vonis BOT 4 PR #563). Master ini MEKANISME tarif
/// — nilai tarif = keputusan komersial pemilik proses (backlog §4, BUKAN
/// diputus vonis/kode). Tepat satu basis wajib terisi: ratePercentPerDay
/// (%/hari dari sisa piutang) XOR flatAmountPerDay (nominal/hari);
/// capAmount = plafon opsional. Syarat sah untuk faktur: effectiveFrom
/// SEBELUM due acuan faktur DAN (effectiveTo null ATAU >= due acuan).
model CustomerLateFeeTerm {
  id                Int            @id @default(autoincrement())
  customerId        Int            @map("customer_id")
  ratePercentPerDay Decimal?       @map("rate_percent_per_day") @db.Decimal(9, 6)
  flatAmountPerDay  Decimal?       @map("flat_amount_per_day") @db.Decimal(15, 2)
  capAmount         Decimal?       @map("cap_amount") @db.Decimal(15, 2)
  effectiveFrom     DateTime       @map("effective_from")
  effectiveTo       DateTime?      @map("effective_to")
  notes             String?        @db.Text
  createdBy         Int?           @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  customer          Customer       @relation(fields: [customerId], references: [id])
  salesLateFees     SalesLateFee[]

  @@index([customerId, effectiveFrom])
  @@map("customer_late_fee_terms")
}

/// Dokumen tagih denda keterlambatan TERPISAH (F-2026-10-22-093-V P1/P3).
/// TIDAK PERNAH mengubah grandTotal/paidAmount/taxAmount faktur asal.
/// Snapshot tarif+basis+hari dibekukan saat terbit; jurnal akrual
/// D Piutang Usaha / K Pendapatan Denda lewat hook. Status string
/// tervalidasi di builder (draft|posted|partial|paid|reversed pola repo).
/// Edit nominal posted DILARANG — koreksi/waiver hanya reversal dokumen
/// (reversesId menunjuk dokumen asal, P6). idempotencyKey unik per terbit.
/// Tanpa PPN, tanpa faktur pajak baru (P4).
model SalesLateFee {
  id                Int                   @id @default(autoincrement())
  documentNo        String                @unique @map("document_no")
  salesInvoiceId    Int                   @map("sales_invoice_id")
  customerId        Int                   @map("customer_id")
  termId            Int                   @map("term_id")
  date              DateTime
  dueReferenceDate  DateTime              @map("due_reference_date")
  overdueDays       Int                   @map("overdue_days")
  basisAmount       Decimal               @map("basis_amount") @db.Decimal(15, 2)
  ratePercentPerDay Decimal?              @map("rate_percent_per_day") @db.Decimal(9, 6)
  flatAmountPerDay  Decimal?              @map("flat_amount_per_day") @db.Decimal(15, 2)
  capAmount         Decimal?              @map("cap_amount") @db.Decimal(15, 2)
  amount            Decimal               @db.Decimal(15, 2)
  paidAmount        Decimal               @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  status            String                @default("posted")
  idempotencyKey    String                @unique @map("idempotency_key")
  reversesId        Int?                  @unique @map("reverses_id")
  journalId         Int?                  @map("journal_id")
  notes             String?               @db.Text
  createdBy         Int?                  @map("created_by")
  deletedAt         DateTime?             @map("deleted_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  salesInvoice      SalesInvoice          @relation(fields: [salesInvoiceId], references: [id])
  customer          Customer              @relation(fields: [customerId], references: [id])
  term              CustomerLateFeeTerm   @relation(fields: [termId], references: [id])
  reverses          SalesLateFee?         @relation("SalesLateFeeReversal", fields: [reversesId], references: [id])
  reversedBy        SalesLateFee?         @relation("SalesLateFeeReversal")
  payments          SalesLateFeePayment[]

  @@index([salesInvoiceId])
  @@index([customerId, status])
  @@index([deletedAt])
  @@map("sales_late_fees")
}

/// Alokasi pembayaran ke dokumen denda (P3/E93-7): mengurangi saldo dokumen
/// denda SAJA, tidak pernah sisa faktur asal. Jurnal kas lewat hook
/// pembayaran denda (D Kas / K Piutang).
model SalesLateFeePayment {
  id             Int          @id @default(autoincrement())
  documentNo     String       @unique @map("document_no")
  salesLateFeeId Int          @map("sales_late_fee_id")
  amount         Decimal      @db.Decimal(15, 2)
  paymentDate    DateTime     @map("payment_date")
  paymentMethod  String       @map("payment_method")
  accountId      Int?         @map("account_id")
  referenceNo    String?      @map("reference_no")
  notes          String?      @db.Text
  createdBy      Int?         @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  salesLateFee   SalesLateFee @relation(fields: [salesLateFeeId], references: [id])

  @@index([salesLateFeeId])
  @@map("sales_late_fee_payments")
}

model SalesPayment {
  slug                     String?             @unique
  id                       Int                 @id @default(autoincrement())
  documentNo               String              @unique @map("document_no")
  customerId               Int?                @map("customer_id")
  salesInvoiceId           Int                 @map("sales_invoice_id")
  /**
   * Kas yang benar-benar diterima — BUKAN termasuk PPh yang dipotong pelanggan.
   */
  amount                   Decimal             @db.Decimal(15, 2)
  // PPh yang dipotong pelanggan saat membayar (mis. PPh 23). Disimpan di
  // pembayaran, bukan di faktur, karena bukti potong baru ada saat pelanggan
  // membayar — dan yang dipotong bukan bagian dari kas yang diterima.
  // Pelunasan piutang dihitung dari `amount + withholdingAmount`, dan jurnalnya
  // Dr Kas (amount) + Dr PPh dibayar dimuka (withholdingAmount) / Cr Piutang.
  withholdingTypeId        Int?                @map("withholding_type_id")
  withholdingAmount        Decimal             @default(0.00) @map("withholding_amount") @db.Decimal(15, 2)
  withholdingCertificateNo String?             @map("withholding_certificate_no")
  withholdingDate          DateTime?           @map("withholding_date")
  paymentDate              DateTime            @map("payment_date")
  paymentMethod            String              @map("payment_method")
  // FIN-BR-008: reversal berhistori — baris asal TIDAK dihapus. posted |
  // reversed; reversal lewat reverseSalesPayment (jurnal lawan, bukan hapus).
  status                   String              @default("posted")
  reversedAt               DateTime?           @map("reversed_at")
  reversedBy               Int?                @map("reversed_by")
  reversalReason           String?             @map("reversal_reason") @db.Text
  accountId                Int?                @map("account_id")
  referenceNo              String?             @map("reference_no")
  notes                    String?             @db.Text
  createdBy                Int?                @map("created_by")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  salesInvoice             SalesInvoice        @relation(fields: [salesInvoiceId], references: [id])
  withholdingType          WithholdingTaxType? @relation(fields: [withholdingTypeId], references: [id], onDelete: SetNull)
  withholdingCertificates  WithholdingCertificate[]

  @@index([salesInvoiceId], map: "sales_payments_sales_invoice_id_fkey")
  @@index([status])
  @@index([customerId])
  @@index([accountId])
  @@index([withholdingTypeId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("sales_payments")
}

model SalesReturn {
  slug           String?           @unique
  id             Int               @id @default(autoincrement())
  documentNo     String            @unique @map("document_no")
  salesInvoiceId Int?              @map("sales_invoice_id")
  customerId     Int               @map("customer_id")
  date           DateTime
  reason         String?           @db.Text
  status         String            @default("draft")
  /**
   * Nomor nota retur Coretax — dicatat apa adanya; sistem tidak
   * menerbitkan nomor pajak sendiri (F-004).
   */
  taxReturnNoteNumber String?       @map("tax_return_note_number")
  taxReturnNoteDate   DateTime?     @map("tax_return_note_date")
  /**
   * Tautan TaxInvoice asal (nullable: retur komersial murni tanpa
   * faktur pajak; PPN-retur = 0).
   */
  sourceTaxInvoiceId  Int?          @map("source_tax_invoice_id")
  createdBy      Int?              @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
