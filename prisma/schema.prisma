/// Tukar faktur = penyerahan faktur penjualan ke pelanggan dan penerimaan tanda
/// terima resmi sebagai dasar jatuh tempo + pemantauan pelunasan.
///
/// **Tanpa jurnal.** Ini dokumen operasional penagihan, bukan transaksi GL —
/// piutang sudah tercatat oleh fakturnya sendiri, jadi membuat jurnal di sini akan
/// menggandakan piutang.
model InvoiceExchange {
  slug          String?               @unique
  id            Int                   @id @default(autoincrement())
  documentNo    String                @unique @map("document_no")
  date          DateTime
  customerId    Int                   @map("customer_id")
  /**
   * Nomor tanda terima dari pelanggan.
   */
  receiptNumber String?               @map("receipt_number")
  dueDate       DateTime?             @map("due_date")
  notes         String?               @db.Text
  createdBy     Int?                  @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")
  customer      Customer              @relation(fields: [customerId], references: [id])
  items         InvoiceExchangeItem[]

  @@index([customerId])
  @@index([date])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("invoice_exchanges")
}

model InvoiceExchangeItem {
  id             Int             @id @default(autoincrement())
  exchangeId     Int             @map("exchange_id")
  salesInvoiceId Int             @map("sales_invoice_id")
  /**
   * Nilai faktur saat diserahkan (grandTotal) — dasar penagihan.
   */
  amount         Decimal         @db.Decimal(15, 2)
  exchange       InvoiceExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  salesInvoice   SalesInvoice    @relation(fields: [salesInvoiceId], references: [id])

  @@index([exchangeId])
  @@index([salesInvoiceId])
  @@map("invoice_exchange_items")
}

model SalesInvoiceItem {
