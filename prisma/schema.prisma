model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int            @map("purchase_return_id")
  itemId           Int            @map("item_id")
  qty              Decimal        @db.Decimal(15, 2)
  cost             Decimal        @default(0.00) @db.Decimal(15, 2)
  /**
   * Snapshot pajak saat returned (F-004). `cost` DILARANG jadi DPP —
   * DPP = qty × `price` beku baris (harga beli dari tagihan asal, dibekukan
   * saat retur dibuat). Baris tanpa `price` = legacy tanpa snapshot
   * (returnDpp/Vat null, fallback hitung-ulang berlabel di read-model).
   */
  price            Decimal?       @db.Decimal(15, 2)
  returnDpp        Decimal?       @map("return_dpp") @db.Decimal(15, 2)
  returnVat        Decimal?       @map("return_vat") @db.Decimal(15, 2)
  sourceTaxRate    Decimal?       @map("source_tax_rate") @db.Decimal(5, 2)
  sourceTaxInvoiceId Int?         @map("source_tax_invoice_id")
  serialNumbers    Json?          @map("serial_numbers")
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId], map: "purchase_return_items_purchase_return_id_fkey")
  @@index([itemId])
  @@map("purchase_return_items")
}

model VendorBill {
  slug                String?                   @unique
  id                  Int                       @id @default(autoincrement())
  goodsReceiptId      Int?                      @map("goods_receipt_id")
  vendorInvoiceNumber String?                   @map("vendor_invoice_number")
  // Nomor faktur pajak masukan dari pemasok (e-Faktur/Coretax), terpisah dari
  // vendorInvoiceNumber (nomor faktur komersial pemasok). Opsional.
  taxInvoiceNumber    String?                   @map("tax_invoice_number")
  discountAmount      Decimal                   @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  balanceDue          Decimal                   @default(0.00) @map("balance_due") @db.Decimal(15, 2)
  terms               String?                   @map("terms") @db.Text
  costCenterId        Int?                      @map("cost_center_id")
  withholdingTypeId   Int?                      @map("withholding_type_id")
  withholdingAmount   Decimal                   @default(0.00) @map("withholding_amount") @db.Decimal(15, 2)
  approvedBy          Int?                      @map("approved_by")
  approvedAt          DateTime?                 @map("approved_at")
  deletedAt           DateTime?                 @map("deleted_at")
  notes               String?                   @db.Text
  documentNo          String                    @unique @map("document_no")
  vendorId            Int                       @map("vendor_id")
  purchaseOrderId     Int?                      @map("purchase_order_id")
  date                DateTime
  dueDate             DateTime?                 @map("due_date")
  subtotal            Decimal                   @default(0.00) @db.Decimal(15, 2)
  tax                 Decimal                   @default(0.00) @db.Decimal(15, 2)
  grandTotal          Decimal                   @default(0.00) @map("grand_total") @db.Decimal(15, 2)
  paidAmount          Decimal                   @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  status              String                    @default("draft")
  createdBy           Int?                      @map("created_by")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  // Jasa maklon per proyek (coating/bending): tagihan vendor ikut HPP proyek.
  projectId           Int?                      @map("project_id")
  items               VendorBillItem[]
  purchaseOrder       PurchaseOrder?            @relation(fields: [purchaseOrderId], references: [id])
  project             Project?                  @relation(fields: [projectId], references: [id])
  goodsReceipt        GoodsReceipt?             @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  vendor              Vendor                    @relation(fields: [vendorId], references: [id])
  withholdingType     WithholdingTaxType?       @relation(fields: [withholdingTypeId], references: [id], onDelete: SetNull)
  allocations         VendorPaymentAllocation[]
  vendorPayments      VendorPayment[]
  taxInvoices         TaxInvoice[]
  withholdingCertificates WithholdingCertificate[]

  @@index([purchaseOrderId], map: "vendor_bills_purchase_order_id_fkey")
  @@index([projectId])
  @@index([vendorId], map: "vendor_bills_vendor_id_fkey")
  @@index([status], map: "idx_vendor_bills_status")
  @@index([dueDate], map: "idx_vendor_bills_due_date")
  @@index([goodsReceiptId])
  @@index([costCenterId])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([createdAt])
  @@index([vendorId, status, balanceDue])
  // F-002: unik (vendorId, nomor) masukan non-batal via guard service
  // (partial unique tak portabel MySQL) + index komposit ini.
  @@index([vendorId, taxInvoiceNumber], map: "idx_vendor_bills_tax_invoice")
  @@map("vendor_bills")
}

