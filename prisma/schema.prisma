model Asset {
  slug               String?         @unique
  id                 Int             @id @default(autoincrement())
  photo              String?         @map("photo")
  serialNumber       String?         @map("serial_number")
  // Unused: no code path reads or writes this column. The asset form field
  // labelled "Deskripsi" is persisted to `notes` (see createAsset/updateAsset),
  // so this column stays NULL forever. Kept only to avoid a destructive
  // migration; drop it in a dedicated migration when convenient.
  description        String?         @map("description") @db.Text
  residualValue      Decimal         @default(0.00) @map("residual_value") @db.Decimal(15, 2)
  depreciationMethod String          @default("straight_line") @map("depreciation_method")
  condition          String          @default("good") @map("condition")
  employeeId         Int?            @map("employee_id")
  assetBrandModelId  Int?            @map("asset_brand_model_id")
  assetBrandId       Int?            @map("asset_brand_id")
  code               String          @unique
  name               String
  categoryId         Int?            @map("category_id")
  groupId            Int?            @map("group_id")
  purchaseDate       DateTime?       @map("purchase_date")
  purchaseCost       Decimal         @default(0.00) @map("purchase_cost") @db.Decimal(15, 2)
  currentValue       Decimal         @default(0.00) @map("current_value") @db.Decimal(15, 2)
  location           String?
  status             String          @default("active")
  notes              String?         @db.Text
  /// Parameter komersial terbekukan per aset (vonis BOT 4 F-2026-10-23-118-V
  /// Putusan 2a): UOP = total estimasi unit seumur aset; SYD = masa manfaat
  /// komersial dalam bulan. NULL = belum dibekukan, mesin wajib menolak
  /// berisik; DILARANG menebak dari kategori fiskal.
  totalEstimatedUnits Decimal?       @map("total_estimated_units") @db.Decimal(15, 2)
  productionUnitName String?         @map("production_unit_name") @db.VarChar(50)
  usefulLifeMonths   Int?            @map("useful_life_months")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  histories          AssetHistory[]
  transfers          AssetTransfer[]
  usageRecords       AssetUsageRecord[]
  fiscalYearRows     AssetFiscalYearRow[]
  changeEvents       AssetChangeEvent[]
  category           AssetCategory?  @relation(fields: [categoryId], references: [id])
  group              AssetGroup?     @relation(fields: [groupId], references: [id])

  @@index([categoryId], map: "assets_category_id_fkey")
  @@index([groupId], map: "assets_group_id_fkey")
  @@index([status], map: "idx_assets_status")
  @@index([employeeId])
  @@index([assetBrandModelId])
  @@index([assetBrandId])
  @@index([createdAt])
  @@map("assets")
}

/// Dokumen unit aktual bernama per (aset, masa) — vonis BOT 4
/// F-2026-10-23-118-V Putusan 2b. Sumber `actualUnits` UOP; tanpa baris
/// untuk masa itu, mesin menolak `missing-parameter:actualUnits`.
/// Unik per (assetId, periodYear, periodMonth) = satu dokumen per masa;
/// koreksi = timpa baris ini (belum ada jurnal) atau reversal jurnal.
model AssetUsageRecord {
  id          Int      @id @default(autoincrement())
  assetId     Int      @map("asset_id")
  periodYear  Int      @map("period_year")
  periodMonth Int      @map("period_month")
  actualUnits Decimal  @map("actual_units") @db.Decimal(15, 2)
  sourceName  String   @map("source_name") @db.VarChar(200)
  sourceRef   String?  @map("source_ref") @db.VarChar(200)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, periodYear, periodMonth], map: "asset_usage_records_asset_period_unique")
  @@index([assetId], map: "asset_usage_records_asset_id_fkey")
  @@index([createdAt])
  @@map("asset_usage_records")
}

/// Baris tahun saldo fiskal terbekukan per aset (vonis BOT 4
/// F-2026-10-23-109-V P4). Snapshot method/groupCode/ratePercent saat
/// baris dibuat; edit master kategori tidak mengubah baris terbit.
/// BUKAN jurnal — tidak memposting GL apa pun. Unik (assetId, taxYear):
/// generate tahunan idempoten, replay = nol baris baru/nol ubah.
model AssetFiscalYearRow {
  id             Int      @id @default(autoincrement())
  assetId        Int      @map("asset_id")
  taxYear        Int      @map("tax_year")
  yearIndex      Int      @map("year_index")
  openingBalance Decimal  @map("opening_balance") @db.Decimal(15, 2)
  depreciation   Decimal  @db.Decimal(15, 2)
  closingBalance Decimal  @map("closing_balance") @db.Decimal(15, 2)
  method         String   @db.VarChar(30)
  groupCode      String   @map("group_code") @db.VarChar(30)
  ratePercent    Decimal  @map("rate_percent") @db.Decimal(5, 2)
  /// computed | opening | estimasi-tahun-berjalan (snapshot builder).
  source         String   @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, taxYear], map: "asset_fiscal_year_rows_asset_year_unique")
  @@index([assetId], map: "asset_fiscal_year_rows_asset_id_fkey")
  @@index([createdAt])
  @@map("asset_fiscal_year_rows")
}

/// Peristiwa perubahan aset terbekukan — inti gabungan vonis BOT 4
/// F-2026-10-23-111-V (revaluasi + impairment) dan F-2026-10-23-115-V
/// (reklasifikasi + perubahan metode/estimasi). SATU model, SATU migrasi,
/// SATU owner schema (BOT 3) supaya dua kartu tidak melahirkan dua tabel
/// peristiwa yang bertabrakan.
///
/// Pembekuan (F-111-V Putusan 4 + F-115-V): nilai sebelum dari jurnal POSTED
/// (bukan `Asset.currentValue`), akun snapshot id+kode per peristiwa,
/// dokumen sumber unik idempoten (`sourceDocumentKey` unik — replay dokumen
/// sama ditolak DB), satu peristiwa satu jurnal POSTED bila berjurnal
/// (`journalId`, null bila peristiwa tanpa jurnal: ganti metode/estimasi).
/// Koreksi HANYA reversal di periode terbuka: `reversesEventId` menunjuk
/// peristiwa asal, peristiwa asal jadi REVERSED lewat jurnal pasangannya;
/// baris peristiwa tidak pernah diedit/dihapus sesudah POSTED.
/// Fiskal hanya bergerak lewat peristiwa berpersetujuan DJP terstruktur
/// (nomor+tanggal): tanpa itu kolom fiskal peristiwa ini wajib kosong dan
/// basis/saldo fiskal byte-sama (E111-3/E115-4).
model AssetChangeEvent {
  id        Int      @id @default(autoincrement())
  assetId   Int      @map("asset_id")
  /// REVALUATION_UP | REVALUATION_DOWN | IMPAIRMENT | IMPAIRMENT_REVERSAL |
  /// FISCAL_REVALUATION_APPROVED (F-111-V) | RECLASSIFICATION |
  /// COMMERCIAL_METHOD_CHANGE | FISCAL_METHOD_CHANGE | ESTIMATE_CHANGE (F-115-V)
  kind      String   @db.VarChar(40)
  /// POSTED | REVERSED
  status    String   @default("POSTED") @db.VarChar(20)
  /// Tanggal efektif bulan peristiwa (awal bulan, pola jurnal penyusutan).
  effectiveDate DateTime @map("effective_date")
  /// Kunci dokumen sumber (laporan penilai / keputusan DJP / berita acara).
  /// Unik = replay dokumen yang sama ditolak fisik (E111-10/E115-8).
  sourceDocumentKey String @unique @map("source_document_key") @db.VarChar(200)
  sourceDocumentRef String? @map("source_document_ref") @db.VarChar(200)
  /// Jurnal pasangan POSTED; null bila peristiwa tanpa jurnal.
  journalId Int?     @map("journal_id")
  /// Peristiwa asal yang dibalik peristiwa ini (reversal), bila ada.
  reversesEventId Int? @unique @map("reverses_event_id")

  /// Nilai tercatat jurnal POSTED sebelum/sesudah (sen persis).
  carryingBefore Decimal? @map("carrying_before") @db.Decimal(15, 2)
  carryingAfter  Decimal? @map("carrying_after") @db.Decimal(15, 2)
  /// Bruto + akumulasi jurnal POSTED sebelum peristiwa (dasar jurnal revaluasi).
  grossBefore          Decimal? @map("gross_before") @db.Decimal(15, 2)
  accumulatedBefore    Decimal? @map("accumulated_before") @db.Decimal(15, 2)
  accumulatedImpairmentBefore Decimal? @map("accumulated_impairment_before") @db.Decimal(15, 2)
  /// Surplus revaluasi per-aset sebelum/sesudah peristiwa (snapshot; tidak
  /// boleh negatif, tidak boleh memakan surplus aset lain — E111-2). Before
  /// dibekukan supaya reversal menulis surplus sesudah = before peristiwa
  /// asal persis (mirror), tanpa menurunkan ulang dari rantai.
  revaluationSurplusBefore Decimal? @map("revaluation_surplus_before") @db.Decimal(15, 2)
  revaluationSurplusAfter Decimal? @map("revaluation_surplus_after") @db.Decimal(15, 2)

  /// Penilai/dasar terstruktur: nama penilai/penelaah + rujukan laporan.
  appraiserName String? @map("appraiser_name") @db.VarChar(200)
  /// Kelas aset yang direvaluasi (F-111-V: per kelas, bukan cherry-pick aset).
  revaluedClassName String? @map("revalued_class_name") @db.VarChar(200)
  /// Indikator impairment terdaftar + dasar terpulihkan terstruktur.
  impairmentIndicator String? @map("impairment_indicator") @db.VarChar(60)
  /// FAIR_VALUE_LESS_COSTS | VALUE_IN_USE
  recoverableBasis String? @map("recoverable_basis") @db.VarChar(40)
  recoverableAmount Decimal? @map("recoverable_amount") @db.Decimal(15, 2)
  /// Plafon pembalikan: nilai tercatat seandainya tanpa impairment (E111-8).
  carryingWithoutImpairment Decimal? @map("carrying_without_impairment") @db.Decimal(15, 2)
  /// Goodwill/tak berwujud tanpa amortisasi: pembalikan DILARANG (PSAK 48).
  isGoodwillOrNonAmortizing Boolean @default(false) @map("is_goodwill_or_non_amortizing")

  /// Reklasifikasi (F-115-V Putusan 1).
  fromCategoryId Int? @map("from_category_id")
  toCategoryId   Int? @map("to_category_id")
  reasonCode     String? @map("reason_code") @db.VarChar(60)
  reasonNote     String? @map("reason_note") @db.Text
  approvedByName String? @map("approved_by_name") @db.VarChar(200)

  /// Perubahan metode/estimasi (F-115-V Putusan 2/3/4) — prospektif, nol jurnal.
  oldMethod String? @map("old_method") @db.VarChar(40)
  newMethod String? @map("new_method") @db.VarChar(40)
  oldUsefulLifeMonths Int? @map("old_useful_life_months")
  newUsefulLifeMonths Int? @map("new_useful_life_months")
  oldResidualValue Decimal? @map("old_residual_value") @db.Decimal(15, 2)
  newResidualValue Decimal? @map("new_residual_value") @db.Decimal(15, 2)

  /// Fiskal berpersetujuan DJP (F-111-V Putusan 2 / F-115-V Putusan 3).
  /// Kosong = fiskal tidak bergerak oleh peristiwa ini.
  djpApprovalNumber String? @map("djp_approval_number") @db.VarChar(100)
  djpApprovalDate   DateTime? @map("djp_approval_date")
  fiscalBaseBefore  Decimal? @map("fiscal_base_before") @db.Decimal(15, 2)
  fiscalBaseAfter   Decimal? @map("fiscal_base_after") @db.Decimal(15, 2)
  fiscalSurplusAmount Decimal? @map("fiscal_surplus_amount") @db.Decimal(15, 2)
  /// Snapshot tarif PPh final master saat peristiwa (E111-4).
  finalTaxRatePercent Decimal? @map("final_tax_rate_percent") @db.Decimal(5, 2)
  finalTaxAmount    Decimal? @map("final_tax_amount") @db.Decimal(15, 2)
  /// Masa manfaat fiskal PENUH kelompok sesudah reset (bulan).
  fiscalUsefulLifeMonthsAfter Int? @map("fiscal_useful_life_months_after")
  fiscalGroupCode   String? @map("fiscal_group_code") @db.VarChar(30)
  fiscalMethodBefore String? @map("fiscal_method_before") @db.VarChar(40)
  fiscalMethodAfter  String? @map("fiscal_method_after") @db.VarChar(40)

  /// Snapshot akun terpakai (id + kode) — pembalikan membaca ini, bukan
  /// mapping kategori berjalan (F-128-V Putusan 3, E128-4).
  surplusAccountId Int? @map("surplus_account_id")
  surplusAccountCode String? @map("surplus_account_code") @db.VarChar(20)
  impairmentLossAccountId Int? @map("impairment_loss_account_id")
  impairmentLossAccountCode String? @map("impairment_loss_account_code") @db.VarChar(20)
  accumulatedImpairmentAccountId Int? @map("accumulated_impairment_account_id")
  accumulatedImpairmentAccountCode String? @map("accumulated_impairment_account_code") @db.VarChar(20)
  fixedAssetAccountId Int? @map("fixed_asset_account_id")
  fixedAssetAccountCode String? @map("fixed_asset_account_code") @db.VarChar(20)
  accumulatedDepreciationAccountId Int? @map("accumulated_depreciation_account_id")
  accumulatedDepreciationAccountCode String? @map("accumulated_depreciation_account_code") @db.VarChar(20)
  taxPayableAccountId Int? @map("tax_payable_account_id")
  taxPayableAccountCode String? @map("tax_payable_account_code") @db.VarChar(20)
  /// Reklasifikasi: akun kelas tujuan (snapshot lawan jurnal pindah).
  toFixedAssetAccountId Int? @map("to_fixed_asset_account_id")
  toFixedAssetAccountCode String? @map("to_fixed_asset_account_code") @db.VarChar(20)
  toAccumulatedDepreciationAccountId Int? @map("to_accumulated_depreciation_account_id")
  toAccumulatedDepreciationAccountCode String? @map("to_accumulated_depreciation_account_code") @db.VarChar(20)
  toAccumulatedImpairmentAccountId Int? @map("to_accumulated_impairment_account_id")
  toAccumulatedImpairmentAccountCode String? @map("to_accumulated_impairment_account_code") @db.VarChar(20)

  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reversesEvent AssetChangeEvent?  @relation("AssetChangeEventReversal", fields: [reversesEventId], references: [id])
  reversedBy    AssetChangeEvent?  @relation("AssetChangeEventReversal")

  @@index([assetId])
  @@index([kind])
  @@index([status])
  @@index([effectiveDate])
  @@index([journalId])
  @@index([createdAt])
  @@map("asset_change_events")
}

model AssetHistory {
  id          Int      @id @default(autoincrement())
  assetId     Int      @map("asset_id")
  type        String
  description String?  @db.Text
  amount      Decimal? @db.Decimal(15, 2)
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "asset_histories_asset_id_fkey")
  @@index([createdAt])
  @@map("asset_histories")
}

model AssetTransfer {
  slug           String?  @unique
  id             Int      @id @default(autoincrement())
  assetId        Int      @map("asset_id")
  fromLocation   String?  @map("from_location")
  toLocation     String   @map("to_location")
  fromEmployeeId Int?     @map("from_employee_id")
  toEmployeeId   Int?     @map("to_employee_id")
  transferDate   DateTime @map("transfer_date")
  notes          String?  @db.Text
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "asset_transfers_asset_id_fkey")
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("asset_transfers")
}

model VehicleBrand {
  slug         String?              @unique
  id           Int                  @id @default(autoincrement())
  name         String
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  products     Product[]
  models       VehicleModel[]
  fitmentRules VehicleFitmentRule[]

  @@index([createdAt])
  @@map("vehicle_brands")
}

model VehicleModel {
  slug           String?              @unique
  id             Int                  @id @default(autoincrement())
  vehicleBrandId Int                  @map("vehicle_brand_id")
  name           String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  products       Product[]
  brand          VehicleBrand         @relation(fields: [vehicleBrandId], references: [id])
  variants       VehicleVariant[]
  fitmentRules   VehicleFitmentRule[]

  @@unique([vehicleBrandId, name], map: "vehicle_models_brand_name_unique")
  @@index([vehicleBrandId], map: "vehicle_models_vehicle_brand_id_fkey")
  @@index([createdAt])
  @@map("vehicle_models")
}

model VehicleVariant {
  id             Int                  @id @default(autoincrement())
  vehicleModelId Int                  @map("vehicle_model_id")
  name           String
  drivetrain     String?              @map("drivetrain")
  transmission   String?              @map("transmission")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  model          VehicleModel         @relation(fields: [vehicleModelId], references: [id])
  vehicles       Vehicle[]
  fitmentRules   VehicleFitmentRule[]

  @@index([vehicleModelId], map: "vehicle_variants_vehicle_model_id_fkey")
  @@index([createdAt])
  @@map("vehicle_variants")
}

model Vehicle {
  slug             String?           @unique
  id               Int               @id @default(autoincrement())
  vehicleVariantId Int               @map("vehicle_variant_id")
  name             String?
  year             Int?
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  customerVehicles CustomerVehicle[]
  variant          VehicleVariant    @relation(fields: [vehicleVariantId], references: [id], onDelete: Restrict)

  @@index([vehicleVariantId], map: "vehicles_vehicle_variant_id_fkey")
  @@index([createdAt])
  @@index([deletedAt])
  @@map("vehicles")
}

model CustomerVehicle {
  id            Int         @id @default(autoincrement())
  customerId    Int         @map("customer_id")
  vehicleId     Int         @map("vehicle_id")
  slug          String?     @unique
  plateNumber   String?     @map("plate_number")
  color         String?     @map("color")
  chassisNumber String?     @map("chassis_number")
  engineNumber  String?     @map("engine_number")
  // F-2026-10-21-021 tahap 1: odometer terakhir tercatat (km), snapshot saat
  // check-in/serah terima WO. Null = belum pernah tercatat; klaim tetap boleh
  // masuk (kasus tepi odometer tak terbaca diputus manual, bukan ditolak).
  lastOdometerKm Int?       @map("last_odometer_km")
  // F-2026-10-25-021-S tahap 1: jadwal servis berikutnya dicatat manual staf
  // berizin (BR-SV-02 satu jadwal aktif; catat ulang menimpa). Tanggal dan/atau
  // km target boleh kosong salah satu (BR-SV-03). Status pengingat TURUNAN
  // baca-saja di builder service-reminder-queue — bukan kolom status.
  nextServiceDate     DateTime? @map("next_service_date") @db.Date
  nextServiceKm       Int?      @map("next_service_km")
  nextServiceNote     String?   @map("next_service_note") @db.Text
  nextServiceUpdatedBy Int?     @map("next_service_updated_by")
  nextServiceUpdatedAt DateTime? @map("next_service_updated_at")
  isActive      Boolean     @default(true) @map("is_active")
  notes         String?     @db.Text
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  customer      Customer    @relation(fields: [customerId], references: [id])
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  projects      Project[]
  quotations    Quotation[]
  workOrders    WorkOrder[]
  warrantyCoverages WarrantyCoverage[]
  warrantyClaims    WarrantyClaim[]
  installedParts    InstalledPart[]

  @@index([customerId], map: "customer_vehicles_customer_id_fkey")
  @@index([vehicleId], map: "customer_vehicles_vehicle_id_fkey")
  @@index([createdAt])
  @@index([deletedAt])
  @@map("customer_vehicles")
}

model Project {
  slug              String?           @unique
  id                Int               @id @default(autoincrement())
  documentNo        String?           @unique @map("document_no")
  name              String
  customerId        Int               @map("customer_id")
  customerVehicleId Int?              @map("customer_vehicle_id")
  workOrderId       Int?              @map("work_order_id")
  status            String            @default("active")
  startDate         DateTime?         @map("start_date")
  endDate           DateTime?         @map("end_date")
  description       String?           @db.Text
  notes             String?           @db.Text
  createdBy         Int?              @map("created_by")
  // F-2026-10-21-030 (RAB): snapshot nilai kontrak. Disalin SEKALI dari
  // Quotation.grandTotal terpilih (atau diisi manual ber-alasan bila tanpa
  // quotation) — BUKAN formula berjalan; perubahan quotation sesudahnya
  // tidak mengubah snapshot ini. Sesudah budgetLockedAt terisi, nilai ini
  // dan baris RAB hanya boleh berubah lewat revisi tercatat di ProjectLog.
  contractAmount    Decimal?          @db.Decimal(15, 2) @map("contract_amount")
  contractQuotationId Int?            @map("contract_quotation_id")
  contractSetAt     DateTime?         @map("contract_set_at")
  contractSetBy     Int?              @map("contract_set_by")
  budgetLockedAt    DateTime?         @map("budget_locked_at")
  budgetLockedBy    Int?              @map("budget_locked_by")
  budgetRevisionNo  Int               @default(0) @map("budget_revision_no")
  contractQuotation Quotation?        @relation("ProjectContractQuotation", fields: [contractQuotationId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  overtimeRequests  OvertimeRequest[]
  items             ProjectItem[]
  logs              ProjectLog[]
  stages            ProjectStage[]
  customer          Customer          @relation(fields: [customerId], references: [id])
  customerVehicle   CustomerVehicle?  @relation(fields: [customerVehicleId], references: [id])
  tasks             Task[]
  timesheets        Timesheet[]
  workOrders        WorkOrder[]
  pettyCash         PettyCash[]
  vendorBills       VendorBill[]
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id])
  costCenterId      Int?              @map("cost_center_id")

  @@index([customerId], map: "projects_customer_id_fkey")
  @@index([contractQuotationId], map: "projects_contract_quotation_id_fkey")
  @@index([contractSetBy])
  @@index([budgetLockedBy])
  @@index([customerVehicleId], map: "projects_customer_vehicle_id_fkey")
  @@index([status], map: "idx_projects_status")
  @@index([workOrderId])
  @@index([costCenterId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("projects")
}

model ProjectItem {
  id             Int           @id @default(autoincrement())
  projectId      Int           @map("project_id")
  itemId         Int?          @map("item_id")
  // F-2026-10-21-030 (RAB): tahap + kategori anggaran baris ini. Nullable
  // demi baris draft/lama; kunci anggaran (BR-02) mewajibkan keduanya.
  // onDelete Restrict: tahap yang dirujuk baris RAB tidak bisa dihapus
  // dan meninggalkan baris yatim (BR-07).
  projectStageId Int?          @map("project_stage_id")
  category       String?
  sortOrder      Int           @default(0) @map("sort_order")
  description    String?
  qty            Decimal       @default(1.00) @db.Decimal(15, 2)
  cost           Decimal       @default(0.00) @db.Decimal(15, 2)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage          ProjectStage? @relation("ProjectStageBudgetItems", fields: [projectStageId], references: [id], onDelete: Restrict)

  @@index([projectId], map: "project_items_project_id_fkey")
  @@index([projectStageId], map: "project_items_project_stage_id_fkey")
  @@index([itemId])
  @@map("project_items")
}

model ProjectStage {
  id          Int                    @id @default(autoincrement())
  projectId   Int                    @map("project_id")
  name        String
  sortOrder   Int                    @default(0) @map("sort_order")
  status      String                 @default("pending")
  startedAt   DateTime?              @map("started_at")
  completedAt DateTime?              @map("completed_at")
  notes       String?                @db.Text
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  progress    ProjectStageProgress[]
  budgetItems ProjectItem[]          @relation("ProjectStageBudgetItems")
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_stages_project_id_fkey")
  @@index([status])
  @@index([createdAt])
  @@map("project_stages")
}

model ProjectStageProgress {
  id             Int          @id @default(autoincrement())
  projectStageId Int          @map("project_stage_id")
  percentage     Int          @default(0)
  notes          String?      @db.Text
  createdBy      Int?         @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  stage          ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)

  @@index([projectStageId], map: "project_stage_progress_project_stage_id_fkey")
  @@index([createdBy])
  @@index([createdAt])
  @@map("project_stage_progress")
}

model ProjectLog {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  action    String
  notes     String?  @db.Text
  // F-2026-10-21-030 (RAB): payload terstruktur nilai lama->baru untuk
  // log rab_* (snapshot kontrak, kunci, revisi) — supaya riwayat revisi
  // bisa direkonstruksi mesin dari baris log saja (acceptance A6).
  details   Json?
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_logs_project_id_fkey")
  @@index([userId])
  @@index([createdAt])
  @@map("project_logs")
}

model ApprovalWorkflow {
  slug        String?                @unique
  id          Int                    @id @default(autoincrement())
  name        String
  code        String?
  modelType   String                 @map("model_type")
  description String?                @db.Text
  priority    Int                    @default(0)
  isActive    Boolean                @default(true) @map("is_active")
  deletedAt   DateTime?              @map("deleted_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  steps       ApprovalWorkflowStep[]
  approvals   Approval[]

  @@index([createdAt])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id           Int              @id @default(autoincrement())
  workflowId   Int              @map("workflow_id")
  name         String?
  stepOrder    Int              @map("step_order")
  roleId       Int?             @map("role_id")
  userId       Int?             @map("user_id")
  approverType String?          @map("approver_type")
  conditions   Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId], map: "approval_workflow_steps_workflow_id_fkey")
  @@index([roleId])
  @@index([userId])
  @@index([createdAt])
