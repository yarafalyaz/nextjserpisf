  serialNumbers  Json?        @map("serial_numbers")
  unitCost       Decimal      @default(0.00) @map("unit_cost") @db.Decimal(15, 2)
  stockMoveId    Int?         @map("stock_move_id")
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId], map: "goods_receipt_items_goods_receipt_id_fkey")
  @@index([itemId])
  @@index([warehouseId])
  @@index([rackId])
  @@index([rackRowId])
  @@index([stockMoveId])
  @@map("goods_receipt_items")
}

