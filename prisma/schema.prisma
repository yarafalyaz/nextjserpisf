// F-2026-10-22-078-S inti (induk F-2026-10-21-014): permintaan barang
// antar gudang. Dokumen pendahulu InventoryTransfer — permintaan TIDAK
// menggerakkan stok, TIDAK membuat StockMove/jurnal/issue (BR-MR-02);
// satu-satunya gerak stok = InventoryTransfer tertaut lewat kolom
// materialRequestId di sisi transfer (Q-MR-4 BOT 3). Status internal
// sederhana pola PurchaseRequest (Q-MR-2); self-approve dilarang
// (Q-MR-3). Tanpa harga/biaya: permintaan bukan dokumen nilai.
model MaterialRequest {
  slug                 String?   @unique
  id                   Int       @id @default(autoincrement())
  documentNo           String    @unique @map("document_no")
  requesterWarehouseId Int       @map("requester_warehouse_id")
  sourceWarehouseId    Int       @map("source_warehouse_id")
  workOrderId          Int?      @map("work_order_id")
  neededBy             DateTime? @map("needed_by")
  status               String    @default("draft")
  rejectionReason      String?   @map("rejection_reason") @db.Text
  approvedBy           Int?      @map("approved_by")
  approvedAt           DateTime? @map("approved_at")
  createdBy            Int?      @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  items              MaterialRequestItem[]
  transfers          InventoryTransfer[]
  requesterWarehouse Warehouse @relation("MaterialRequestRequester", fields: [requesterWarehouseId], references: [id])
  sourceWarehouse    Warehouse @relation("MaterialRequestSource", fields: [sourceWarehouseId], references: [id])
  workOrder          WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([status], map: "idx_material_requests_status")
  @@index([requesterWarehouseId])
  @@index([sourceWarehouseId])
  @@index([workOrderId])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([createdAt])
  @@map("material_requests")
}

model MaterialRequestItem {
  id                Int             @id @default(autoincrement())
  materialRequestId Int             @map("material_request_id")
  itemId            Int             @map("item_id")
  qty               Decimal         @db.Decimal(15, 2)
  notes             String?
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  item              Item            @relation(fields: [itemId], references: [id])

  @@index([materialRequestId], map: "material_request_items_material_request_id_fkey")
  @@index([itemId])
  @@map("material_request_items")
}

model InventoryTransfer {
  slug                   String?                 @unique
  id                     Int                     @id @default(autoincrement())
  documentNo             String                  @unique @map("document_no")
  sourceWarehouseId      Int                     @map("source_warehouse_id")
  destinationWarehouseId Int                     @map("destination_warehouse_id")
  materialRequestId      Int?                    @map("material_request_id")
  date                   DateTime
  notes                  String?                 @db.Text
  status                 String                  @default("draft")
  createdBy              Int?                    @map("created_by")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  items                  InventoryTransferItem[]
  receipts               InventoryTransferReceipt[]
  shortageAdjustments    StockAdjustment[]
  materialRequest        MaterialRequest?        @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  destinationWarehouse   Warehouse               @relation("TransferDest", fields: [destinationWarehouseId], references: [id])
  sourceWarehouse        Warehouse               @relation("TransferSource", fields: [sourceWarehouseId], references: [id])

  @@index([destinationWarehouseId], map: "inventory_transfers_destination_warehouse_id_fkey")
  @@index([sourceWarehouseId], map: "inventory_transfers_source_warehouse_id_fkey")
  @@index([materialRequestId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id                  Int               @id @default(autoincrement())
  inventoryTransferId Int               @map("inventory_transfer_id")
  itemId              Int               @map("item_id")
  qty                 Decimal           @db.Decimal(15, 2)
  // F-2026-10-22-081-S: qty diterima kumulatif per BARIS (pola
  // PurchaseOrderItem.receivedQty, vonis BOT 4 V-5(e)). Server menjaga
  // 0 <= receivedQty <= qty; sisa = qty - receivedQty.
  receivedQty         Decimal           @default(0) @map("received_qty") @db.Decimal(15, 2)
  // FIFO lot/serial attribution captured at process time. A transfer is a MOVE,
  // not a sale: the batch lots and serials consumed from the source warehouse must
  // be re-created/revived in the destination warehouse on receive. Without these
  // the origin lots are decremented and the serials stay "used" forever (unsellable)
  // while the destination shows qty on hand with no lot/serial behind it.
  serialNumbers       Json?             @map("serial_numbers")
  batchAllocations    Json?             @map("batch_allocations")
  inventoryTransfer   InventoryTransfer @relation(fields: [inventoryTransferId], references: [id], onDelete: Cascade)
  receiptItems        InventoryTransferReceiptItem[]

  @@index([inventoryTransferId], map: "inventory_transfer_items_inventory_transfer_id_fkey")
  @@index([itemId])
  @@map("inventory_transfer_items")
}

// F-2026-10-22-081-S (Q-TP-2 BOT 3): SATU baris per KEJADIAN terima.
// Idempotency per kejadian (BR-TP-06): idempotencyKey unik per submit —
// retry submit yang sama menabrak unique, bukan menggandakan StockMove IN.
// receivedDate = tanggal kejadian sendiri (Q-TP-1 BOT 1): assertPeriodOpen
// dinilai per tanggal ini, bukan tanggal kirim transfer.
model InventoryTransferReceipt {
  id                  Int      @id @default(autoincrement())
  inventoryTransferId Int      @map("inventory_transfer_id")
  receivedDate        DateTime @map("received_date")
  receivedBy          Int?     @map("received_by")
  idempotencyKey      String   @unique @map("idempotency_key")
  createdAt           DateTime @default(now()) @map("created_at")
  inventoryTransfer   InventoryTransfer @relation(fields: [inventoryTransferId], references: [id], onDelete: Cascade)
  items               InventoryTransferReceiptItem[]

  @@index([inventoryTransferId])
  @@index([receivedBy])
  @@index([receivedDate])
  @@map("inventory_transfer_receipts")
}

model InventoryTransferReceiptItem {
  id                      Int     @id @default(autoincrement())
  receiptId               Int     @map("receipt_id")
  inventoryTransferItemId Int     @map("inventory_transfer_item_id")
  qty                     Decimal @db.Decimal(15, 2)
  serialNumbers           Json?   @map("serial_numbers")
  batchAllocations        Json?   @map("batch_allocations")
  receipt                 InventoryTransferReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  transferItem            InventoryTransferItem @relation(fields: [inventoryTransferItemId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([inventoryTransferItemId])
  @@map("inventory_transfer_receipt_items")
}

