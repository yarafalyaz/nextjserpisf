/// Uang muka pembelian (down payment ke vendor). Murni sisi akuntansi: menambah
/// saldo Uang Muka (aset) dan mengurangi kas/bank lewat satu jurnal.
///
/// **Penerapan ke tagihan vendor belum diotomatiskan** — dokumen ini mencatat
/// uang muka yang dibayarkan, bukan saldo yang belum terpakai; laporan yang
/// mengaku "sisa uang muka" tidak boleh dibuat dari tabel ini.
model PurchaseAdvance {
  slug             String?   @unique
  id               Int       @id @default(autoincrement())
  documentNo       String    @unique @map("document_no")
  date             DateTime
  vendorId         Int       @map("vendor_id")
  amount           Decimal   @db.Decimal(15, 2)
  paymentAccountId Int       @map("payment_account_id")
  advanceAccountId Int       @map("advance_account_id")
  description      String?   @db.Text
  status           String    @default("posted")
  journalId        Int?      @map("journal_id")
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  vendor           Vendor    @relation(fields: [vendorId], references: [id])

  @@index([vendorId], map: "purchase_advances_vendor_id_fkey")
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("purchase_advances")
}

/// Daftar harga pemasok per barang (Accurate: "Harga Pemasok").
///
/// **Murni rujukan** — dokumen pembelian (pesanan/penerimaan/tagihan) belum
/// mengambil harga dari sini; ini catatan harga hasil kesepakatan, bukan harga
/// yang otomatis mengikat transaksi.
model VendorItemPrice {
  id            Int       @id @default(autoincrement())
  vendorId      Int       @map("vendor_id")
  itemId        Int       @map("item_id")
  price         Decimal   @db.Decimal(15, 2)
  minQty        Decimal   @default(1.00) @map("min_qty") @db.Decimal(15, 2)
  effectiveDate DateTime? @map("effective_date")
  notes         String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([vendorId, itemId, minQty], map: "uq_vendor_item_price")
  @@index([vendorId], map: "vendor_item_prices_vendor_id_fkey")
  @@index([itemId], map: "vendor_item_prices_item_id_fkey")
  @@index([createdAt])
  @@map("vendor_item_prices")
}

model CustomerPriceList {
