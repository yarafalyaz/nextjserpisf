// F-2026-10-21-021 tahap 1 — cakupan garansi pasang. Lahir otomatis saat
// WorkOrder completed untuk baris terpasang (MaterialIssue completed) yang
// item-nya punya warrantyMonths. TANPA jurnal/provisi (tahap 3 menunggu
// vonis accountant). Status: active | expired | revoked. Kadaluarsa dibaca
// dari expiresAt; kolom status hanya berubah lewat pencabutan manual.
model WarrantyCoverage {
  id                Int             @id @default(autoincrement())
  customerVehicleId Int             @map("customer_vehicle_id")
  workOrderId       Int             @map("work_order_id")
  itemId            Int             @map("item_id")
  serialNumber      String?         @map("serial_number")
  // Jangkar unik DB (F-021-HARDEN-UNIQUE): MySQL tidak menganggap NULL unik,
  // jadi unique langsung di serialNumber gagal menahan coverage ganda tanpa
  // serial. serialKey = serialNumber ?? "" ditulis service saat create;
  // unique (workOrderId, itemId, serialKey) menahan duplikat serial maupun
  // non-serial. Nilai "" bukan serial asli — jangan tampilkan ke pengguna.
  serialKey         String          @default("") @map("serial_key")
  installedAt       DateTime        @map("installed_at")
  expiresAt         DateTime        @map("expires_at")
  warrantyMonths    Int             @map("warranty_months")
  mileageLimitKm    Int?            @map("mileage_limit_km")
  termsSnapshot     String          @db.Text @map("terms_snapshot")
  status            String          @default("active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customerVehicle   CustomerVehicle @relation(fields: [customerVehicleId], references: [id])
  workOrder         WorkOrder       @relation("WorkOrderWarrantyCoverages", fields: [workOrderId], references: [id])
  item              Item            @relation(fields: [itemId], references: [id])
  claims            WarrantyClaim[]
  installedParts    InstalledPart[]

  @@unique([workOrderId, itemId, serialKey], map: "warranty_coverages_wo_item_serial_key_key")
  @@index([customerVehicleId])
  @@index([workOrderId])
  @@index([itemId])
  @@index([status])
  @@index([expiresAt])
  @@map("warranty_coverages")
}

// F-2026-10-22-072-S (inti F-2026-10-21-024) — registri part terpasang per
// kendaraan. Lahir OTOMATIS (satu-satunya jalan masuk; form bebas dilarang,
// BR-IP-01) dari baris MaterialIssue completed: di tx completeWorkOrder
// untuk MI taut WO, dan di tx completeMaterialIssue untuk MI taut proyek
// tanpa WO bila Project.customerVehicleId terisi (putusan BOT 1 Q-IP-1).
// MI bebas tidak pernah ditebak kendaraannya (BR-IP-07: tanpa kendaraan =
// tidak lahir + terhitung skipped, dokumen sumber tetap selesai).
//
// Q-IP-3 (fisik BOT 3): serial-tracked = 1 baris per unit, qty selalu 1,
// dari MaterialIssueItem.serialNumbers ter-konsumsi; non-serial = 1 baris
// per baris issue dengan qty = MaterialIssueItem.qty. serialKey =
// serialNumber ?? "" (pola WarrantyCoverage F-021-HARDEN: MySQL tidak
// menganggap NULL unik) ikut @@unique(materialIssueItemId, serialKey)
// menahan duplikat retry complete (BR-IP-04); pelanggar kedua = P2002
// ditelan service sebagai "sudah ada". Nilai "" bukan serial asli.
//
// Status TIDAK disimpan: diturunkan dari qtyRemoved — TERPASANG (0),
// SEBAGIAN_DILEPAS (0 < qtyRemoved < qty), DILEPAS (qtyRemoved = qty)
// (BR-IP-05). removedAt/removedById/removalReason merekam kejadian lepas
// TERAKHIR (removedAt hanya terisi saat DILEPAS penuh). Catat lepas TIDAK
// membuat StockMove/jurnal/retur (BR-IP-06) — pengembalian fisik part =
// dokumen inventory existing. warrantyCoverageId menaut coverage garansi
// baris yang sama bila lahir (BR-IP-08: klaim tetap lewat coverage).
// Q-IP-4: tanpa backfill historis. Q-IP-5: baris tidak pernah dihapus;
// penanda batal sumber diturunkan pembaca dari status dokumen sumber.
model InstalledPart {
  id                        Int       @id @default(autoincrement())
  customerVehicleId         Int       @map("customer_vehicle_id")
  itemId                    Int       @map("item_id")
  materialIssueItemId       Int       @map("material_issue_item_id")
  serialNumber              String?   @map("serial_number")
  serialKey                 String    @default("") @map("serial_key")
  qty                       Decimal   @db.Decimal(15, 2)
  qtyRemoved                Decimal   @default(0.00) @map("qty_removed") @db.Decimal(15, 2)
  installedAt               DateTime  @map("installed_at")
  warrantyCoverageId        Int?      @map("warranty_coverage_id")
  removedAt                 DateTime? @map("removed_at")
  removedById               Int?      @map("removed_by")
  removalReason             String?   @map("removal_reason") @db.Text
  replacedByInstalledPartId Int?      @map("replaced_by_installed_part_id")
  notes                     String?   @db.Text
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  customerVehicle   CustomerVehicle   @relation(fields: [customerVehicleId], references: [id])
  item              Item              @relation(fields: [itemId], references: [id])
  materialIssueItem MaterialIssueItem @relation(fields: [materialIssueItemId], references: [id], onDelete: Cascade)
  warrantyCoverage  WarrantyCoverage? @relation(fields: [warrantyCoverageId], references: [id], onDelete: SetNull)
  replacedBy        InstalledPart?    @relation("InstalledPartReplacement", fields: [replacedByInstalledPartId], references: [id], onDelete: SetNull)
  replacements      InstalledPart[]   @relation("InstalledPartReplacement")

  @@unique([materialIssueItemId, serialKey], map: "installed_parts_issue_item_serial_key_key")
  @@index([customerVehicleId])
  @@index([itemId])
  @@index([warrantyCoverageId])
  @@index([replacedByInstalledPartId])
  @@map("installed_parts")
}

// F-2026-10-21-021 tahap 2 — klaim garansi. State machine:
// intake -> eligibility -> approved|rejected -> in_repair -> closed.
// Keputusan SELALU manual (decisionBy/decisionAt wajib saat approved/
// rejected): sistem TIDAK PERNAH auto-reject klaim di luar masa — fakta
// eligibility hanya ditampilkan untuk penilai. Foto bukti memakai
// TransactionAttachment existing (referenceType = "WarrantyClaim"),
// bukan tabel lampiran baru. TANPA jurnal/provisi.
model WarrantyClaim {
  id                    Int              @id @default(autoincrement())
  coverageId            Int              @map("coverage_id")
  customerVehicleId     Int              @map("customer_vehicle_id")
  reportedAt            DateTime         @map("reported_at")
  odometerKm            Int?             @map("odometer_km")
  complaint             String           @db.Text
  status                String           @default("intake")
  decisionBy            Int?             @map("decision_by")
  decisionAt            DateTime?        @map("decision_at")
  decisionNotes         String?          @db.Text @map("decision_notes")
  resolutionType        String?          @map("resolution_type")
  repairWorkOrderId     Int?             @map("repair_work_order_id")
  // F-2026-10-21-022 — tautan klaim supplier atas part cacat. TAUTAN SAJA,
  // TANPA jurnal recovery/piutang klaim supplier (vonis accounting tahap 3).
  // supplierClaimStatus TERPISAH dari status klaim pelanggan: klaim pelanggan
  // bisa closed sementara recovery supplier masih berjalan. Nilai enum teks
  // divalidasi service (WARRANTY_SUPPLIER_CLAIM_STATUSES), default "none".
  supplierClaimVendorId Int?             @map("supplier_claim_vendor_id")
  purchaseReturnId      Int?             @map("purchase_return_id")
  supplierClaimStatus   String           @default("none") @map("supplier_claim_status")
  supplierClaimRefNo    String?          @map("supplier_claim_ref_no")
  supplierClaimNotes    String?          @db.Text @map("supplier_claim_notes")
  supplierClaimBy       Int?             @map("supplier_claim_by")
  supplierClaimAt       DateTime?        @map("supplier_claim_at")
  createdBy             Int?             @map("created_by")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  coverage              WarrantyCoverage @relation(fields: [coverageId], references: [id])
  customerVehicle       CustomerVehicle  @relation(fields: [customerVehicleId], references: [id])
  repairWorkOrder       WorkOrder?       @relation("WarrantyClaimRepairWorkOrder", fields: [repairWorkOrderId], references: [id], onDelete: SetNull)
  supplierClaimVendor   Vendor?          @relation("WarrantyClaimSupplierVendor", fields: [supplierClaimVendorId], references: [id], onDelete: SetNull)
  purchaseReturn        PurchaseReturn?  @relation("WarrantyClaimPurchaseReturn", fields: [purchaseReturnId], references: [id], onDelete: SetNull)

  @@index([coverageId])
  @@index([customerVehicleId])
  @@index([status])
  @@index([repairWorkOrderId])
  @@index([supplierClaimVendorId])
  @@index([purchaseReturnId])
  @@index([createdAt])
  @@map("warranty_claims")
}

