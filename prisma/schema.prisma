  qty            Decimal      @default(1.00) @db.Decimal(15, 2)
  uom            String?
  serialNumbers  Json?        @map("serial_numbers")
  unitPrice      Decimal      @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  discount       Decimal      @default(0.00) @db.Decimal(15, 2)
  total          Decimal      @default(0.00) @db.Decimal(15, 2)
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([salesInvoiceId], map: "sales_invoice_items_sales_invoice_id_fkey")
  @@index([itemId])
  @@map("sales_invoice_items")
}

model SalesPayment {
  slug                     String?             @unique
  id                       Int                 @id @default(autoincrement())
  documentNo               String              @unique @map("document_no")
  customerId               Int?                @map("customer_id")
  salesInvoiceId           Int                 @map("sales_invoice_id")
  /**
   * Kas yang benar-benar diterima — BUKAN termasuk PPh yang dipotong pelanggan.
   */
  amount                   Decimal             @db.Decimal(15, 2)
  // PPh yang dipotong pelanggan saat membayar (mis. PPh 23). Disimpan di
  // pembayaran, bukan di faktur, karena bukti potong baru ada saat pelanggan
  // membayar — dan yang dipotong bukan bagian dari kas yang diterima.
  // Pelunasan piutang dihitung dari `amount + withholdingAmount`, dan jurnalnya
  // Dr Kas (amount) + Dr PPh dibayar dimuka (withholdingAmount) / Cr Piutang.
  withholdingTypeId        Int?                @map("withholding_type_id")
  withholdingAmount        Decimal             @default(0.00) @map("withholding_amount") @db.Decimal(15, 2)
  withholdingCertificateNo String?             @map("withholding_certificate_no")
  withholdingDate          DateTime?           @map("withholding_date")
  paymentDate              DateTime            @map("payment_date")
  paymentMethod            String              @map("payment_method")
  accountId                Int?                @map("account_id")
  referenceNo              String?             @map("reference_no")
  notes                    String?             @db.Text
  createdBy                Int?                @map("created_by")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  salesInvoice             SalesInvoice        @relation(fields: [salesInvoiceId], references: [id])
  withholdingType          WithholdingTaxType? @relation(fields: [withholdingTypeId], references: [id], onDelete: SetNull)

  @@index([salesInvoiceId], map: "sales_payments_sales_invoice_id_fkey")
  @@index([customerId])
  @@index([accountId])
  @@index([withholdingTypeId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("sales_payments")
}

