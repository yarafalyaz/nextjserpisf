model Approval {
  slug            String?           @unique
  id              Int               @id @default(autoincrement())
  workflowId      Int               @map("workflow_id")
  referenceType   String            @map("reference_type")
  referenceId     Int               @map("reference_id")
  currentStep     Int               @default(1) @map("current_step")
  status          String            @default("pending")
  requestedBy     Int?              @map("requested_by")
  requestedAt     DateTime?         @map("requested_at")
  finalApprovedBy Int?              @map("final_approved_by")
  completedAt     DateTime?         @map("completed_at")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  histories       ApprovalHistory[]
  workflow        ApprovalWorkflow  @relation(fields: [workflowId], references: [id])

  @@index([workflowId], map: "approvals_workflow_id_fkey")
  @@index([referenceType, referenceId])
  @@index([status])
  @@index([requestedBy])
  @@index([finalApprovedBy])
  @@index([createdAt])
  @@map("approvals")
}

model ApprovalHistory {
  id         Int      @id @default(autoincrement())
  approvalId Int      @map("approval_id")
  step       Int
  action     String
  userId     Int?     @map("user_id")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId], map: "approval_histories_approval_id_fkey")
  @@index([userId])
  @@index([createdAt])
  @@map("approval_histories")
}

