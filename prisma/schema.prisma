model GoodsReceipt {
  slug            String?            @unique
  id              Int                @id @default(autoincrement())
  documentNo      String             @unique @map("document_no")
  purchaseOrderId Int                @map("purchase_order_id")
  warehouseId     Int                @map("warehouse_id")
  date            DateTime
  referenceNumber String?            @map("reference_number")
  notes           String?            @db.Text
  // Actual landed costs for THIS receipt. When > 0 they override the PO's
  // shippingCost/serviceFee estimate for the allocation; when 0 the hook
  // derives this receipt's proportional share of the PO estimate instead.
  shippingCost    Decimal            @default(0.00) @map("shipping_cost") @db.Decimal(15, 2)
  otherCost       Decimal            @default(0.00) @map("other_cost") @db.Decimal(15, 2)
  // Bank / payment admin fee for THIS receipt (e.g. "Admin BCA 1.000" printed on
  // a Tokopedia/Shopee purchase). Capitalised into HPP like shippingCost, but
  // posted to its own expense account so the journal shows the breakdown.
  adminFee        Decimal            @default(0.00) @map("admin_fee") @db.Decimal(15, 2)
  status          String             @default("draft")
  createdBy       Int?               @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  items           GoodsReceiptItem[]
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  vendorBills     VendorBill[]

  @@index([purchaseOrderId], map: "goods_receipts_purchase_order_id_fkey")
  @@index([warehouseId], map: "goods_receipts_warehouse_id_fkey")
  @@index([status], map: "idx_goods_receipts_status")
  @@index([createdBy])
  @@index([createdAt])
  @@map("goods_receipts")
}

