// F-2026-10-22-066-S inti (induk F-2026-10-20-103; putusan BOT 1 §5A +
// vonis BOT 4 F-2026-10-22-066-V): dokumen persetujuan pelanggan untuk
// perubahan tengah-job pada WorkOrder yang tertaut Quotation. Sumber
// nilai kontrak TUNGGAL tetap Quotation.grandTotal (BR-CO-01): dokumen
// ini TIDAK membuat jurnal/piutang/payment dan TIDAK menyimpan nilai
// kontrak kedua — selisihNilai hanya snapshot informasi persetujuan
// saat kirim (sen Decimal). Status ditegakkan server:
// draft -> menunggu_pelanggan -> disetujui -> diterapkan; cabang
// ditolak (dari menunggu_pelanggan) dan dibatalkan (dari draft/
// menunggu_pelanggan) terminal. Terapkan satu tx: klaim kondisional
// disetujui->diterapkan, kunci baris dibaca ulang, revisi grandTotal
// lewat computeQuotationTotals server, lalu uang keluar HANYA lewat
// createDifferenceInvoice/createRevisionDownCredit existing (BR-CO-02).
// Baris WorkOrderItem yang sudah punya MaterialIssueItem
// (workOrderItemId terisi, SEMUA status MaterialIssue) TERKUNCI
// total (BR-CO-03); penggantian part terpasang lewat jalur
// MaterialIssue/retur existing. Satu CO aktif (draft/menunggu_
// pelanggan/disetujui) per WO dijaga service di dalam tx (BR-CO-06;
// unique parsial tak tersedia di MySQL). CO TIDAK menyentuh
// bomRevisionId (Q-CO-5; F-104 terpisah). CO pada WO tanpa
// quotationId ditolak (BR-CO-10).
model JobChangeOrder {
  id        Int      @id @default(autoincrement())
  slug      String?  @unique
  // Nomor urut per WO (CO-001, CO-002, ...) dari nomor dokumen CO
  // sendiri (BR-CO-06) — bukan DocumentSequenceService (tak ada prefix CO).
  documentNo String  @unique @map("document_no")
  sequence   Int
  // FK denormal dari WO (WO.quotationId) disimpan sekali saat buat
  // supaya jalur terapkan/riwayat tak menerka ulang (BR-CO-10: WO tanpa
  // quotationId ditolak sebelum baris ini lahir).
  workOrderId Int     @map("work_order_id")
  quotationId Int     @map("quotation_id")
  status      String  @default("draft")
  // Alasan perubahan WAJIB sejak draf (penjaga kirim §3).
  reason      String  @db.Text
  // Timestamp snapshot terkirim (null sebelum kirim). Isi snapshot
  // adalah baris items CO itu sendiri; baca ulang di tx terapkan.
  sentAt  DateTime? @map("sent_at")
  sentBy  Int?      @map("sent_by")
  // Nilai informasi persetujuan saat kirim; snapshot quote saat kirim.
  // BUKAN dasar jurnal (BR-CO-01) — uang selalu dari grandTotal berjalan.
  selisihNilai       Decimal? @map("selisih_nilai") @db.Decimal(15, 2)
  grandTotalSebelum  Decimal? @map("grand_total_sebelum") @db.Decimal(15, 2)
  grandTotalSesudah  Decimal? @map("grand_total_sesudah") @db.Decimal(15, 2)
  // Bukti persetujuan pelanggan dicatat staf (Q-CO-2/BR-CO-07): referensi
  // bebas WAJIB non-kosong sesudah trim + timestamp + pencatat. Sistem
  // TIDAK mengklaim pelanggan menyetujui langsung di sistem (tanpa portal).
  approvalReference        String?   @map("approval_reference") @db.Text
  disetujuiOlehPelangganAt DateTime? @map("disetujui_oleh_pelanggan_at")
  disetujuiDicatatOleh     Int?      @map("disetujui_dicatat_oleh")
  // Lampiran/tautan bukti opsional (Q-CO-2: bukan syarat).
  approvalAttachmentUrl    String?   @map("approval_attachment_url")
  // Jejak penolakan/pembatalan (alasan wajib; §3).
  rejectionReason String? @map("rejection_reason") @db.Text
  rejectedAt      DateTime? @map("rejected_at")
  rejectedBy      Int?      @map("rejected_by")
  cancelReason    String?  @map("cancel_reason") @db.Text
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledBy     Int?      @map("cancelled_by")
  // Hasil terapkan: status diterapkan + jejak dokumen uang existing yang
  // menjadi konsekuensi (bukan jurnal dari CO — BR-CO-02).
  appliedAt          DateTime? @map("applied_at")
  appliedBy          Int?      @map("applied_by")
  appliedGrandTotal  Decimal?  @map("applied_grand_total") @db.Decimal(15, 2)
  appliedInvoiceId   Int?      @map("applied_invoice_id")
  appliedCreditId    Int?      @map("applied_credit_id")
  appliedNote        String?   @map("applied_note") @db.Text
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id])
  items     JobChangeOrderItem[]

  @@unique([workOrderId, sequence], map: "job_change_orders_wo_sequence_unique")
  @@index([workOrderId, status])
  @@index([quotationId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("job_change_orders")
}

// Baris perubahan CO. action: tambah | ubah | hapus (BR-CO-04). Untuk
// tambah: workOrderItemId null (baris WO lahir saat terapkan), before*
// null, after* dari input. Untuk ubah/hapus: workOrderItemId menunjuk
// baris WO existing; before* = snapshot nilai WO saat draf dibuat,
// after* = nilai sesudah (hapus: after* menggemakan before* — jejak
// audit, bukan hard-delete baris WO; baris WO ditandai status replaced
// saat terapkan, pola reviseWorkOrderItems existing). costBefore/
// costAfter = WorkOrderItem.cost snapshot (biaya baris WO, BUKAN
// ProductionCost — AC-CO-3: ProductionCost/totalActualCost tak berubah
// oleh perubahan nilai tagih).
model JobChangeOrderItem {
  id              Int  @id @default(autoincrement())
  changeOrderId   Int  @map("change_order_id")
  workOrderItemId Int? @map("work_order_item_id")
  // Item stok baris (0 = jasa/custom pola WorkOrderItem AUD-NEXT-07).
  itemId      Int
  action      String
  description String?
  uom         String?
  qtyBefore   Decimal? @map("qty_before") @db.Decimal(15, 2)
  qtyAfter    Decimal? @map("qty_after") @db.Decimal(15, 2)
  costBefore  Decimal? @map("cost_before") @db.Decimal(15, 2)
  costAfter   Decimal? @map("cost_after") @db.Decimal(15, 2)
  // Nilai tagih per baris (basis QuotationItem.unitPrice/discount) —
  // sumber revisi grandTotal di tx terapkan.
  unitPriceBefore Decimal? @map("unit_price_before") @db.Decimal(15, 2)
  unitPriceAfter  Decimal? @map("unit_price_after") @db.Decimal(15, 2)
  discountBefore  Decimal? @map("discount_before") @db.Decimal(15, 2)
  discountAfter   Decimal? @map("discount_after") @db.Decimal(15, 2)
  discountType    String?  @map("discount_type")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  changeOrder JobChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  workOrderItem WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)

  @@index([changeOrderId])
  @@index([workOrderItemId])
  @@index([itemId])
  @@map("job_change_order_items")
}

// F-2026-10-22-067-S inti (induk F-2026-10-20-106) + putusan BOT 1
// Q-TM67-1/3/5 (kartu t_40805adc) + vonis BOT 4 F-2026-10-22-072-V:
// jadwal termin per Quotation. Jadwal = RENCANA komersial saja:
// TIDAK menerbitkan invoice/DP/pembayaran/jurnal/faktur pajak, dan
// dueDate baris TIDAK dipakai aging/denda/provisi (aging tetap dari
// dueDate invoice, src/lib/reports/aging.ts). Basis persen = persen
// kumulatif × Quotation.grandTotal berjalan TERMASUK PPN, satu basis,
// tanpa kolom basis DPP. Status per termin = turunan server dari
// dueDate + billedAmountExcludingCancelled (bukan DP, bukan ketik
// manual) di src/lib/reports/job-payment-schedule.ts. Satu jadwal
// aktif per Quotation dijaga di tx aksi (bukan partial-unique: MySQL
// tak punya partial index; penjaga = lock baris quotation + cek
// status aktif di tx yang sama). Amendemen baris sesudah termin
// pertama terpenuhi wajib alasan tercatat (BR-TM67-06); alasan
// terakhir + pencatat disimpan di header sebagai jejak.
model JobPaymentSchedule {
  id          Int      @id @default(autoincrement())
  quotationId Int      @map("quotation_id")
  // aktif | dibatalkan (selesai = turunan builder, bukan nilai simpan)
  status      String   @default("aktif")
  // Jejak amendemen terakhir (BR-TM67-06): alasan wajib bila ubah
  // baris sesudah ada termin terpenuhi; null sebelum amendemen pertama.
  amendmentReason String?   @map("amendment_reason") @db.Text
  amendedBy       Int?      @map("amended_by")
  amendedAt       DateTime? @map("amended_at")
  cancelReason    String?   @map("cancel_reason") @db.Text
  cancelledBy     Int?      @map("cancelled_by")
  cancelledAt     DateTime? @map("cancelled_at")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  quotation Quotation                 @relation(fields: [quotationId], references: [id])
  terms     JobPaymentScheduleTerm[]

  @@index([quotationId, status])
  @@index([createdBy])
  @@index([createdAt])
  @@map("job_payment_schedules")
}

// Baris termin. cumulativePercent Decimal(5,2) naik ketat, baris
// terakhir persis 100 (validasi builder+aksi). Target nominal TIDAK
// disimpan: selalu dihitung ulang dari persen × grandTotal berjalan
// supaya revisi/CO otomatis mengubah termin belum-terpenuhi dan
// termin terpenuhi tidak ditulis ulang (vonis F-072-V butir 3).
// milestoneLabel = label teks bebas + referensi tahap/WO sebagai
// LABEL saja (Q-TM67-1: bukan FK penentu status; Q-TM67-3: milestone
// tidak memicu status tahap ini).
model JobPaymentScheduleTerm {
  id                Int      @id @default(autoincrement())
  scheduleId        Int      @map("schedule_id")
  name              String
  cumulativePercent Decimal  @map("cumulative_percent") @db.Decimal(5, 2)
  dueDate           DateTime @map("due_date")
  milestoneLabel    String?  @map("milestone_label")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  schedule JobPaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, sortOrder])
  @@map("job_payment_schedule_terms")
}

// F-2026-10-22-088-S tahap 1 (Q-TGT-5): master target penjualan per
// penjual-periode. Bentuk fisik milik BOT 3 per spec §9. Pencapaian
// TIDAK disimpan di sini: selalu diturunkan dari faktur paid snapshot
// salesEmployeeId (basis IDENTIK rekap komisi F-2026-10-21-016,
// loader sales-target-achievement-data.ts). Penjaga mengikat di aksi:
// periode penjual sama tidak bertumpukan (BR-TGT-03), targetAmount > 0
// (BR-TGT-04), target baru hanya karyawan isActive (BR-TGT-12),
// perubahan tercatat ActivityLog old/new (BR-TGT-09), nonaktif =
// soft-delete deletedAt bukan hapus fisik (BR-TGT-10). Laporan ini
// informatif: bukan dasar bonus/jurnal/pembayaran (BR-TGT-07).
model SalesTarget {
  id              Int       @id @default(autoincrement())
  salesEmployeeId Int       @map("sales_employee_id")
  // Periode bebas inklusif dua ujung (Q-TGT-4); disimpan tengah malam
  // UTC hari kalender WIB (pola wibDateToUtcMidnight).
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  targetAmount    Decimal   @map("target_amount") @db.Decimal(15, 2)
  notes           String?   @db.Text
  createdBy       Int?      @map("created_by")
  updatedBy       Int?      @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  salesEmployee Employee @relation(fields: [salesEmployeeId], references: [id])

  @@index([salesEmployeeId, periodStart, periodEnd])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("sales_targets")
}

// F-2026-10-22-068-S (Q-BOM68-3 fisik BOT 3): pengajuan ganti revisi BOM
// pada order berjalan — perubahan terkendali, bukan revisi diam-diam.
// Status bebas: menunggu | disetujui | ditolak | diterapkan_langsung.
// Penjaga mengikat di aksi bom-revision-change.actions, BUKAN skema:
// belum ter-issue = langsung diterapkan dalam satu transaksi
// (BR-BOM68-02); sudah ter-issue = usulan wajib diputus, penyetuju !=
// pengaju (SoD BR-BOM68-05), tolak wajib alasan, pin dokumen diganti di
// transaksi persetujuan yang sama (BR-BOM68-06). Semua aksi TIDAK
// PERNAH membuat StockMove/MaterialIssue/ProductionCost/jurnal (vonis
// F-074-V dirujuk BR-BOM68-09). Satu dokumen pemilik per pengajuan
// (BR-BOM68-07): workOrderId ATAU productionOrderId.
model BomRevisionChangeRequest {
  id                Int       @id @default(autoincrement())
  workOrderId       Int?      @map("work_order_id")
  productionOrderId Int?      @map("production_order_id")
  fromRevisionId    Int       @map("from_revision_id")
  toRevisionId      Int       @map("to_revision_id")
  reason            String    @db.Text
  status            String    @default("menunggu") @db.VarChar(30)
  requestedBy       Int?      @map("requested_by")
  decidedBy         Int?      @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  decisionReason    String?   @map("decision_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  fromRevision    BomRevision      @relation("ChangeFromRevision", fields: [fromRevisionId], references: [id])
  toRevision      BomRevision      @relation("ChangeToRevision", fields: [toRevisionId], references: [id])

  @@index([workOrderId, status])
  @@index([productionOrderId, status])
  @@index([createdAt])
  @@map("bom_revision_change_requests")
}

// F-2026-10-22-069-S inti (spec BOT 5 + PUTUSAN BOT 1 Q-SUB69-1..4 +
// vonis BOT 4 F-2026-10-22-075-V): relasi substitusi part SATU ARAH di
// master barang. Satu baris = satu arah; arah balik wajib baris sendiri;
// TIDAK ada inferensi transitif (BR-SUB69-02). Penjaga mengikat hidup di
// aksi item-substitute.actions (bukan skema): asal != pengganti, kedua
// item stok aktif & satuan dasar sama, pasangan aktif ganda ditolak
// (@@unique pasangan sebagai jaring DB). Nonaktifkan = isActive=false —
// baris tidak dihapus supaya riwayat saran/log utuh (BR-SUB69-10).
// Penerapan ke WO TIDAK memakai tabel ini untuk menulis: hanya lewat
// reviseWorkOrderItems existing; tabel ini sumber saran read-only
// (BR-SUB69-04/06, vonis Q-SUB69-5: nol harga/biaya khusus substitusi).
model ItemSubstitute {
  id               Int      @id @default(autoincrement())
  itemId           Int      @map("item_id")
  substituteItemId Int      @map("substitute_item_id")
  notes            String?  @db.Text
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  item           Item @relation("ItemSubstitutes", fields: [itemId], references: [id], onDelete: Cascade)
  substituteItem Item @relation("ItemSubstitutedFor", fields: [substituteItemId], references: [id], onDelete: Cascade)

  @@unique([itemId, substituteItemId], map: "item_substitutes_pair_key")
  @@index([itemId, isActive])
  @@index([substituteItemId])
  @@map("item_substitutes")
}

// ==================== HCMS: REKRUTMEN ====================
// Pilar HCMS pertama di dalam ERP (bukan integrasi eksternal): lowongan
// dibuka HR, pelamar bergerak lewat tahapan seleksi, dan penerimaan
// (hired) melahirkan baris Employee dari data pelamar + jabatan lowongan
// sehingga seluruh modul SDM lain (absensi, payroll, scope tim) langsung
// berlaku tanpa sinkronisasi antar-sistem.

model JobVacancy {
  slug         String?    @unique
  id           Int        @id @default(autoincrement())
  code         String     @unique
  title        String
  departmentId Int?       @map("department_id")
  positionId   Int?       @map("position_id")
  description  String?    @db.Text
  requirements String?    @db.Text
  location     String?
  employmentType String?  @map("employment_type")
  quota        Int        @default(1)
  // draft -> open -> closed (kosakata lowercase mengikuti Expense/Payroll).
  status       String     @default("draft")
  openedAt     DateTime?  @map("opened_at")
  closedAt     DateTime?  @map("closed_at")
  createdBy    Int?       @map("created_by")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  position     Position?   @relation(fields: [positionId], references: [id])
  applicants   JobApplicant[]

  @@index([departmentId], map: "job_vacancies_department_id_fkey")
  @@index([positionId], map: "job_vacancies_position_id_fkey")
  @@index([status], map: "idx_job_vacancies_status")
  @@map("job_vacancies")
}

model JobApplicant {
  slug            String?   @unique
  id              Int       @id @default(autoincrement())
  vacancyId       Int       @map("vacancy_id")
  name            String
  email           String?
  phone           String?
  source          String?
  cvReference     String?   @map("cv_reference")
  // Tahapan seleksi: applied -> screening -> interview -> offering ->
  // hired | rejected (rejected bisa dari tahap mana pun).
  stage           String    @default("applied")
  notes           String?   @db.Text
  hiredEmployeeId Int?      @map("hired_employee_id")
  createdBy       Int?      @map("created_by")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  vacancy         JobVacancy @relation(fields: [vacancyId], references: [id])
  hiredEmployee   Employee?  @relation("ApplicantHiredEmployee", fields: [hiredEmployeeId], references: [id])
  stageHistories  ApplicantStageHistory[]

  @@index([vacancyId], map: "job_applicants_vacancy_id_fkey")
  @@index([stage], map: "idx_job_applicants_stage")
  @@index([hiredEmployeeId], map: "job_applicants_hired_employee_id_fkey")
  @@map("job_applicants")
}

model ApplicantStageHistory {
  id          Int          @id @default(autoincrement())
  applicantId Int          @map("applicant_id")
  fromStage   String?      @map("from_stage")
  toStage     String       @map("to_stage")
  notes       String?      @db.Text
  changedBy   Int?         @map("changed_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  applicant   JobApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId], map: "applicant_stage_histories_applicant_id_fkey")
  @@index([createdAt], map: "idx_applicant_stage_histories_created")
  @@map("applicant_stage_histories")
}

// ==================== HCMS: PENILAIAN KINERJA ====================
// Siklus penilaian berisi sasaran (goals) berbobot per karyawan dan satu
// ulasan per karyawan per siklus. Penilai bawaan = atasan di pohon
// organisasi (pohon atasan karyawan); gerbang akses memakai scope HR
// (self/tim/departemen/all) yang sama dengan modul SDM lain.

model PerformanceCycle {
  slug        String?    @unique
  id          Int        @id @default(autoincrement())
  name        String
  periodStart DateTime   @map("period_start")
  periodEnd   DateTime   @map("period_end")
  // draft -> active -> closed
  status      String     @default("draft")
  createdBy   Int?       @map("created_by")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  goals       PerformanceGoal[]
  reviews     PerformanceReview[]

  @@index([status], map: "idx_performance_cycles_status")
  @@map("performance_cycles")
}

model PerformanceGoal {
  id          Int       @id @default(autoincrement())
  cycleId     Int       @map("cycle_id")
  employeeId  Int       @map("employee_id")
  title       String
  target      String?   @db.Text
  weight      Int       @default(1)
  achievement String?   @db.Text
  // Skor capaian 0-100; null = belum dinilai.
  score       Decimal?  @db.Decimal(5, 2)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee    Employee  @relation("PerformanceGoalEmployee", fields: [employeeId], references: [id])

  @@index([cycleId], map: "performance_goals_cycle_id_fkey")
  @@index([employeeId], map: "performance_goals_employee_id_fkey")
  @@map("performance_goals")
}

model PerformanceReview {
  slug              String?   @unique
  id                Int       @id @default(autoincrement())
  cycleId           Int       @map("cycle_id")
  employeeId        Int       @map("employee_id")
  reviewerEmployeeId Int?     @map("reviewer_employee_id")
  selfScore         Decimal?  @map("self_score") @db.Decimal(5, 2)
  managerScore      Decimal?  @map("manager_score") @db.Decimal(5, 2)
  finalScore        Decimal?  @map("final_score") @db.Decimal(5, 2)
  strengths         String?   @db.Text
  improvements      String?   @db.Text
  // draft -> self_submitted -> manager_reviewed -> finalized
  status            String    @default("draft")
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  cycle             PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee          Employee  @relation("PerformanceReviewSubject", fields: [employeeId], references: [id])
  reviewer          Employee? @relation("PerformanceReviewReviewer", fields: [reviewerEmployeeId], references: [id])

  @@unique([cycleId, employeeId], map: "performance_reviews_cycle_employee_key")
  @@index([employeeId], map: "performance_reviews_employee_id_fkey")
  @@index([reviewerEmployeeId], map: "performance_reviews_reviewer_employee_id_fkey")
  @@map("performance_reviews")
}

// ==================== HCMS: KOMPETENSI & PELATIHAN ====================
// Kompetensi didefinisikan sekali, dipetakan ke jabatan dengan level
// syarat, lalu dinilai per karyawan — selisihnya adalah peta kebutuhan
// pelatihan. Pelatihan mencatat peserta + hasil per karyawan.

model Competency {
  slug        String?    @unique
  id          Int        @id @default(autoincrement())
  name        String     @unique
  category    String?
  description String?    @db.Text
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  positionRequirements PositionCompetency[]
  employeeCompetencies EmployeeCompetency[]

  @@map("competencies")
}

model PositionCompetency {
  id           Int        @id @default(autoincrement())
  positionId   Int        @map("position_id")
  competencyId Int        @map("competency_id")
  // Level syarat skala 1-5.
  requiredLevel Int       @map("required_level")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([positionId, competencyId], map: "position_competencies_pair_key")
  @@index([competencyId], map: "position_competencies_competency_id_fkey")
  @@map("position_competencies")
}

model EmployeeCompetency {
  id           Int        @id @default(autoincrement())
  employeeId   Int        @map("employee_id")
  competencyId Int        @map("competency_id")
  // Level aktual skala 1-5 hasil penilaian.
  level        Int
  assessedBy   Int?       @map("assessed_by")
  assessedAt   DateTime   @map("assessed_at")
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  employee     Employee   @relation("EmployeeCompetencySubject", fields: [employeeId], references: [id])
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, competencyId], map: "employee_competencies_pair_key")
  @@index([competencyId], map: "employee_competencies_competency_id_fkey")
  @@map("employee_competencies")
}

model Training {
  slug        String?    @unique
  id          Int        @id @default(autoincrement())
  title       String
  provider    String?
  startDate   DateTime   @map("start_date")
  endDate     DateTime?  @map("end_date")
  location    String?
  cost        Decimal    @default(0.00) @db.Decimal(15, 2)
  description String?    @db.Text
  // scheduled -> done | cancelled
  status      String     @default("scheduled")
  createdBy   Int?       @map("created_by")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  participants TrainingParticipant[]

  @@index([status], map: "idx_trainings_status")
  @@map("trainings")
}

model TrainingParticipant {
  id             Int      @id @default(autoincrement())
  trainingId     Int      @map("training_id")
  employeeId     Int      @map("employee_id")
  // registered -> attended | absent
  status         String   @default("registered")
  score          Decimal? @db.Decimal(5, 2)
  certificateRef String?  @map("certificate_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  training       Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee       Employee @relation("TrainingParticipantEmployee", fields: [employeeId], references: [id])

  @@unique([trainingId, employeeId], map: "training_participants_pair_key")
  @@index([employeeId], map: "training_participants_employee_id_fkey")
  @@map("training_participants")
}

// ==================== HCMS: PERENCANAAN SUKSESI ====================
// Jabatan kritis (Position.isCritical) dipetakan ke kandidat pengganti
// berurutan prioritas dengan tingkat kesiapan. Cakupan diturunkan:
// ada kandidat ready_now = aman; hanya kandidat masa depan = berisiko;
// tanpa kandidat = kosong (risiko tertinggi). Bersifat rahasia: hanya
// peran pengelola SDM yang memegang izinnya, karyawan biasa tidak.

model SuccessionCandidate {
  id                  Int      @id @default(autoincrement())
  positionId          Int      @map("position_id")
  candidateEmployeeId Int      @map("candidate_employee_id")
  // ready_now | ready_1_2_years | ready_future
  readiness           String   @default("ready_future")
  // Urutan prioritas pengganti (1 = pilihan pertama).
  rank                Int      @default(1)
  notes               String?  @db.Text
  assessedBy          Int?     @map("assessed_by")
  createdBy           Int?     @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  position            Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate           Employee @relation("SuccessionCandidateEmployee", fields: [candidateEmployeeId], references: [id])

  @@unique([positionId, candidateEmployeeId], map: "succession_candidates_pair_key")
  @@index([candidateEmployeeId], map: "succession_candidates_candidate_id_fkey")
  @@index([readiness], map: "idx_succession_candidates_readiness")
  @@map("succession_candidates")
}

// ==================== HCMS: RIWAYAT KENAIKAN GAJI ====================
// Employee.baseSalary adalah nilai BERLAKU SAAT INI; tabel ini adalah
// riwayatnya. Kenaikan dicatat dengan tanggal efektif: yang sudah lewat
// langsung diterapkan ke master dalam transaksi yang sama; yang akan
// datang berstatus scheduled dan diterapkan otomatis oleh jalur
// pembuatan slip (processPayroll/generateBulkPayroll) begitu jatuh
// tempo. Persentase diturunkan server, bukan ketikan client.

model SalaryAdjustment {
  id                  Int       @id @default(autoincrement())
  employeeId          Int       @map("employee_id")
  effectiveDate       DateTime  @map("effective_date")
  previousBaseSalary  Decimal   @map("previous_base_salary") @db.Decimal(15, 2)
  newBaseSalary       Decimal   @map("new_base_salary") @db.Decimal(15, 2)
  // berkala | promosi | umk | kinerja | penyesuaian | lainnya
  reason              String
  notes               String?   @db.Text
  // F-2026-10-26-054-S Jalur A (putusan Lead Q-SA-1): lahir `menunggu`,
  // approve -> scheduled, reject -> ditolak. Sesudah persetujuan:
  // scheduled -> applied | cancelled (existing). applied/ditolak/cancelled
  // terminal.
  status              String    @default("menunggu")
  appliedAt           DateTime? @map("applied_at")
  // Aktor keputusan persetujuan (user id); alasan penolakan wajib terisi
  // bila status ditolak (ditegakkan di aksi, BR-SA-03).
  approvedBy          Int?      @map("approved_by")
  rejectedBy          Int?      @map("rejected_by")
  rejectionReason     String?   @map("rejection_reason") @db.Text
  decidedAt           DateTime? @map("decided_at")
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  employee            Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "salary_adjustments_employee_id_fkey")
  @@index([status, effectiveDate], map: "idx_salary_adjustments_due")
  @@map("salary_adjustments")
}
