  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  taxes     TaxGroupTax[]

  @@map("tax_groups")
}

model TaxGroupTax {
  id         Int      @id @default(autoincrement())
  taxGroupId Int      @map("tax_group_id")
  taxId      Int      @map("tax_id")
  taxGroup   TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)

  @@unique([taxGroupId, taxId])
  @@map("tax_group_taxes")
}

model StatisticalKeyFigure {
  id        Int        @id @default(autoincrement())
  name      String
  code      String?
  unit      String
  type      String?
  value     Decimal    @default(0.00) @db.Decimal(15, 2)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  skfValues SkfValue[]

  @@map("statistical_key_figures")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  modelType   String   @map("model_type")
  modelId     Int?     @map("model_id")
  description String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  ipAddress   String?  @map("ip_address")
  newValues   Json?    @map("new_values")
  oldValues   Json?    @map("old_values")

  @@index([modelType, modelId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model CronLog {
  id          Int      @id @default(autoincrement())
  task        String
  status      String
  message     String?  @db.Text
  duration    Int?
  ranAt       DateTime @default(now()) @map("ran_at")
  @@map("cron_logs")
}

model TransactionAttachment {
  id            Int      @id @default(autoincrement())
  referenceType String   @map("reference_type")
  referenceId   Int      @map("reference_id")
  filename      String
  originalName  String   @map("original_name")
  fileUrl       String   @map("file_url")
  fileSize      Int      @map("file_size")
  mimeType      String   @map("mime_type")
  uploadedBy    Int?     @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([referenceType, referenceId])
  @@map("transaction_attachments")
}

model DeliveryOrderItem {
  id               Int           @id @default(autoincrement())
  deliveryOrderId  Int           @map("delivery_order_id")
  salesOrderItemId Int?          @map("sales_order_item_id")
  itemId           Int           @map("item_id")
  qty              Decimal       @db.Decimal(15, 2)
  unit             String?
  notes            String?
  deliveryOrder    DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  item             Item          @relation(fields: [itemId], references: [id])

  @@index([deliveryOrderId], map: "delivery_order_items_delivery_order_id_fkey")
  @@index([itemId], map: "delivery_order_items_item_id_fkey")
  @@map("delivery_order_items")
}

model ItemBatch {
  id                Int       @id @default(autoincrement())
  itemId            Int       @map("item_id")
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  qty               Decimal   @db.Decimal(15, 2)
  warehouseId       Int       @map("warehouse_id")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  item              Item      @relation(fields: [itemId], references: [id])
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([itemId], map: "item_batches_item_id_fkey")
  @@index([warehouseId], map: "item_batches_warehouse_id_fkey")
  @@map("item_batches")
}

model ItemSerial {
  id           Int       @id @default(autoincrement())
  itemId       Int       @map("item_id")
  serialNumber String    @unique @map("serial_number")
  status       String    @default("available")
  warehouseId  Int       @map("warehouse_id")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  item         Item      @relation(fields: [itemId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([itemId], map: "item_serials_item_id_fkey")
  @@index([warehouseId], map: "item_serials_warehouse_id_fkey")
  @@map("item_serials")
}

model UomConversion {
  id           Int      @id @default(autoincrement())
  itemId       Int      @map("item_id")
  code         String
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(15, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, code])
  @@index([itemId], map: "uom_conversions_item_id_fkey")
  @@map("uom_conversions")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  fromCurrencyId Int      @map("from_currency_id")
  toCurrencyId   Int      @map("to_currency_id")
  rate           Decimal  @db.Decimal(15, 6)
  effectiveDate  DateTime @map("effective_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  fromCurrency   Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])

  @@index([fromCurrencyId], map: "exchange_rates_from_currency_id_fkey")
  @@index([toCurrencyId], map: "exchange_rates_to_currency_id_fkey")
  @@map("exchange_rates")
}

model CrmPipeline {
  id          Int                @id @default(autoincrement())
  name        String
  description String?
  isDefault   Boolean            @default(false) @map("is_default")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  stages      CrmPipelineStage[]

  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id          Int         @id @default(autoincrement())
  pipelineId  Int         @map("pipeline_id")
  name        String
  order       Int
  probability Int         @default(0)
  color       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  pipeline    CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId], map: "crm_pipeline_stages_pipeline_id_fkey")
  @@map("crm_pipeline_stages")
}

model ApprovalDelegation {
  id         Int      @id @default(autoincrement())
  fromUserId Int      @map("from_user_id")
  toUserId   Int      @map("to_user_id")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  reason     String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("approval_delegations")
}

model SkfValue {
  id                     Int                  @id @default(autoincrement())
  statisticalKeyFigureId Int                  @map("statistical_key_figure_id")
  costCenterId           Int?                 @map("cost_center_id")
  profitCenterId         Int?                 @map("profit_center_id")
  period                 String
  value                  Decimal              @db.Decimal(15, 4)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  costCenter             CostCenter?          @relation(fields: [costCenterId], references: [id])
  profitCenter           ProfitCenter?        @relation(fields: [profitCenterId], references: [id])
  statisticalKeyFigure   StatisticalKeyFigure @relation(fields: [statisticalKeyFigureId], references: [id])

  @@index([costCenterId], map: "skf_values_cost_center_id_fkey")
  @@index([profitCenterId], map: "skf_values_profit_center_id_fkey")
  @@index([statisticalKeyFigureId], map: "skf_values_statistical_key_figure_id_fkey")
  @@map("skf_values")
}

model UnitOfMeasure {
  id               Int      @id @default(autoincrement())
  name             String
  symbol           String
  category         String?
  baseUnitId       Int?     @map("base_unit_id")
  conversionFactor Decimal  @default(1.000000) @map("conversion_factor") @db.Decimal(15, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("unit_of_measures")
}

model Appreciation {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  date       DateTime
  type       String   @default("bonus")
  amount     Decimal  @db.Decimal(15, 2)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "appreciations_employee_id_fkey")
  @@map("appreciations")
}

model Task {
  id          Int         @id @default(autoincrement())
  projectId   Int         @map("project_id")
  name        String
  description String?     @db.Text
  status      String      @default("pending")
  assignedTo  Int?        @map("assigned_to")
  startDate   DateTime?   @map("start_date")
  dueDate     DateTime?   @map("due_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  assignee    Employee?   @relation(fields: [assignedTo], references: [id])
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timesheets  Timesheet[]

  @@index([assignedTo], map: "tasks_assigned_to_fkey")
  @@index([projectId], map: "tasks_project_id_fkey")
  @@map("tasks")
}

model DepartmentHoliday {
  id           Int        @id @default(autoincrement())
  departmentId Int        @map("department_id")
  name         String
  date         DateTime
  isRecurring  Boolean    @default(false) @map("is_recurring")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId], map: "department_holidays_department_id_fkey")
  @@map("department_holidays")
}

model ProductVehicleModel {
  id             Int          @id @default(autoincrement())
  productId      Int          @map("product_id")
  vehicleModelId Int          @map("vehicle_model_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleModelId])
  @@index([vehicleModelId], map: "product_vehicle_models_vehicle_model_id_fkey")
  @@map("product_vehicle_models")
}

