  customer       Customer          @relation(fields: [customerId], references: [id])
  sourceTaxInvoice TaxInvoice?     @relation(fields: [sourceTaxInvoiceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([salesInvoiceId])
  @@index([sourceTaxInvoiceId], map: "idx_sales_returns_source_tax_invoice")
  @@index([customerId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            Int         @id @default(autoincrement())
  salesReturnId Int         @map("sales_return_id")
  itemId        Int         @map("item_id")
  qty           Decimal     @db.Decimal(15, 2)
  cost          Decimal     @default(0.00) @db.Decimal(15, 2)
  price         Decimal     @default(0.00) @db.Decimal(15, 2)
  serialNumbers Json?       @map("serial_numbers")
  batchNumbers  Json?       @map("batch_numbers")
  /**
   * Snapshot pajak saat complete (F-004): DPP = qty × price beku,
   * PPN = DPP × tarif efektif faktur asal, safeRound sen. Null = baris
   * legacy (fallback hitung-ulang berlabel, bukan snapshot).
   */
  returnDpp     Decimal?    @map("return_dpp") @db.Decimal(15, 2)
  returnVat     Decimal?    @map("return_vat") @db.Decimal(15, 2)
  /**
   * Tarif efektif faktur asal saat snapshot (Decimal 5,2).
   */
  sourceTaxRate Decimal?    @map("source_tax_rate") @db.Decimal(5, 2)
  sourceTaxInvoiceId Int?   @map("source_tax_invoice_id")
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([salesReturnId], map: "sales_return_items_sales_return_id_fkey")
  @@index([itemId])
  @@map("sales_return_items")
}

