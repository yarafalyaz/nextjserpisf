  disciplinaryDecisionsSigned DisciplinaryDeductionDecision[] @relation("DisciplinaryDecisionSigner")
  contractDecisionRequests ContractDecisionRequest[] @relation("ContractDecisionSubject")
  payrolls            Payroll[]
  tasks               Task[]
  timesheets          Timesheet[]
  workSchedules       WorkSchedule[]    @relation("EmployeeWorkSchedules")
  salesQuotations     Quotation[]       @relation("QuotationSalesEmployee")
  salesOrdersAsSales  SalesOrder[]      @relation("SalesOrderSalesEmployee")
  salesInvoicesAsSales SalesInvoice[]   @relation("SalesInvoiceSalesEmployee")
  salesTargets         SalesTarget[]
