model DocumentSequence {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  currentValue Int      @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("document_sequences")
}

/// Transaksi favorit per pengguna (Accurate: "Transaksi Favorit") — pintasan ke
/// halaman/dokumen yang sering dibuka. Milik satu pengguna, jadi tidak ber-slug.
model FavoriteTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String
  /**
   * Jalur internal aplikasi, mis. "/penjualan/faktur/tambah".
   */
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@index([userId])
  @@index([createdAt])
  @@map("favorite_transactions")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String
  body      String    @db.Text
  type      String    @default("info")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "notifications_user_id_fkey")
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model Customer {
  slug               String?           @unique
  id                 Int               @id @default(autoincrement())
  street             String?           @map("street") @db.Text
  village            String?           @map("village")
  district           String?           @map("district")
  province           String?           @map("province")
  postalCode         String?           @map("postal_code")
  name               String
  email              String?
  phone              String?
  address            String?           @db.Text
  city               String?
  gender             String?           @map("gender")
  taxId              String?           @map("tax_id")
  code               String?           @unique @map("code")
  creditLimit        Decimal           @default(0.00) @map("credit_limit") @db.Decimal(15, 2)
  contactPerson      String?           @map("contact_person")
  isActive           Boolean           @default(true) @map("is_active")
  deletedAt          DateTime?         @map("deleted_at")
  createdBy          Int?              @map("created_by")
  updatedBy          Int?              @map("updated_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  customerVehicles   CustomerVehicle[]
  downPayments       DownPayment[]
  customerCredits    CustomerCredit[]
  projects           Project[]
  quotations         Quotation[]
  salesInvoices      SalesInvoice[]
  invoiceExchanges   InvoiceExchange[]
  salesReturns       SalesReturn[]
  salesOrders        SalesOrder[]
  workOrders         WorkOrder[]
  customerCategoryId Int?              @map("customer_category_id")
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])

  @@index([isActive, deletedAt], map: "idx_customers_active_deleted")
  @@index([name], map: "idx_customers_name")
  @@index([code], map: "idx_customers_code")
  @@index([createdAt])
  @@map("customers")
}

// AUD-FIN-02 (putusan akuntan): KREDIT PELANGGAN terstruktur. Kelebihan DP di
// atas grandTotal BUKAN pelunasan — dicatat di sini sebagai saldo yang bisa
// dipakai ulang / di-refund, bukan catatan teks di notes. Satu baris = satu
// sumber dana (DP / lebih-bayar). allocated + refunded tak boleh > received
// (ditegakkan di kode + guard tes; DB tak punya CHECK lintas kolom portabel).
// Jurnal: saat dibentuk Dr. Kewajiban UMP 210102 / Cr. Kewajiban UMP 210102
// (reklas antar subledger pelanggan, nol-net di GL); saat dipakai
// Dr. 210102 / Cr. Piutang; saat refund Dr. 210102 / Cr. Kas.
model CustomerCredit {
  id              Int      @id @default(autoincrement())
  documentNo      String   @unique @map("document_no")
  customerId      Int      @map("customer_id")
  sourceType      String   @map("source_type")
  sourceId        Int      @map("source_id")
  receivedAmount  Decimal  @map("received_amount") @db.Decimal(15, 2)
  allocatedAmount Decimal  @default(0.00) @map("allocated_amount") @db.Decimal(15, 2)
  refundedAmount  Decimal  @default(0.00) @map("refunded_amount") @db.Decimal(15, 2)
  status          String   @default("open")
  notes           String?  @db.Text
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  customer        Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, status], map: "idx_customer_credits_cust_status")
  @@index([sourceType, sourceId], map: "idx_customer_credits_source")
  @@map("customer_credits")
}

model FinancialIdempotencyKey {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  scope         String
  payloadHash   String?  @map("payload_hash")
  resultRefType String?  @map("result_ref_type")
  resultRefId   Int?     @map("result_ref_id")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([scope], map: "idx_fin_idem_scope")
  @@map("financial_idempotency_keys")
}

model CustomerCategory {
  slug               String?    @unique
  id                 Int        @id @default(autoincrement())
  name               String     @unique
  downPaymentPercent Decimal    @default(0.00) @map("down_payment_percent") @db.Decimal(5, 2)
  isActive           Boolean    @default(true) @map("is_active")
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  customers          Customer[]

  @@index([isActive, deletedAt], map: "idx_cust_cat_active_deleted")
  @@map("customer_categories")
}

model Vendor {
  slug              String?           @unique
  id                Int               @id @default(autoincrement())
  photo             String?           @map("photo")
  street            String?           @map("street") @db.Text
  province          String?           @map("province")
  postalCode        String?           @map("postal_code")
  bankName          String?           @map("bank_name")
  bankAccountNumber String?           @map("bank_account_number")
  bankAccountHolder String?           @map("bank_account_holder")
  districtVendor    String?           @map("district")
  villageVendor     String?           @map("village")
  name              String
  code              String?           @unique
  email             String?
  phone             String?
  address           String?           @db.Text
  city              String?
  npwp              String?
  contactPerson     String?           @map("contact_person")
  paymentTermId     Int?              @map("payment_term_id")
  isActive          Boolean           @default(true) @map("is_active")
  deletedAt         DateTime?         @map("deleted_at")
  createdBy         Int?              @map("created_by")
  updatedBy         Int?              @map("updated_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  items             Item[]
  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  vendorBills       VendorBill[]
  vendorPayments    VendorPayment[]
  productionCosts   ProductionCost[]
  expenses          Expense[]
  pettyCash         PettyCash[]
  purchaseAdvances  PurchaseAdvance[]
  vendorPrices      VendorItemPrice[]
  paymentTerm       PaymentTerm?      @relation(fields: [paymentTermId], references: [id])

  @@index([paymentTermId], map: "vendors_payment_term_id_fkey")
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@map("vendors")
}

/// Uang muka pembelian (down payment ke vendor). Murni sisi akuntansi: menambah
/// saldo Uang Muka (aset) dan mengurangi kas/bank lewat satu jurnal.
///
/// **Penerapan ke tagihan vendor belum diotomatiskan** — dokumen ini mencatat
/// uang muka yang dibayarkan, bukan saldo yang belum terpakai; laporan yang
/// mengaku "sisa uang muka" tidak boleh dibuat dari tabel ini.
model PurchaseAdvance {
  slug             String?   @unique
  id               Int       @id @default(autoincrement())
  documentNo       String    @unique @map("document_no")
  date             DateTime
  vendorId         Int       @map("vendor_id")
  amount           Decimal   @db.Decimal(15, 2)
  paymentAccountId Int       @map("payment_account_id")
  advanceAccountId Int       @map("advance_account_id")
  description      String?   @db.Text
  status           String    @default("posted")
  journalId        Int?      @map("journal_id")
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  vendor           Vendor    @relation(fields: [vendorId], references: [id])

  @@index([vendorId], map: "purchase_advances_vendor_id_fkey")
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("purchase_advances")
}

/// Daftar harga pemasok per barang (Accurate: "Harga Pemasok").
///
/// **Murni rujukan** — dokumen pembelian (pesanan/penerimaan/tagihan) belum
/// mengambil harga dari sini; ini catatan harga hasil kesepakatan, bukan harga
/// yang otomatis mengikat transaksi.
model VendorItemPrice {
  id            Int       @id @default(autoincrement())
  vendorId      Int       @map("vendor_id")
  itemId        Int       @map("item_id")
  price         Decimal   @db.Decimal(15, 2)
  minQty        Decimal   @default(1.00) @map("min_qty") @db.Decimal(15, 2)
  effectiveDate DateTime? @map("effective_date")
  notes         String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([vendorId, itemId, minQty], map: "uq_vendor_item_price")
  @@index([vendorId], map: "vendor_item_prices_vendor_id_fkey")
  @@index([itemId], map: "vendor_item_prices_item_id_fkey")
  @@index([createdAt])
  @@map("vendor_item_prices")
}

model Brand {
  slug        String?        @unique
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?        @db.Text
  createdBy   Int?           @map("created_by")
  updatedBy   Int?           @map("updated_by")
