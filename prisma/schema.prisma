/// Jenis pemotongan PPh (mis. PPh 23 jasa 2%, PPh 4(2) 10%).
///
/// F-003: `article` = pasal sumber (PPh21|PPh22|PPh23|PPh4(2)|PPh26|PPh15);
/// `objectCode` = kode objek e-Bupot per jenis (mis. seri 24-104-xx jasa PPh 23
/// PMK-141, 28-409-xx konstruksi final) — dipilih per jenis, bukan satu kode
/// keras. `receivableAccountId` = akun PPh dibayar dimuka (alias konseptual
/// `prepaidAccountId`; kolom TIDAK di-rename agar migrasi nol).
model WithholdingTaxType {
  slug                String?        @unique
  id                  Int            @id @default(autoincrement())
  code                String         @unique
  name                String
  rate                Decimal        @default(0.00) @db.Decimal(5, 2)
  /**
   * Pasal PPh sumber (PPh21|PPh22|PPh23|PPh4(2)|PPh26|PPh15). Nullable: jenis lama.
   */
  article             String?
  /**
   * Kode objek e-Bupot per jenis jasa/pekerjaan. Nullable: jenis lama.
   */
  objectCode          String?        @map("object_code")
  /**
   * Akun Hutang PPh (kita memotong vendor).
   */
  liabilityAccountId  Int?           @map("liability_account_id")
  /**
   * Akun PPh dibayar dimuka (dipotong pelanggan). Alias konseptual
   * `prepaidAccountId` — kolom TIDAK di-rename (migrasi nol).
   */
  receivableAccountId Int?           @map("receivable_account_id")
  isActive            Boolean        @default(true) @map("is_active")
  deletedAt           DateTime?      @map("deleted_at")
  createdBy           Int?           @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  vendorBills         VendorBill[]
  salesPayments       SalesPayment[]
  taxPayments         TaxPayment[]
  withholdingCertificates WithholdingCertificate[]

  @@index([isActive, deletedAt])
  @@map("withholding_tax_types")
}

/// Faktur pajak PPN — SATU dokumen pajak, bukan field tempel (F-001/F-002).
///
/// Arah `out` = keluaran (tautan SalesInvoice), `in` = masukan (tautan
/// VendorBill). `taxPeriod` DITURUNKAN dari `taxInvoiceDate`, bukan input
/// bebas. `creditPeriod`/`creditStatus` hanya bermakna untuk arah `in`
/// (masa kredit maks 3 masa sesudah masa faktur; lewat = `expired`).
/// Pengganti: dokumen baru, nomor seri sama, `replacesId` menunjuk faktur
/// diganti (unik); SPT efektif per rantai — hanya kepala rantai bernilai.
/// Batal: status `cancelled`, nomor TIDAK dipakai ulang.
model TaxInvoice {
  slug                 String?      @unique
  id                   Int          @id @default(autoincrement())
  /**
   * "out" | "in".
   */
  direction            String
  /**
   * Kode transaksi PER-11/PJ/2025, string 2 digit kanonik ("01".."10";
   * Coretax tampil "010" hanya pad untuk kode 10). Default ERP: "04".
   */
  transactionCode      String       @map("transaction_code") @db.VarChar(2)
  taxInvoiceNumber     String       @map("tax_invoice_number")
  taxInvoiceDate       DateTime     @map("tax_invoice_date")
  /**
   * Masa SPT terbit "YYYY-MM", diturunkan dari taxInvoiceDate.
   */
  taxPeriod            String       @map("tax_period") @db.VarChar(7)
  dpp                  Decimal      @db.Decimal(15, 2)
  taxRate              Decimal      @default(12.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount            Decimal      @map("tax_amount") @db.Decimal(15, 2)
  /**
   * draft|approved|rejected|replaced|cancelled.
   */
  djpStatus            String       @default("draft") @map("djp_status")
  salesInvoiceId       Int?         @map("sales_invoice_id")
  vendorBillId         Int?         @map("vendor_bill_id")
  vendorId             Int?         @map("vendor_id")
  /**
   * F-2026-10-25-004-V: FP uang muka (FP UM) tertaut DownPayment.
   * Snapshot DPP/PPN FP UM hidup di baris ini (dpp/taxAmount/taxRate);
   * snapshot DP asal dibekukan di DownPayment.vat*. SetNull pola existing.
   */
  downPaymentId        Int?         @map("down_payment_id")
  /**
   * Self-FK ke faktur diganti; unik (satu pengganti per faktur).
   */
  replacesId           Int?         @unique @map("replaces_id")
  replaceReason        String?      @map("replace_reason") @db.Text
  counterpartyTaxId    String?      @map("counterparty_tax_id")
  counterpartyName     String?      @map("counterparty_name")
  counterpartyNitku    String?      @map("counterparty_nitku")
  /**
   * Masa pengkreditan dipilih (arah in saja), "YYYY-MM".
   */
  creditPeriod         String?      @map("credit_period") @db.VarChar(7)
  creditedAt           DateTime?    @map("credited_at")
  /**
   * uncredited|credited|not_creditable|expired (arah in saja).
   */
  creditStatus         String       @default("uncredited") @map("credit_status")
  /**
   * Alasan wajib bila not_creditable (UU PPN 9(8)): PRE_PKP |
   * NO_DIRECT_RELATION | VEHICLE_SEDAN_SW | FOREIGN_USE_PRE_PKP |
   * INVALID_INVOICE | FOREIGN_INVALID | ASSESSED |
   * UNREPORTED_FOUND_ON_AUDIT | PRE_PRODUCTION_NON_CAPITAL |
   * BY_POLICY_EXEMPT_OUTPUT.
   */
  nonCreditableReason  String?      @map("non_creditable_reason")
  /**
   * Porsi kreditabel utk penyerahan campur (pedoman pengkreditan).
   */
  creditablePercent    Decimal      @default(100.00) @map("creditable_percent") @db.Decimal(5, 2)
  xmlPayload           String?      @map("xml_payload") @db.Text
  xmlHash              String?      @map("xml_hash")
  xmlImportedAt        DateTime?    @map("xml_imported_at")
  djpMessage           String?      @map("djp_message") @db.Text
  createdBy            Int?         @map("created_by")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  salesInvoice         SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  downPayment          DownPayment? @relation(fields: [downPaymentId], references: [id], onDelete: SetNull)
  vendorBill           VendorBill?  @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  vendor               Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  replaces             TaxInvoice?  @relation("TaxInvoiceReplacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy           TaxInvoice?  @relation("TaxInvoiceReplacement")
  salesReturnNotes     SalesReturn[]
  purchaseReturnNotes  PurchaseReturn[]

  @@index([direction, taxInvoiceNumber], map: "idx_tax_invoices_direction_number")
  @@index([taxPeriod], map: "idx_tax_invoices_period")
  @@index([djpStatus], map: "idx_tax_invoices_status")
  @@index([creditPeriod], map: "idx_tax_invoices_credit_period")
  @@index([creditStatus], map: "idx_tax_invoices_credit_status")
  @@index([salesInvoiceId], map: "idx_tax_invoices_sales_invoice")
  @@index([downPaymentId], map: "idx_tax_invoices_down_payment")
  @@index([vendorBillId], map: "idx_tax_invoices_vendor_bill")
  @@index([vendorId], map: "idx_tax_invoices_vendor")
  @@index([direction, creditStatus, creditPeriod], map: "idx_tax_invoices_spt_input")
  @@map("tax_invoices")
}

/// Bukti potong PPh / e-Bupot Unifikasi — dokumen sendiri (F-003).
///
/// Lahir menyalin pasal+kode objek+tarif+DPP dari WithholdingTaxType
/// terpilih ke snapshot dokumen; edit tarif master SESUDAH itu tidak
/// mengubah bupot terbit maupun jurnalnya. Batal = `revoked` + reversal
/// jurnal dokumen sumber, bukan hapus baris. Rekap SPT Masa Unifikasi per
/// masa dari `withholdingDate`.
model WithholdingCertificate {
  slug                 String?             @unique
  id                   Int                 @id @default(autoincrement())
  /**
   * "we_withhold" (kita potong vendor) | "withheld_from_us" (dipotong pelanggan).
   */
  direction            String
  certificateNumber    String              @map("certificate_number")
  withholdingDate      DateTime            @map("withholding_date")
  /**
   * Masa pajak "YYYY-MM" dari withholdingDate.
   */
  taxPeriod            String              @map("tax_period") @db.VarChar(7)
  counterpartyTaxId    String?             @map("counterparty_tax_id")
  counterpartyName     String              @map("counterparty_name")
  withholdingTypeId    Int                 @map("withholding_type_id")
  /**
   * Pasal snapshot: PPh21|PPh22|PPh23|PPh4(2)|PPh26|PPh15.
   */
  article              String
  objectCode           String?             @map("object_code")
  /**
   * Nama resmi kode objek katalog SATU sumber (F-055-V §2) — snapshot saat terbit.
   */
  objectName           String?             @map("object_name")
  /**
   * Bukti dokumen dasar terstruktur kode bersyarat bukti (F-055-V §1) — snapshot saat terbit.
   */
  rentObjectEvidence   String?             @map("rent_object_evidence") @db.Text
  dpp                  Decimal             @db.Decimal(15, 2)
  tariff               Decimal             @map("tariff") @db.Decimal(5, 2)
  withheldAmount       Decimal             @map("withheld_amount") @db.Decimal(15, 2)
  /**
   * draft|issued|revoked.
   */
  status               String              @default("draft")
  vendorBillId         Int?                @map("vendor_bill_id")
  salesPaymentId       Int?                @map("sales_payment_id")
  /**
   * Fasilitas: SKB | PP23 | DTP | null (tanpa fasilitas).
   */
  facility             String?
  facilityNumber       String?             @map("facility_number")
  createdBy            Int?                @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  withholdingType      WithholdingTaxType  @relation(fields: [withholdingTypeId], references: [id])
  vendorBill           VendorBill?         @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  salesPayment         SalesPayment?       @relation(fields: [salesPaymentId], references: [id], onDelete: SetNull)

  @@unique([certificateNumber], map: "uq_withholding_certificates_number")
  @@index([taxPeriod], map: "idx_withholding_certificates_period")
  @@index([status], map: "idx_withholding_certificates_status")
  @@index([withholdingTypeId], map: "idx_withholding_certificates_type")
  @@index([vendorBillId], map: "idx_withholding_certificates_vendor_bill")
  @@index([salesPaymentId], map: "idx_withholding_certificates_sales_payment")
  @@map("withholding_certificates")
}

/// Penyetoran pajak (PPh) ke kas negara. Jurnal: **Dr akun utang pajak, Cr kas/bank**.
///
/// Menyetor bukan beban baru — ini melunasi utang pajak yang sudah dipotong pada
/// dokumen (mis. tagihan vendor). Karena itu sisi debit masuk akun **utang pajak**,
/// bukan akun beban.
model TaxPayment {
  slug             String?             @unique
  id               Int                 @id @default(autoincrement())
  documentNo       String              @unique @map("document_no")
  date             DateTime
  /**
   * Masa pajak, mis. "2026-09". F-005: divalidasi YYYY-MM di service/Zod;
   * masa setor dari `period`, bukan tanggal bayar.
   */
  period           String?
  taxTypeId        Int?                @map("tax_type_id")
  taxAccountId     Int                 @map("tax_account_id")
  paymentAccountId Int                 @map("payment_account_id")
  amount           Decimal             @db.Decimal(15, 2)
  /**
   * Kode billing MPN 15 digit (nullable: setor legacy/manual).
   */
  billingCode      String?             @map("billing_code") @db.VarChar(15)
  /**
   * NTPN 16 karakter (nullable: setor legacy/manual).
   */
  ntpn             String?             @db.VarChar(16)
  /**
   * Jenis pajak terstruktur (ppn|pph21|pph23|pph4_2|pph_badan|other) agar
   * PPN/PPh badan di luar tipe potong terwakili. taxTypeId TETAP dipakai
   * (wajib taut di service, bukan kolom baru).
   */
  taxKind          String?             @map("tax_kind")
  /**
   * Nomor SSP/MPN sebagai bukti setor. Dipertahankan cermin legacy;
   * sumber baru = billingCode + ntpn.
   */
  reference        String?
  notes            String?             @db.Text
  status           String              @default("posted")
  journalId        Int?                @map("journal_id")
  createdBy        Int?                @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  taxType          WithholdingTaxType? @relation(fields: [taxTypeId], references: [id], onDelete: SetNull)

  @@index([taxTypeId])
  @@index([taxAccountId])
  @@index([paymentAccountId])
  @@index([date])
  @@index([period])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("tax_payments")
}

/// Template dokumen berulang (faktur/tagihan/beban/jurnal) yang dijalankan berkala.
model RecurringTransaction {
  slug        String?   @unique
  id          Int       @id @default(autoincrement())
  name        String
  /**
   * "sales_invoice" | "purchase_bill" | "expense" | "journal"
   */
  type        String
  /**
   * "daily" | "weekly" | "monthly" | "quarterly" | "yearly"
   */
  frequency   String
  interval    Int       @default(1)
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  nextRunDate DateTime  @map("next_run_date")
  lastRunAt   DateTime? @map("last_run_at")
  runCount    Int       @default(0) @map("run_count")
  /**
   * Template payload (JSON) untuk dokumen yang dihasilkan.
   */
  template    String    @db.Text
  /**
   * Ringkasan dokumen terakhir yang dihasilkan.
   */
  lastResult  String?   @map("last_result") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, deletedAt, nextRunDate])
  @@map("recurring_transactions")
}

model Quotation {
  slug              String?            @unique
  id                Int                @id @default(autoincrement())
  revisionNumber    Int                @default(0) @map("revision_number")
  projectId         Int?               @map("project_id")
  documentNo        String             @unique @map("document_no")
  customerId        Int                @map("customer_id")
  customerVehicleId Int?               @map("customer_vehicle_id")
  // F-2026-10-21-016 tahap 1: atribusi penjual (snapshot; diwariskan
  // SO -> Invoice). Tanpa jurnal komisi (tahap 3 ditunda vonis Lead).
  salesEmployeeId   Int?               @map("sales_employee_id")
  // F-2026-10-22-065-S (inti F-2026-10-20-108): snapshot persen ambang
  // konversi DP → invoice dari CustomerCategory.downPaymentPercent saat
  // quotation dibuat. Nullable; null/0/korup = fail-closed default 50 di
  // helper invoice-threshold (bukan baca master berjalan — AC-DP65-4).
  invoiceThresholdPercent Decimal?     @map("invoice_threshold_percent") @db.Decimal(5, 2)
  date              DateTime
  validUntil        DateTime?          @map("valid_until")
  subtotal          Decimal            @default(0.00) @db.Decimal(15, 2)
  discount          Decimal            @default(0.00) @db.Decimal(15, 2)
  tax               Decimal            @default(0.00) @db.Decimal(15, 2)
  grandTotal        Decimal            @default(0.00) @map("grand_total") @db.Decimal(15, 2)
  paymentMethod     String?            @map("payment_method")
  shippingMethod    String?            @map("shipping_method")
  status            String             @default("draft")
  notes             String?            @db.Text
  createdBy         Int?               @map("created_by")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  downPayments      DownPayment[]
  histories         QuotationHistory[]
  sections          QuotationSection[]
  customer          Customer           @relation(fields: [customerId], references: [id])
  customerVehicle   CustomerVehicle?   @relation(fields: [customerVehicleId], references: [id])
  salesEmployee     Employee?          @relation("QuotationSalesEmployee", fields: [salesEmployeeId], references: [id])
  salesInvoices     SalesInvoice[]
  salesOrders       SalesOrder[]
  workOrders        WorkOrder[]
  changeOrders      JobChangeOrder[]
  paymentSchedules  JobPaymentSchedule[]
  contractProjects  Project[]          @relation("ProjectContractQuotation")

  @@index([customerId], map: "quotations_customer_id_fkey")
  @@index([customerVehicleId], map: "quotations_customer_vehicle_id_fkey")
  @@index([salesEmployeeId])
  @@index([status], map: "idx_quotations_status")
  @@index([projectId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("quotations")
}

model QuotationSection {
  id          Int             @id @default(autoincrement())
  quotationId Int             @map("quotation_id")
  name        String
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       QuotationItem[]
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId], map: "quotation_sections_quotation_id_fkey")
  @@index([createdAt])
  @@map("quotation_sections")
}

model QuotationItem {
  id          Int              @id @default(autoincrement())
  sectionId   Int              @map("section_id")
  itemId      Int?             @map("item_id")
  // F-2026-10-22-063-S (induk F-2026-10-21-023): snapshot PERINGATAN fitment
  // saat baris terakhir disimpan (BR-FIT-03). Nullable; null = belum/tidak
  // dievaluasi (tanpa kendaraan, baris bebas itemId null, atau evaluasi
  // gagal BR-FIT-09). Tidak pernah memblokir simpan (BR-FIT-01).
  fitmentResult      String?   @map("fitment_result")
  fitmentRuleId      Int?      @map("fitment_rule_id")
  fitmentEvaluatedAt DateTime? @map("fitment_evaluated_at")
  description String?
  uom         String?
  qty         Decimal          @default(1.00) @db.Decimal(15, 2)
  unitPrice   Decimal          @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  discount    Decimal          @default(0.00) @db.Decimal(15, 2)
  total       Decimal          @default(0.00) @db.Decimal(15, 2)
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  section     QuotationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId], map: "quotation_items_section_id_fkey")
  @@index([itemId])
  @@index([createdAt])
  @@map("quotation_items")
}

model QuotationHistory {
  id               Int       @id @default(autoincrement())
  quotationId      Int       @map("quotation_id")
  revisionNumber   Int       @default(0) @map("revision_number")
  statusAtSnapshot String    @default("sent") @map("status_at_snapshot")
  dataSnapshot     Json?     @map("data_snapshot")
  changeReason     String?   @map("change_reason") @db.Text
  action           String
  description      String?   @db.Text
  userId           Int?      @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId], map: "quotation_histories_quotation_id_fkey")
  @@index([userId])
  @@index([createdAt])
  @@map("quotation_histories")
}

model DownPayment {
  slug          String?   @unique
  id            Int       @id @default(autoincrement())
  documentNo    String    @unique @map("document_no")
  quotationId   Int       @map("quotation_id")
  customerId    Int       @map("customer_id")
  amount        Decimal   @db.Decimal(15, 2)
  paymentDate   DateTime  @map("payment_date")
  paymentMethod String?   @map("payment_method")
  proofImage    String?   @map("proof_image")
  status        String    @default("pending")
  notes         String?   @db.Text
  /**
   * F-2026-10-25-004-V: snapshot PPN uang muka dibekukan saat confirm
   * (vonis PR #760). Null = DP legacy pra-fitur / belum confirmed.
   * vatAmount > 0 = terutang FP UM; kredit 210102 = amount - vatAmount.
   * Edit master pajak sesudah confirm TIDAK mengubah snapshot ini.
   */
  vatTransactionCode String? @map("vat_transaction_code") @db.VarChar(2)
  vatRate            Decimal? @map("vat_rate") @db.Decimal(5, 2)
  vatDpp             Decimal? @map("vat_dpp") @db.Decimal(15, 2)
  vatAmount          Decimal? @map("vat_amount") @db.Decimal(15, 2)
  vatTaxPeriod       String? @map("vat_tax_period") @db.VarChar(7)
  /**
   * F-2026-10-25-015-V Putusan 3: snapshot status PKP perusahaan yang
   * dipakai gerbang saat DP confirmed (beku, nol efek retroaktif dari
   * edit master). Null = baris legacy pra-fitur, berlabel legacy di
   * read-model.
   */
  companyPkpStatusSnapshot        String?   @map("company_pkp_status_snapshot") @db.VarChar(16)
  companyPkpEffectiveFromSnapshot DateTime? @map("company_pkp_effective_from_snapshot")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  customer      Customer  @relation(fields: [customerId], references: [id])
  quotation     Quotation @relation(fields: [quotationId], references: [id])
  taxInvoices   TaxInvoice[]

  @@index([customerId], map: "down_payments_customer_id_fkey")
  @@index([quotationId], map: "down_payments_quotation_id_fkey")
  @@index([status], map: "idx_down_payments_status")
  @@index([createdBy])
  @@index([createdAt])
  @@map("down_payments")
}

model SalesOrder {
  slug              String?          @unique
  id                Int              @id @default(autoincrement())
  customerVehicleId Int?             @map("customer_vehicle_id")
  // F-2026-10-21-016 tahap 1: snapshot penjual diwariskan dari Quotation.
  salesEmployeeId   Int?             @map("sales_employee_id")
  totalAmount       Decimal          @default(0.00) @map("total_amount") @db.Decimal(15, 2)
