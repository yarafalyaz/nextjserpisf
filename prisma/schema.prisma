  tax                 Decimal                   @default(0.00) @db.Decimal(15, 2)
  grandTotal          Decimal                   @default(0.00) @map("grand_total") @db.Decimal(15, 2)
  paidAmount          Decimal                   @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  status              String                    @default("draft")
