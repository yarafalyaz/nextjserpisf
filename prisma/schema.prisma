  updatedAt    DateTime            @updatedAt @map("updated_at")
  items        MaterialIssueItem[]
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  costCenter   CostCenter?         @relation(fields: [costCenterId], references: [id])
  costCenterId Int?                @map("cost_center_id")

  @@index([warehouseId], map: "material_issues_warehouse_id_fkey")
  @@index([status], map: "idx_material_issues_status")
  @@index([projectId])
  @@index([workOrderId])
  @@index([costCenterId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("material_issues")
}

model MaterialIssueItem {
  id              Int           @id @default(autoincrement())
  materialIssueId Int           @map("material_issue_id")
  itemId          Int           @map("item_id")
  // F-2026-10-20-39(a): baris WO asal pengeluaran ini (nullable — MI manual
  // tanpa WO tetap sah; baris lama tanpa FK dijaga guard revisi via itemId).
  workOrderItemId Int?          @map("work_order_item_id")
  qty             Decimal       @db.Decimal(15, 2)
  cost            Decimal       @default(0.00) @db.Decimal(15, 2)
  // F-2026-10-21-008: scrap terstruktur per baris (vonis BOT 4
  // F-2026-10-22-066-V). scrapQty/scrapReasonCode/scrapNote = input operator
  // di draft; scrapPercentSnapshot = allowance BOM (%) dibekukan saat baris
  // issue dibuat (dilarang baca master hidup saat complete); kolom
  // *Snapshot lain dibekukan saat complete dari cost FIFO baris.
  scrapQty             Decimal  @default(0.00) @map("scrap_qty") @db.Decimal(15, 2)
  scrapReasonCode      String?  @map("scrap_reason_code") @db.VarChar(32)
  scrapNote            String?  @map("scrap_note") @db.VarChar(500)
  scrapPercentSnapshot Decimal? @map("scrap_percent_snapshot") @db.Decimal(5, 2)
  scrapClassifiedAt    DateTime? @map("scrap_classified_at")
  scrapPlannedQtySnapshot Decimal? @map("scrap_planned_qty_snapshot") @db.Decimal(15, 2)
  scrapNormalQtySnapshot  Decimal? @map("scrap_normal_qty_snapshot") @db.Decimal(15, 2)
  scrapAbnormalQtySnapshot Decimal? @map("scrap_abnormal_qty_snapshot") @db.Decimal(15, 2)
  scrapUnitCostSnapshot   Decimal? @map("scrap_unit_cost_snapshot") @db.Decimal(15, 2)
  scrapNormalValueSnapshot Decimal? @map("scrap_normal_value_snapshot") @db.Decimal(15, 2)
  scrapAbnormalValueSnapshot Decimal? @map("scrap_abnormal_value_snapshot") @db.Decimal(15, 2)
  // F-2026-10-24-098-S D-S98-04: tinjau operasional foreman atas scrap
  // abnormal. scrapReviewStatus null = belum masuk antrean; nilai sah
  // menunggu_tinjau|ditinjau. Disposisi TIDAK mengubah snapshot klasifikasi
  // /nilai/jurnal 066-V di atas (BR-SCRAP-08).
  scrapReviewStatus      String?   @map("scrap_review_status") @db.VarChar(32)
  scrapReviewDisposition String?   @map("scrap_review_disposition") @db.VarChar(32)
  scrapReviewNote        String?   @map("scrap_review_note") @db.VarChar(500)
  scrapReviewedBy        Int?      @map("scrap_reviewed_by")
  scrapReviewedAt        DateTime? @map("scrap_reviewed_at")
  serialNumbers   Json?         @map("serial_numbers")
  // Batch/lot yang benar-benar ter-konsumsi FIFO saat complete (dari
  // consumedBatches hook); null sampai baris ter-issue.
  batchNumbers    Json?         @map("batch_numbers")
  materialIssue   MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  workOrderItem   WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  installedParts  InstalledPart[]

  @@index([materialIssueId], map: "material_issue_items_material_issue_id_fkey")
  @@index([itemId])
  @@index([workOrderItemId])
  @@map("material_issue_items")
}

