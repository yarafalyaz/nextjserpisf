FROM node:26-alpine

WORKDIR /app

# Install required system packages, create non-root user matching Mac host UID 501, and prepare volume mount points
RUN apk add --no-cache \
    libc6-compat \
    mysql-client \
    tzdata \
    su-exec && \
    addgroup --system --gid 501 nodejs && \
    adduser --system --uid 501 -G nodejs nextjs && \
    mkdir -p /app/.next /app/node_modules && \
    chown -R nextjs:nodejs /app/.next /app/node_modules

COPY package.json package-lock.json ./
RUN npm install

# Copy application configuration and Prisma schema
COPY --chown=root:root --chmod=755 src/ ./src/
COPY --chown=root:root --chmod=755 public/ ./public/
COPY --chown=root:root --chmod=755 prisma/ ./prisma/
COPY --chown=root:root --chmod=644 next.config.ts tsconfig.json postcss.config.mjs next-env.d.ts eslint.config.js prisma.config.ts ./
COPY --chown=root:root --chmod=755 docker/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh

# Generate Prisma Client
ENV DATABASE_URL="mysql://build:build@localhost:3306/build"
RUN npx prisma generate

EXPOSE 3001

# The entrypoint (running as root) re-generates the Prisma Client on every start
# so the client can never drift from the schema — see docker/entrypoint.dev.sh.
# It then drops to the non-root `nextjs` user for the dev server itself.
ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]
CMD ["npm", "run", "dev"]
